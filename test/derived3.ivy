#lang ivy1.8
# A normal invariant may NOT depend on a derived invariant at zero delay (via a
# `with` clause): every derived invariant already depends on all the normal
# invariants at zero delay, so this would close a zero-delay cycle -- an error.
isolate m = {
    individual x : bool
    individual y : bool
    after init { x := true; y := true }
    action step = { x := x; y := y }
    export step
    invariant [ix] x
    derived invariant [d1] x
    invariant [iy] y with d1
}
