#lang ivy1.8
# `using` selects the inductive hypothesis needed for a consecution check.
# Here y := old x is inductive only if we may assume x (ix), so `using ix`
# makes the check succeed.
isolate m = {
    individual x : bool
    individual y : bool
    after init { x := true; y := true }
    action step = { y := x; x := y }
    export step
    invariant [ix] x
    invariant [iy] y using ix
}
