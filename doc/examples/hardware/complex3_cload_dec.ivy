#lang ivy1.8

# A minimal 3-stage pipeline illustrating the COMPLEX hazard pattern of the
# stage-decomposition method (doc/projects/decomposition.md) with a *data-
# dependent* late write.  It is the conditional-write variant of complex3_dec.ivy.
#
# One instruction per cycle arrives on a primary input `inst_in` and is issued
# in order. The only architectural state is a single register `r`.
#
#   instruction word (8 bits):  [7:6] op   [5:0] imm
#     op = 1  INC    r := r + 1                     (reads r; writes r EARLY)
#     op = 2  CLOAD  r := imm  IF imm != 0          (conditional; writes r LATE)
#     op = 0  NOP    (does nothing; reads and writes no register)
#
# The only difference from complex3_dec.ivy is CLOAD: its late write is
# CONDITIONAL.  It writes r only when its immediate is nonzero; a zero-immediate
# CLOAD is a no-op that writes nothing.  This mirrors a conditional branch
# updating the pc: the write "may or may not occur", determined by a predicate
# `wl` ("writes late") that the trace computes.  As the doc puts it for the pc,
# "if it is not taken ... the pc is not reserved": a non-writing CLOAD does not
# reserve r, so a following INC need not stall behind it.  Because `wl` here is
# fixed at decode (it depends only on the immediate), the reservation *and* the
# stall are both exact -- unlike the pc, whose branch condition is resolved late,
# forcing a conservative fetch stall.
#
# Pipeline stages:
#   ew  (early write) : owns r.  On INC, reads r and writes r := r + 1 here.
#   md  (middle)      : a pass-through stage, so that ew_md is the one
#                       "intermediate" interface carrying the reservation state.
#   lw  (late write)  : a writing CLOAD writes r := imm here; the value is
#                       forwarded back to `r` in the ew stage.

include order   # unbounded_sequence, used for the reference tags

type word
interpret word -> bv[8]
type opc
interpret opc -> bv[2]
type immf                 # the 6-bit immediate field
interpret immf -> bv[6]

# The clock: one exported action driven by the environment.
export action posedge

# The instruction to issue this cycle is a primary input, read by the
# implementation (cpu).  The cpu passes it to `trace.step`, which forwards it to
# the ISA model's `decode`; the ISA never refers to this hardware input itself.
import wire inst_in : word

# =====================================================================
# The ISA reference model.
#
# `decode` computes the intermediate values of one instruction against the
# current register; `writeback` performs its (possibly conditional) update.
# The predicate `wl` records whether this instruction performs a LATE write
# (a CLOAD with a nonzero immediate).
# =====================================================================

module isa_model = {

    var r : word                  # the single architectural register

    # intermediate values of the current instruction (combinational)
    var ir  : word                # the instruction word
    var op  : opc
    var imm : word                # the CLOAD immediate (value a writing CLOAD writes)
    var wl  : bool                # this instruction writes r LATE (CLOAD, imm != 0)

    after init {
        r := 0
    }

    action decode(inst : word) = {
        ir  := inst;
        op  := inst<<7:6>>;
        imm := (0:opc) :: (inst<<5:0>>:immf);
        wl  := (op = 2) & (imm ~= 0)
    }

    action writeback = {
        r := (imm if wl else (r + 1 if op = 1 else r))
    }
}

# =====================================================================
# The trace: the sequence of ISA states produced by the issued instructions.
# `now` is the number of instructions issued so far; `st(T)` is the recorded
# state of instruction T (the register `r` *before* it executes, plus its
# decoded intermediate values).  `st(now)` always holds the current r.
# =====================================================================

isolate trace = {

    specification {

        instance arch : isa_model
        instance tag  : unbounded_sequence

        type state_t = struct {
            r   : word,
            ir  : word,
            op  : opc,
            imm : word,
            wl  : bool
        }

        var now : tag
        var st(T:tag) : state_t

        action current returns (s:state_t) = {
            s.r   := arch.r;
            s.ir  := arch.ir;
            s.op  := arch.op;
            s.imm := arch.imm;
            s.wl  := arch.wl;
        }

        after init {
            now := 0;
            st(now).r := arch.r;          # st(0).r = current (initial) r
        }

        # Issue instruction `inst`: record it as st(now), apply it, advance, and
        # snapshot the new current r as st(new now).
        action step(inst : word) = {
            arch.decode(inst);
            st(now) := current;
            arch.writeback;
            now := now.next;
            st(now) := current;
        }

        # st(now) always mirrors the current architectural r.
        invariant st(now).r = arch.r

        # Every issued instruction's intermediates are the correct decode of its
        # own instruction word.
        invariant T < now -> st(T).op  = (st(T).ir)<<7:6>>
        invariant T < now -> st(T).imm = (0:opc) :: ((st(T).ir)<<5:0>>:immf)
        invariant T < now -> st(T).wl  = ((st(T).op = 2) & (st(T).imm ~= 0))

        # Consecutive recorded states are related by one ISA step: r takes the
        # CLOAD immediate on a late write, the INC increment, or is unchanged.
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).r = (st(T).imm if st(T).wl
                                 else (st(T).r + 1 if st(T).op = 1 else st(T).r))

    }
} with word, opc

# =====================================================================
# The pipeline.
# =====================================================================

isolate cpu = {

    # ---- decode of the issuing instruction (combinational) ----
    wire in_op  : opc
    wire in_imm : word
    wire in_wl  : bool            # the issuing instruction writes r late
    definition in_op  = inst_in<<7:6>>
    definition in_imm = (0:opc) :: (inst_in<<5:0>>:immf)
    definition in_wl  = (in_op = 2) & (in_imm ~= 0)

    # ---- control wires (defined below, after the stage objects) ----
    wire issue_stall : bool    # issue stalls: an INC whose read of r is reserved
    wire lw_we       : bool     # late write enable (a writing CLOAD completing in lw)
    wire lw_wval     : word     # late write value (forwarded back to ew's r)

    specification {
        # Issue an instruction (advance the trace) whenever the issue is not
        # stalled.
        after posedge {
            if ~issue_stall {
                trace.step(inst_in)
            }
        }
    }

    # ---- early-write stage (EW) --------------------------------------------
    # Owns the architectural register `r` and the EW/MD pipe register.  On an INC
    # issue it reads r and performs the early write r := r + 1; it also applies
    # the forwarded late write from lw (which overrides the early write).

    implementation {
        isolate ew_stage = {

            # ---- interface wires ----
            wire in_op  : opc         # input: issuing instruction's op
            wire in_wl  : bool        # input:                        writes-late predicate
            wire in_imm : word        # input:                        immediate
            wire issue_stall : bool   # input: hold on a reservation stall
            wire lw_we   : bool       # input: forwarded late write enable (from lw)
            wire lw_wval : word       # input: forwarded late write value  (from lw)

            register r : word         # the architectural register lives here

            # ---- EW/MD pipe register (registered output) ----
            register a_wl    : bool   # the instruction writes r late (a writing CLOAD)
            register a_imm   : word   # its immediate (the value it will write)
            register a_valid : bool

            after init { r := 0; a_valid := false }

            after posedge {
                # issue: latch the instruction into the EW/MD register (bubble on
                # a stall) and, on an INC, perform the early write.
                if ~issue_stall {
                    a_wl    := in_wl;
                    a_imm   := in_imm;
                    a_valid := true;
                    if in_op = 1 { r := r + 1 }        # early write (INC)
                } else {
                    a_valid := false
                };
                # forwarded late write from lw; overrides the early write when a
                # writing CLOAD completes this cycle (they never both apply, since
                # an INC that would early-write while r is reserved stalls).
                if lw_we { r := lw_wval }
            }

            specification {
                # ---- tag chain: the EW/MD register sits between the issue
                #      boundary (trace.now) and the ew_md boundary ----
                invariant a_valid  -> ew_md.commit.succ(trace.now)
                invariant ~a_valid -> ew_md.commit = trace.now

                # ---- r tracks the current architectural r, except while a late
                #      write is pending (r reserved) ----
                invariant [r_track]
                    ~(ew_md.r_reserved_onward | a_valid & trace.st(ew_md.commit).wl)
                    -> r = trace.st(trace.now).r
            }
        } with cpu, trace, word, opc, ew_md
    }

    # ---- interface at the EW/MD boundary (the one INTERMEDIATE interface) ---

    private {
        isolate ew_md = {
            specification {

                var commit : trace.tag        # tag of the instruction in the EW/MD register
                var r_reserved_onward : bool   # a late write is pending in a LATER stage (lw)
                wire r_reserved : bool          # a late write is pending here (EW/MD) or later
                wire r_writes_done : bool        # the last downstream late write is completing

                # reserved here-or-later: a writing CLOAD in the EW/MD register, or reserved onward.
                definition r_reserved =
                    ew_stage.a_valid & trace.st(commit).wl | r_reserved_onward

                after init {
                    commit := 0;
                    r_reserved_onward := false
                }

                after posedge {
                    # clear the onward reservation when the last downstream late
                    # write completes ...
                    if r_writes_done {
                        r_reserved_onward := false
                    };
                    # ... then, if the EW/MD instruction advances and is itself a
                    # late writer, it becomes the (new) pending downstream write.
                    if old ew_stage.a_valid {
                        if trace.st(commit).wl {
                            r_reserved_onward := true
                        };
                        commit := commit.next
                    }
                }

                # Guarantees of the EW stage at this boundary.
                isolate ew_props = {
                    invariant [commit_bound] commit <= trace.now
                                             & (ew_stage.a_valid -> commit < trace.now)
                    # the EW/MD pipe register tracks the trace
                    invariant [a_track] ew_stage.a_valid ->
                                  ((ew_stage.a_wl <-> trace.st(commit).wl)
                                   & (trace.st(commit).wl ->
                                          ew_stage.a_imm = trace.st(commit).imm))
                    # while r is reserved, the EW/MD instruction is not an early
                    # writer (an INC would have stalled at issue -- r_resv_stall)
                    invariant [r_no_early] r_reserved & ew_stage.a_valid ->
                                  ~(trace.st(commit).op = 1)
                } with cpu, trace, word, opc, ew_md, ew_stage

                # Guarantees of the MD stage at this boundary.
                isolate md_props = {
                    # a read of a reserved r must stall the issue (only INC reads r)
                    invariant [r_resv_stall] (cpu.in_op = 1) & r_reserved -> cpu.issue_stall
                        with ew_props.commit_bound, ew_props.a_track,
                             md_stage.r_res, md_lw.md_props.b_track
                    # the forwarded late write enable implies the reservation ...
                    invariant [r_we_track] cpu.lw_we -> r_reserved_onward
                        with md_lw.lw_props.r_we_track, md_lw.lw_props.r_wval_track,
                             ew_props.commit_bound, ew_props.r_no_early
                    # ... and when the last downstream write completes, it writes
                    # the correct final value for this boundary's tag.
                    invariant [r_wval_track] r_writes_done ->
                                  cpu.lw_we & cpu.lw_wval = trace.st(commit).r
                        with md_lw.lw_props.r_we_track, md_lw.lw_props.r_wval_track,
                             ew_props.commit_bound, ew_props.r_no_early
                } with cpu, trace, word, opc, ew_md, md_stage, md_lw
            }
        }
    }

    # ---- middle stage (MD) -------------------------------------------------
    # A pass-through: owns the MD/LW pipe register, carrying the instruction from
    # ew to lw.  It defines the ew_md reservation-bookkeeping signals in terms of
    # its own register (the "onward" state and the writes-done signal).

    implementation {
        isolate md_stage = {

            # ---- MD/LW pipe register (registered output) ----
            register b_wl    : bool
            register b_imm   : word
            register b_valid : bool

            after init { b_valid := false }

            after posedge {
                # MD always advances (nothing downstream stalls): latch EW's
                # pre-edge output register.
                b_wl    := old ew_stage.a_wl;
                b_imm   := old ew_stage.a_imm;
                b_valid := old ew_stage.a_valid
            }

            specification {
                # ---- tag chain: the MD/LW register sits between the ew_md and
                #      md_lw boundaries ----
                invariant b_valid  -> md_lw.commit.succ(ew_md.commit)
                invariant ~b_valid -> ew_md.commit = md_lw.commit

                # The last downstream late write completes this cycle iff a writing
                # CLOAD is in the MD/LW register (it writes r in lw next).
                definition ew_md.r_writes_done =
                    b_valid & trace.st(md_lw.commit).wl

                # The onward reservation holds iff a writing CLOAD is in the MD/LW register.
                invariant [r_res] ew_md.r_reserved_onward <->
                                  b_valid & trace.st(md_lw.commit).wl
            }
        } with cpu, trace, word, opc, ew_md, md_lw
    }

    # ---- interface at the MD/LW boundary (incoming to the late writer) ------

    private {
        isolate md_lw = {
            specification {

                var commit : trace.tag        # tag of the instruction in the MD/LW register

                after init { commit := 0 }
                after posedge {
                    if old md_stage.b_valid { commit := commit.next }
                }

                # Guarantees of the MD stage: the MD/LW register tracks the trace.
                isolate md_props = {
                    invariant [commit_bound] commit <= trace.now
                                             & (md_stage.b_valid -> commit < trace.now)
                    invariant [b_track] md_stage.b_valid ->
                                  ((md_stage.b_wl <-> trace.st(commit).wl)
                                   & (trace.st(commit).wl ->
                                          md_stage.b_imm = trace.st(commit).imm))
                } with cpu, trace, word, opc, ew_md, ew_stage, md_lw, md_stage

                # Guarantees of the LW stage: the late write port tracks the trace.
                isolate lw_props = {
                    invariant [r_we_track] cpu.lw_we <->
                                  md_stage.b_valid & trace.st(commit).wl
                        with md_props.b_track, md_props.commit_bound
                    invariant [r_wval_track] cpu.lw_we ->
                                  cpu.lw_wval = trace.st(commit).imm
                        with md_props.b_track, md_props.commit_bound
                } with cpu, trace, word, opc, md_lw, lw_stage
            }
        }
    }

    # ---- late-write stage (LW) ---------------------------------------------
    # Combinational: reads the MD/LW pipe register (owned by md) and produces the
    # late write port (enable + value), forwarded back to `r` in ew.  Terminal
    # stage: no pipe register of its own.  The enable is exactly `b_wl` (a writing
    # CLOAD): a zero-immediate CLOAD has b_wl = false and writes nothing.

    implementation {
        isolate lw_stage = {

            wire lw_we   : bool     # output: late write enable
            wire lw_wval : word     # output: late write value

            definition lw_we   = md_stage.b_valid & md_stage.b_wl
            definition lw_wval = md_stage.b_imm

        } with cpu, trace, word, opc, md_lw
    }

    # ---- stage-output-dependent combinational wires ------------------------
    definition lw_we   = lw_stage.lw_we
    definition lw_wval = lw_stage.lw_wval
    # The issue stalls if the issuing instruction reads r (it is an INC) and a
    # late write is still pending (a writing CLOAD is in the EW/MD or MD/LW
    # register).  A non-writing CLOAD (imm = 0) has a_wl / b_wl false, so it does
    # NOT stall a following INC -- the exact-reservation optimization.
    definition issue_stall = (in_op = 1) &
        ( (ew_stage.a_valid & ew_stage.a_wl)
          | (md_stage.b_valid & md_stage.b_wl) )

    # ---- connect the stage inputs ------------------------------------------
    definition ew_stage.in_op       = in_op
    definition ew_stage.in_wl       = in_wl
    definition ew_stage.in_imm      = in_imm
    definition ew_stage.issue_stall = issue_stall
    definition ew_stage.lw_we       = lw_we
    definition ew_stage.lw_wval     = lw_wval
}
