#lang ivy1.8

# An out-of-order CPU (Tomasulo's algorithm with a re-order buffer), verified
# against the ISA reference by reference tagging.
#
# STAGE 3a (this file is the frozen stage-3a snapshot; development continues in ooo_cpu_ref.ivy): the full ISA -- ALU ops, BEQZ with a branch predictor,
# and the memory instructions LD/ST/FLUSH through the reusable I/D-cache module
# `idcache` -- with single-wide dispatch, one ALU and a 4-entry ROB. Memory
# instructions execute IN ORDER, AT THE HEAD OF THE ROB (there is no LD/ST
# queue yet; that is stage 3b). Stage 1 (ALU only) is frozen as
# ooo_cpu_alu_ref.ivy and stage 2 (+BEQZ) as ooo_cpu_beqz_ref.ivy.
#
# Instruction encoding (16 bits):
#
#     [15:13] opcode   [12:10] rd   [9:7] ra   [6:4] rb   [7:0] imm/target
#
#   opcode 0  NOP
#          1  ADD  rd, ra, rb     rf[rd] := rf[ra] + rf[rb]
#          2  SUB  rd, ra, rb     rf[rd] := rf[ra] - rf[rb]
#          3  LI   rd, imm        rf[rd] := zero_extend(imm8)
#          4  LD   rd, [ra]       rf[rd] := mem[ rf[ra] ]
#          5  ST   [ra], rb       mem[ rf[ra] ] := rf[rb]
#          6  BEQZ ra, target     if rf[ra] == 0 then pc := target
#          7  FLUSH [ra]          make prior writes to mem[ rf[ra] ] visible to fetch
#
# Memory is unified and the I- and D-caches are not coherent, so (as in
# dual_issue_cpu_ref.ivy) the ISA carries a per-address dirty bit `ddirty(A)`
# (set by ST, cleared by FLUSH) and a sticky `error` set when an instruction is
# fetched from a dirty address; once error holds the implementation is no
# longer required to match, and every invariant relating the implementation
# to the trace is guarded by ~trace.st(trace.now).error.
#
# ---------------------------------------------------------------------------
# Microarchitecture
#
#   Fetch (IF)        : d_ir := idc.fetch_data0 at pc (stalls on an I-cache
#                       miss); pc := predicted next pc (bp predicts a fetched
#                       BEQZ; d_pred/d_pc ride with the instruction). Stalls
#                       when the ROB is full, and while a FLUSH is anywhere in
#                       flight (IF/ID latch or ROB) -- so a FLUSH is always the
#                       youngest instruction and nothing behind it is fetched
#                       until it has taken effect.
#   Dispatch (ID)     : allocates ROB entry `rob_tail`, renames rd (ALU ops and
#                       LD), captures operands (from rf / the ROB / the ALU
#                       result bus / the retiring load's data, else waits).
#   Issue / Execute   : the oldest ready, un-issued ALU/BEQZ entry goes to the
#                       one-cycle ALU; the result (and a BEQZ's outcome) is
#                       written to the entry and broadcast to waiting entries.
#   Memory (at head)  : a LD/ST/FLUSH entry executes only when it is the head
#                       and its operands are ready: it presents its request to
#                       idc and, if idc does not stall, completes AND retires in
#                       the same cycle (a LD writes rf, broadcasts its data to
#                       waiting entries and bypasses it to a dispatching
#                       consumer). In-order, non-speculative memory access falls
#                       out for free: the head is never wrong-path.
#   Retire            : the head entry, once done, writes the register file,
#                       frees its slot, clears the rename entry if it is still
#                       the youngest writer; a mispredicted BEQZ squashes the
#                       whole ROB, clears the rename table, kills the ALU/fetch
#                       latches and redirects the pc.
#
# ---------------------------------------------------------------------------
# Proof approach (reference tagging)
#
# As in stages 1-2: rob_tag(I) names entry I's instruction in the trace, the
# non-shadowed busy entries carry the tag run [commit, now), and the rename
# table is characterized against the current trace position:
#
#   ~rat_valid(R) -> rf(R) = st(now).rf(R)
#    rat_valid(R) -> st(now).rf(R) = st(rob_tag(rat_idx(R))).res
#
# (with res now also recording a LD's loaded value, so a load is just another
# renamed writer). Speculation: rob_shadow/d_shadow/spec_wrong/mp_idx as in
# stage 2. Memory needs no analogue of the rename table because memory ops
# execute at the head: idc's abstract memory equals st(commit).mem exactly
# (a store updates it in the cycle commit steps over the store), a load reads
# st(commit).mem at st(commit).mem_addr, and a FLUSH updates ddirty in step.
# Fetch coherence is the one place the window [commit, now) matters: a fetch
# from A with ~st(now).ddirty(A) needs st(commit).mem(A) = st(now).mem(A). It
# holds because fetch is stalled while any FLUSH is in flight, and with no
# FLUSH in flight every in-flight store to A leaves st(now).ddirty(A) set
# ([store_dirty]); so under the fetch condition no store to A is in flight
# and memory at A is unchanged across the window ([mem_now]) -- both are
# one-step inductive, no unrolling.

include order
include idcache

type word
interpret word -> bv[16]
type addr
interpret addr -> bv[8]
type reg
interpret reg -> bv[3]
type opc
interpret opc -> bv[3]
type robidx                      # re-order buffer index (4 entries)
interpret robidx -> bv[2]
type bit                         # an idcache type parameter
interpret bit -> bv[1]

export action posedge

# Initial memory contents: an arbitrary fixed program image, shared by the
# implementation and the reference (see dual_issue_cpu_ref.ivy for why).
function init_mem(A:addr) : word

# ===========================================================================
# The ISA model (the full shared ISA; `res` also records a LD's value).
# ===========================================================================

module isa_model(init_mem) = {

    var pc : addr                 # program counter
    var rf(R:reg) : word          # register file
    var mem(A:addr) : word        # unified memory (instructions and data)
    var ddirty(A:addr) : bool     # A has been written since the last FLUSH of A
    var error : bool              # an instruction was fetched from a dirty address

    # Temporary variables computed by `prepare`, not holding state

    var fetched : word
    var opcode : opc
    var rd : reg
    var ra : reg
    var rb : reg
    var target : addr             # low 8 bits: branch target or immediate
    var a_val : word
    var b_val : word
    var mem_addr : addr           # address for LD/ST/FLUSH: low 8 bits of rf[ra]
    var take_branch : bool        # BEQZ outcome
    var res : word                # the value written to rd (ADD/SUB/LI/LD; 0 otherwise)

    after init {
        pc := 0;
        rf(R) := 0;
        mem(A) := init_mem(A);
        ddirty(A) := false;
        error := false;
    }

    action prepare = {
        fetched := mem(pc);
        opcode := fetched<<15:13>>;
        rd := fetched<<12:10>>;
        ra := fetched<<9:7>>;
        rb := fetched<<6:4>>;
        target := fetched<<7:0>>;
        a_val := rf(ra);
        b_val := rf(rb);
        mem_addr := a_val<<7:0>>;
        take_branch := (opcode = 6) & (a_val = 0);
        res := (a_val + b_val if opcode = 1 else
               (a_val - b_val if opcode = 2 else
               ((0:addr) :: target if opcode = 3 else
               (mem(mem_addr) if opcode = 4 else 0))));
    }

    action step = {
        # Fetch coherence: an instruction executed from a dirty address is a
        # stale fetch; the ISA enters the sticky error state.
        if ddirty(pc) {
            error := true;
        }
        if opcode = 1 | opcode = 2 | opcode = 3 | opcode = 4 {
            rf(rd) := res
        } else if opcode = 5 {
            mem(mem_addr) := b_val;
            ddirty(mem_addr) := true;
        } else if opcode = 7 {
            ddirty(mem_addr) := false;
        };
        if take_branch {
            pc := target
        } else {
            pc := pc + 1
        }
    }
}

# ===========================================================================
# The trace: the recorded sequence of ISA states.
# ===========================================================================

instance tag : unbounded_sequence

isolate trace = {

    specification {

        instance arch : isa_model(init_mem)

        type state_t = struct {
            pc : addr,
            rf(R:reg) : word,
            mem(A:addr) : word,
            ddirty(A:addr) : bool,
            error : bool,
            fetched : word,
            opcode : opc,
            rd : reg,
            ra : reg,
            rb : reg,
            target : addr,
            a_val : word,
            b_val : word,
            mem_addr : addr,
            take_branch : bool,
            res : word
        }

        var now : tag
        var st(T:tag) : state_t

        action current returns(res:state_t) = {
            res.pc := arch.pc;
            res.rf(R:reg) := arch.rf(R:reg);
            res.mem(A:addr) := arch.mem(A:addr);
            res.ddirty(A:addr) := arch.ddirty(A:addr);
            res.error := arch.error;
            res.fetched := arch.fetched;
            res.opcode := arch.opcode;
            res.rd := arch.rd;
            res.ra := arch.ra;
            res.rb := arch.rb;
            res.target := arch.target;
            res.a_val := arch.a_val;
            res.b_val := arch.b_val;
            res.mem_addr := arch.mem_addr;
            res.take_branch := arch.take_branch;
            res.res := arch.res;
        }

        after init {
            now := 0;
            arch.prepare;
            st(now) := current;
        }

        action step = {
            arch.step;
            arch.prepare;
            now := now.next;
            st(now) := current;
        }

        invariant st(now).pc = arch.pc
        invariant st(now).rf(R:reg) = arch.rf(R:reg)
        invariant st(now).mem(A:addr) = arch.mem(A:addr)
        invariant st(now).ddirty(A:addr) = arch.ddirty(A:addr)
        invariant st(now).error = arch.error
        invariant st(now).fetched = arch.fetched
        invariant st(now).opcode = arch.opcode
        invariant st(now).rd = arch.rd
        invariant st(now).ra = arch.ra
        invariant st(now).rb = arch.rb
        invariant st(now).target = arch.target
        invariant st(now).a_val = arch.a_val
        invariant st(now).b_val = arch.b_val
        invariant st(now).mem_addr = arch.mem_addr
        invariant st(now).take_branch = arch.take_branch
        invariant st(now).res = arch.res

        # (a) every recorded entry's intermediate values decode its own state
        invariant T <= now -> st(T).fetched = st(T).mem(st(T).pc)
        invariant T <= now -> st(T).opcode = (st(T).fetched)<<15:13>>
        invariant T <= now -> st(T).rd = (st(T).fetched)<<12:10>>
        invariant T <= now -> st(T).ra = (st(T).fetched)<<9:7>>
        invariant T <= now -> st(T).rb = (st(T).fetched)<<6:4>>
        invariant T <= now -> st(T).target = (st(T).fetched)<<7:0>>
        invariant T <= now -> st(T).a_val = st(T).rf(st(T).ra)
        invariant T <= now -> st(T).b_val = st(T).rf(st(T).rb)
        invariant T <= now -> st(T).mem_addr = (st(T).a_val)<<7:0>>
        invariant T <= now -> st(T).take_branch = ((st(T).opcode = 6) & (st(T).a_val = 0))
        invariant T <= now -> st(T).res = (st(T).a_val + st(T).b_val if st(T).opcode = 1 else (st(T).a_val - st(T).b_val if st(T).opcode = 2 else ((0:addr) :: st(T).target if st(T).opcode = 3 else (st(T).mem(st(T).mem_addr) if st(T).opcode = 4 else 0))))

        # (b) consecutive recorded entries are related by one ISA step
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).pc = (st(T).target if st(T).take_branch else st(T).pc + 1)
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).error = (st(T).error | st(T).ddirty(st(T).pc))
        invariant [tr_ddirty] (tag.succ(T,U) & U <= now) ->
                      st(U).ddirty(A) =
                          (true  if (st(T).opcode = 5 & A = st(T).mem_addr) else
                          (false if (st(T).opcode = 7 & A = st(T).mem_addr) else
                           st(T).ddirty(A)))
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).mem(A) = (st(T).b_val if (st(T).opcode = 5 & A = st(T).mem_addr)
                                      else st(T).mem(A))
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).rf(R) = (st(T).res
                                     if ((st(T).opcode = 1 | st(T).opcode = 2 | st(T).opcode = 3 | st(T).opcode = 4) & R = st(T).rd)
                                     else st(T).rf(R))
    }
} with addr, opc, tag

# ===========================================================================
# The out-of-order CPU.
# ===========================================================================

object cpu = {

    # ---- ghost reference tags ---------------------------------------------
    specification {
        var commit : tag                  # tag of the oldest un-retired instruction
                                          # (= trace.now when the ROB is empty)
        var rob_tag(I:robidx) : tag       # the trace tag of the instruction in entry I
        var rob_shadow(I:robidx) : bool   # entry I is wrong-path (behind a mispredict)
        var d_shadow : bool               # the IF/ID instruction is wrong-path
        var spec_wrong : bool             # the fetch stream is on a mispredicted path
        var mp_idx : robidx               # while spec_wrong: the mispredicted branch's entry

        after init {
            commit := 0;
            d_shadow := false;
            spec_wrong := false;
        }
    }

    # ---- architectural state ----
    var pc : addr
    var rf(R:reg) : word

    # ---- memory subsystem: the reusable `idcache` module (I-cache, D-cache,
    # main memory, FLUSH-based coherence, multi-cycle fill port). Its spec is
    # over its own abstract idc.mem / idc.ddirty, which the CPU relates to the
    # reference at the retire tag (commit) below. Only fetch lane 0 is used.
    instance idc : idcache(posedge, word, addr, bit, init_mem)

    # ---- IF/ID latch ----
    var d_ir : word
    var d_valid : bool
    var d_pred : bool                 # predicted-taken bit carried with the instruction
    var d_pc : addr                   # the instruction's own pc

    # ---- rename table ----
    var rat_valid(R:reg) : bool       # R has an in-flight writer
    var rat_idx(R:reg) : robidx       # ... namely ROB entry rat_idx(R) (the youngest)

    # ---- re-order buffer (with the reservation-station fields per entry) ----
    var rob_head : robidx             # oldest entry
    var rob_tail : robidx             # next free entry
    var rob_busy(I:robidx) : bool     # entry holds an instruction
    var rob_ir(I:robidx) : word       # its instruction word
    var rob_pc(I:robidx) : addr       # its pc (for the branch redirect)
    var rob_pred(I:robidx) : bool     # its carried branch prediction
    var rob_take(I:robidx) : bool     # its true branch outcome (valid when done)
    var rob_issued(I:robidx) : bool   # it has been sent to the ALU (or needs no ALU)
    var rob_done(I:robidx) : bool     # its result is in rob_val (never for a memory op)
    var rob_val(I:robidx) : word
    var rob_a(I:robidx) : word        # operand a (valid when rob_a_rdy)
    var rob_a_rdy(I:robidx) : bool
    var rob_a_src(I:robidx) : robidx  # else: the ROB entry producing it
    var rob_b(I:robidx) : word
    var rob_b_rdy(I:robidx) : bool
    var rob_b_src(I:robidx) : robidx

    # ---- ALU latch ----
    var ex_valid : bool
    var ex_idx : robidx
    var ex_ir : word
    var ex_a : word
    var ex_b : word

    implementation {

    # ---- ROB occupancy ----
    wire rob_full : bool
    definition rob_full = rob_busy(rob_tail)

    # ---- dispatch decode ----
    wire d_opcode : opc
    definition d_opcode = d_ir<<15:13>>
    wire d_rd : reg
    definition d_rd = d_ir<<12:10>>
    wire d_ra : reg
    definition d_ra = d_ir<<9:7>>
    wire d_rb : reg
    definition d_rb = d_ir<<6:4>>
    wire d_target : addr
    definition d_target = d_ir<<7:0>>
    wire d_wr : bool                  # writes rd (ALU op or LD): renamed
    definition d_wr = (d_opcode = 1 | d_opcode = 2 | d_opcode = 3 | d_opcode = 4)
    wire d_branch : bool
    definition d_branch = (d_opcode = 6)
    wire d_exec : bool                # goes through the ALU (ALU op or branch)
    definition d_exec = (d_opcode = 1 | d_opcode = 2 | d_opcode = 3 | d_opcode = 6)
    wire d_mem : bool                 # a memory op: executes at the head
    definition d_mem = (d_opcode = 4 | d_opcode = 5 | d_opcode = 7)
    wire d_needs_a : bool             # reads ra
    definition d_needs_a = (d_opcode = 1 | d_opcode = 2 | d_opcode = 4 | d_opcode = 5 | d_opcode = 6 | d_opcode = 7)
    wire d_needs_b : bool             # reads rb
    definition d_needs_b = (d_opcode = 1 | d_opcode = 2 | d_opcode = 5)

    # ---- retire / memory-at-head decode ----
    wire r_ir : word
    definition r_ir = rob_ir(rob_head)
    wire r_opcode : opc
    definition r_opcode = r_ir<<15:13>>
    wire r_rd : reg
    definition r_rd = r_ir<<12:10>>
    wire r_target : addr
    definition r_target = r_ir<<7:0>>
    wire r_wr : bool                  # writes rd (ALU op or LD)
    definition r_wr = (r_opcode = 1 | r_opcode = 2 | r_opcode = 3 | r_opcode = 4)
    wire r_branch : bool
    definition r_branch = (r_opcode = 6)
    wire r_mem : bool
    definition r_mem = (r_opcode = 4 | r_opcode = 5 | r_opcode = 7)
    wire r_val : word                 # the retiring ALU result (pre-state read)
    definition r_val = rob_val(rob_head)
    wire r_rat_clear : bool           # the retiring entry is still rd's youngest writer
    definition r_rat_clear = rat_valid(r_rd) & rat_idx(r_rd) = rob_head
    wire r_pc : addr
    definition r_pc = rob_pc(rob_head)
    wire r_take : bool
    definition r_take = rob_take(rob_head)
    wire r_pred : bool
    definition r_pred = rob_pred(rob_head)
    wire r_a : word                   # the head's operands (its address / store data)
    definition r_a = rob_a(rob_head)
    wire r_b : word
    definition r_b = rob_b(rob_head)
    wire r_addr : addr
    definition r_addr = r_a<<7:0>>
    # a memory op at the head with its operands ready presents its request to idc
    wire mem_ready : bool
    definition mem_ready = rob_busy(rob_head) & r_mem & rob_a_rdy(rob_head) & rob_b_rdy(rob_head)
    wire mem_retire : bool            # ... and completes (and retires) if idc does not stall
    definition mem_retire = mem_ready & ~idc.data_stall
    wire ld_bcast : bool              # a retiring load broadcasts its data
    definition ld_bcast = mem_retire & (r_opcode = 4)
    wire retire : bool
    definition retire = (rob_busy(rob_head) & rob_done(rob_head)) | mem_retire
    wire r_wval : word                # the value written to rf at retire
    definition r_wval = (idc.read_data if r_opcode = 4 else r_val)
    # a retiring BEQZ whose outcome differs from its prediction: squash
    wire squash : bool
    definition squash = retire & r_branch & (r_take ~= r_pred)
    wire redirect_pc : addr           # the correct next pc after the branch
    definition redirect_pc = (r_target if r_take else r_pc + 1)

    # ---- a FLUSH in flight (IF/ID or ROB) stalls fetch until it retires ----
    wire flush_pending : bool
    definition flush_pending = (d_valid & d_opcode = 7)
                             | (rob_busy(0) & (rob_ir(0)<<15:13>>:opc) = 7)
                             | (rob_busy(1) & (rob_ir(1)<<15:13>>:opc) = 7)
                             | (rob_busy(2) & (rob_ir(2)<<15:13>>:opc) = 7)
                             | (rob_busy(3) & (rob_ir(3)<<15:13>>:opc) = 7)

    wire dispatch : bool
    definition dispatch = d_valid & ~rob_full & ~squash
    wire if_stall : bool
    definition if_stall = d_valid & rob_full
    wire fetch_active : bool          # IF presents the pc to idc
    definition fetch_active = ~if_stall & ~squash & ~flush_pending
    wire fetch_en : bool              # ... and latches the word if idc returns it
    definition fetch_en = fetch_active & idc.fetch_valid0

    # ---- head-relative entry indices, for oldest-first issue ----
    wire h0 : robidx
    definition h0 = rob_head
    wire h1 : robidx
    definition h1 = rob_head + 1
    wire h2 : robidx
    definition h2 = rob_head + 2
    wire h3 : robidx
    definition h3 = rob_head + 3

    # ---- ALU ----
    wire ex_opcode : opc
    definition ex_opcode = ex_ir<<15:13>>
    wire ex_target : addr
    definition ex_target = ex_ir<<7:0>>
    wire ex_res : word
    definition ex_res = (ex_a + ex_b if ex_opcode = 1 else
                        (ex_a - ex_b if ex_opcode = 2 else
                        ((0:addr) :: ex_target if ex_opcode = 3 else 0)))
    wire ex_take : bool               # the true BEQZ outcome
    definition ex_take = (ex_opcode = 6) & (ex_a = 0)

    # ---- operand capture at dispatch ----
    # An operand is ready if its register has no in-flight writer, or the
    # writer is done, or the writer is completing on the ALU result bus right
    # now, or the writer is the load retiring right now (the dispatching entry
    # is not yet in the ROB, so it would otherwise miss the broadcast).
    wire d_a_idx : robidx
    definition d_a_idx = rat_idx(d_ra)
    wire d_a_bus : bool
    definition d_a_bus = ex_valid & ex_idx = d_a_idx
    wire d_a_ld : bool
    definition d_a_ld = ld_bcast & d_a_idx = rob_head
    wire d_a_rdy : bool
    definition d_a_rdy = ~d_needs_a | ~rat_valid(d_ra) | rob_done(d_a_idx) | d_a_bus | d_a_ld
    wire d_a_val : word
    definition d_a_val = (rf(d_ra) if ~rat_valid(d_ra) else
                         (ex_res if d_a_bus else
                         (idc.read_data if d_a_ld else rob_val(d_a_idx))))

    wire d_b_idx : robidx
    definition d_b_idx = rat_idx(d_rb)
    wire d_b_bus : bool
    definition d_b_bus = ex_valid & ex_idx = d_b_idx
    wire d_b_ld : bool
    definition d_b_ld = ld_bcast & d_b_idx = rob_head
    wire d_b_rdy : bool
    definition d_b_rdy = ~d_needs_b | ~rat_valid(d_rb) | rob_done(d_b_idx) | d_b_bus | d_b_ld
    wire d_b_val : word
    definition d_b_val = (rf(d_rb) if ~rat_valid(d_rb) else
                         (ex_res if d_b_bus else
                         (idc.read_data if d_b_ld else rob_val(d_b_idx))))

    # ---- issue selection: the oldest ready, un-issued ALU/BEQZ entry ----
    # (memory ops never issue to the ALU: they execute at the head)
    wire rdy0 : bool
    definition rdy0 = rob_busy(h0) & ~rob_issued(h0) & rob_a_rdy(h0) & rob_b_rdy(h0)
                    & ~((rob_ir(h0)<<15:13>>:opc) = 4 | (rob_ir(h0)<<15:13>>:opc) = 5 | (rob_ir(h0)<<15:13>>:opc) = 7)
    wire rdy1 : bool
    definition rdy1 = rob_busy(h1) & ~rob_issued(h1) & rob_a_rdy(h1) & rob_b_rdy(h1)
                    & ~((rob_ir(h1)<<15:13>>:opc) = 4 | (rob_ir(h1)<<15:13>>:opc) = 5 | (rob_ir(h1)<<15:13>>:opc) = 7)
    wire rdy2 : bool
    definition rdy2 = rob_busy(h2) & ~rob_issued(h2) & rob_a_rdy(h2) & rob_b_rdy(h2)
                    & ~((rob_ir(h2)<<15:13>>:opc) = 4 | (rob_ir(h2)<<15:13>>:opc) = 5 | (rob_ir(h2)<<15:13>>:opc) = 7)
    wire rdy3 : bool
    definition rdy3 = rob_busy(h3) & ~rob_issued(h3) & rob_a_rdy(h3) & rob_b_rdy(h3)
                    & ~((rob_ir(h3)<<15:13>>:opc) = 4 | (rob_ir(h3)<<15:13>>:opc) = 5 | (rob_ir(h3)<<15:13>>:opc) = 7)
    wire issue : bool
    definition issue = ~squash & (rdy0 | rdy1 | rdy2 | rdy3)
    wire issue_idx : robidx
    definition issue_idx = (h0 if rdy0 else (h1 if rdy1 else (h2 if rdy2 else h3)))

    }

    # ---- the branch predictor, as a sub-isolate `bp` (as in 5stage_bp_cpu_ref) ----
    isolate bp = {
        wire fetch_pc : addr          # input: PC being fetched (to predict)
        wire br_valid : bool          # input: a conditional branch resolves this cycle
        wire br_pc : addr             # input: the resolving branch's PC
        wire br_taken : bool          # input: its true outcome
        wire predicted_taken : bool   # output: the prediction for fetch_pc

        implementation {
            type bhtidx
            interpret bhtidx -> bv[4]  # 16-entry branch history table
            type ctr
            interpret ctr -> bv[2]     # 2-bit saturating counter, states 0..3

            var bht(I:bhtidx) : ctr

            wire pred_idx : bhtidx
            definition pred_idx = fetch_pc<<3:0>>
            wire upd_idx : bhtidx
            definition upd_idx = br_pc<<3:0>>

            definition predicted_taken = (bht(pred_idx) = 2) | (bht(pred_idx) = 3)

            after init {
                bht(I) := 1            # weakly not-taken
            }

            after posedge {
                if br_valid {
                    if br_taken {
                        if bht(upd_idx) ~= 3 { bht(upd_idx) := bht(upd_idx) + 1 }
                    } else {
                        if bht(upd_idx) ~= 0 { bht(upd_idx) := bht(upd_idx) - 1 }
                    }
                }
            }
        }
    }

    # connect the predictor (in the parent): predict at fetch, train at retire
    definition bp.fetch_pc = pc
    definition bp.br_valid = retire & r_branch
    definition bp.br_pc = r_pc
    definition bp.br_taken = r_take

    # ---- connect the idcache module (in the parent, so both the datapath and
    # the sub-blocks see the interconnect) ----
    # Fetch port: present the pc whenever IF is really fetching.
    definition idc.fetch_req  = fetch_active
    definition idc.fetch_addr = pc
    # Data port: the memory op at the head, once its operands are ready. Its
    # opcode is a single value, so read/write/flush are mutually exclusive
    # (one_data_op).
    definition idc.read_req   = mem_ready & (r_opcode = 4)
    definition idc.write_req  = mem_ready & (r_opcode = 5)
    definition idc.flush_req  = mem_ready & (r_opcode = 7)
    definition idc.data_addr  = r_addr
    definition idc.write_data = r_b

    implementation {

    # ---- fetch and prediction ----
    wire fetched : word
    definition fetched = idc.fetch_data0
    wire f_is_branch : bool
    definition f_is_branch = ((fetched<<15:13>>:opc) = 6)
    wire f_ptaken : bool             # predicted-taken for the fetched instruction
    definition f_ptaken = f_is_branch & bp.predicted_taken
    wire f_target : addr
    definition f_target = fetched<<7:0>>
    wire pred_next_pc : addr
    definition pred_next_pc = (f_target if f_ptaken else pc + 1)

    # ---- reset ----
    after init {
        pc := 0;
        rf(R) := 0;
        d_valid := false;
        rat_valid(R) := false;
        rob_head := 0;
        rob_tail := 0;
        rob_busy(I) := false;
        rob_issued(I) := false;
        rob_done(I) := false;
        ex_valid := false;
        # main memory and both caches are initialized inside idc.
    }

    # ---- clock edge ----
    # Every value read below is a pre-state value: the blocks are ordered so
    # that no block reads an array element an earlier block wrote, the retire
    # block's reads go through wires, and the two result broadcasts (ALU and
    # retiring load) are written as one statement. The action therefore has
    # exactly the semantics of a nonblocking always-block (see the golden).
    after posedge {

        # Complete the ALU operation: write the result (and a BEQZ's outcome).
        if ex_valid {
            rob_val(ex_idx) := ex_res;
            rob_done(ex_idx) := true;
            rob_take(ex_idx) := ex_take
        };

        # Broadcast: the ALU result to every entry waiting on ex_idx, and the
        # retiring load's data to every entry waiting on the head.
        rob_a(I) := (ex_res if (ex_valid & rob_busy(I) & ~rob_a_rdy(I) & rob_a_src(I) = ex_idx) else
                    (idc.read_data if (ld_bcast & rob_busy(I) & ~rob_a_rdy(I) & rob_a_src(I) = rob_head) else
                     rob_a(I)));
        rob_a_rdy(I) := rob_a_rdy(I) | (ex_valid & rob_busy(I) & rob_a_src(I) = ex_idx)
                                     | (ld_bcast & rob_busy(I) & rob_a_src(I) = rob_head);
        rob_b(I) := (ex_res if (ex_valid & rob_busy(I) & ~rob_b_rdy(I) & rob_b_src(I) = ex_idx) else
                    (idc.read_data if (ld_bcast & rob_busy(I) & ~rob_b_rdy(I) & rob_b_src(I) = rob_head) else
                     rob_b(I)));
        rob_b_rdy(I) := rob_b_rdy(I) | (ex_valid & rob_busy(I) & rob_b_src(I) = ex_idx)
                                     | (ld_bcast & rob_busy(I) & rob_b_src(I) = rob_head);

        # Retire the head entry: a done ALU/BEQZ/NOP entry, or a memory op
        # that idc serves this cycle (the store/flush effects on memory and the
        # caches happen inside idc, driven by the request wires). A
        # mispredicted BEQZ squashes everything behind it and redirects the pc.
        if retire {
            if r_wr {
                rf(r_rd) := r_wval
            };
            if r_rat_clear {
                rat_valid(r_rd) := false
            };
            rob_busy(rob_head) := false;
            if squash {
                rob_busy(I) := false;             # every other entry is younger: drop it
                rat_valid(R) := false;            # no in-flight writers remain
                rob_tail := rob_head + 1;         # empty ROB (pre-state head)
                ex_valid := false;                # kill the in-flight ALU op
                d_valid := false;                 # kill the fetched instruction
                pc := redirect_pc
            };
            rob_head := rob_head + 1
        };

        # Issue the oldest ready entry to the ALU. (rob_a/rob_b(issue_idx) are
        # read after the broadcast above, but the broadcast only writes entries
        # whose operand is NOT ready, and issue_idx is ready, so these are still
        # the pre-state values.)
        if issue {
            ex_valid := true;
            ex_idx := issue_idx;
            ex_ir := rob_ir(issue_idx);
            ex_a := rob_a(issue_idx);
            ex_b := rob_b(issue_idx);
            rob_issued(issue_idx) := true
        } else {
            ex_valid := false
        };

        # Dispatch: allocate the tail entry, rename, capture operands. This
        # comes after retire so that a same-cycle retire of an older writer of
        # d_rd does not clobber the new rename entry. The IF/ID latch empties
        # unless the fetch below refills it.
        if dispatch {
            rob_busy(rob_tail) := true;
            rob_ir(rob_tail) := d_ir;
            rob_pc(rob_tail) := d_pc;
            rob_pred(rob_tail) := d_pred;
            rob_issued(rob_tail) := ~d_exec & ~d_mem;   # a NOP is issued+done at once; an ALU/BEQZ op
            rob_done(rob_tail) := ~d_exec & ~d_mem;     # issues later; a memory op is neither until the head
            rob_val(rob_tail) := 0;
            rob_a(rob_tail) := d_a_val;
            rob_a_rdy(rob_tail) := d_a_rdy;
            rob_a_src(rob_tail) := d_a_idx;
            rob_b(rob_tail) := d_b_val;
            rob_b_rdy(rob_tail) := d_b_rdy;
            rob_b_src(rob_tail) := d_b_idx;
            if d_wr {
                rat_valid(d_rd) := true;
                rat_idx(d_rd) := rob_tail
            };
            rob_tail := rob_tail + 1;
            d_valid := false
        };

        # Fetch (speculatively, along the predicted path) when IF is active and
        # idc returns the word (an I-cache miss stalls: the latch stays empty).
        if fetch_en {
            d_ir := fetched;
            d_valid := true;
            d_pred := f_ptaken;
            d_pc := pc;
            pc := pred_next_pc
        }
    }
    }

    # ---- ghost monitor: tags, shadows and the trace step ------------------
    specification {
        after posedge {
            if retire {
                commit := commit.next
            };
            if squash {
                spec_wrong := false;
                d_shadow := false
            };
            if dispatch {
                rob_shadow(old rob_tail) := d_shadow;
                if ~d_shadow {
                    rob_tag(old rob_tail) := trace.now;
                    if d_branch & (old d_pred ~= trace.st(trace.now).take_branch) {   # old: insensitive to monitor order
                        spec_wrong := true;
                        mp_idx := old rob_tail
                    };
                    trace.step
                }
            };
            if fetch_en {
                d_shadow := spec_wrong
            }
        }
    }

    # ---- invariants -------------------------------------------------------
    # Every invariant relating the implementation to the trace is guarded by
    # ~trace.st(trace.now).error (the fetch-coherence relaxation); the purely
    # structural ones (rob_shape, the issued/done bookkeeping) are not.
    private {

        # ---- ROB occupancy structure ----
        invariant [rob_shape] rob_busy(I) <-> (((I - rob_head) < (rob_tail - rob_head)) | (rob_busy(rob_head) & rob_head = rob_tail))
        invariant [rob_done_issued] (rob_busy(I) & rob_done(I)) -> rob_issued(I)
        invariant [rob_issued_rdy] (rob_busy(I) & rob_issued(I)) -> (rob_a_rdy(I) & rob_b_rdy(I))
        # an entry that does not execute (NOP) is done at dispatch; a memory op is never issued/done
        invariant [rob_nonexec_done] (rob_busy(I) & ((rob_ir(I)<<15:13>>:opc) = 0)) -> rob_done(I)
        invariant [rob_mem_notdone] (rob_busy(I) & ((rob_ir(I)<<15:13>>:opc) = 4 | (rob_ir(I)<<15:13>>:opc) = 5 | (rob_ir(I)<<15:13>>:opc) = 7)) -> (~rob_issued(I) & ~rob_done(I))
        invariant [ex_trk] ex_valid -> (rob_busy(ex_idx) & rob_issued(ex_idx) & ~rob_done(ex_idx) & ex_ir = rob_ir(ex_idx))
        invariant [issued_in_ex] (rob_busy(I) & rob_issued(I) & ~rob_done(I)) -> (ex_valid & ex_idx = I)
        # a FLUSH is the youngest instruction in flight: nothing is fetched behind it
        invariant [flush_youngest] (rob_busy(I) & (rob_ir(I)<<15:13>>:opc) = 7) -> (I + 1 = rob_tail & ~d_valid)

        # ---- speculation structure ----
        invariant [shadow_suffix] (~trace.st(trace.now).error & rob_busy(I) & rob_shadow(I) & I + 1 ~= rob_tail) -> rob_shadow(I + 1)
        invariant [shadow_spec] (~trace.st(trace.now).error & rob_busy(I) & rob_shadow(I)) -> spec_wrong
        invariant [d_shadow_char] (~trace.st(trace.now).error & d_valid) -> (d_shadow = spec_wrong)
        invariant [mp_char] (~trace.st(trace.now).error & spec_wrong) ->
            (rob_busy(mp_idx) & ~rob_shadow(mp_idx) & (rob_ir(mp_idx)<<15:13>>:opc) = 6 &
             rob_pred(mp_idx) ~= trace.st(rob_tag(mp_idx)).take_branch)
        invariant [mp_unique] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & (rob_ir(I)<<15:13>>:opc) = 6 &
                               rob_pred(I) ~= trace.st(rob_tag(I)).take_branch) -> (spec_wrong & I = mp_idx)
        invariant [shadow_after_mp] (~trace.st(trace.now).error & spec_wrong & rob_busy(I) & (I - rob_head) > (mp_idx - rob_head)) -> rob_shadow(I)
        invariant [head_noshadow] (~trace.st(trace.now).error & rob_busy(rob_head)) -> ~rob_shadow(rob_head)

        # ---- the non-shadowed entries carry a contiguous run of tags [commit, now) ----
        invariant [rob_head_tag] (~trace.st(trace.now).error & rob_busy(rob_head)) -> rob_tag(rob_head) = commit
        invariant [rob_empty_tag] (~trace.st(trace.now).error & ~rob_busy(rob_head)) -> commit = trace.now
        invariant [rob_chain] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & rob_busy(I + 1) & ~rob_shadow(I + 1) & I + 1 ~= rob_tail) -> tag.succ(rob_tag(I), rob_tag(I + 1))
        invariant [rob_youngest] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & (I + 1 = rob_tail | rob_shadow(I + 1))) -> tag.succ(rob_tag(I), trace.now)
        invariant [rob_tag_range] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I)) -> (commit <= rob_tag(I) & rob_tag(I) < trace.now)

        # ---- committed architectural state; idc's abstract memory is the
        #      reference memory at the retire tag ----
        invariant [rf_trk] ~trace.st(trace.now).error -> rf(R) = trace.st(commit).rf(R)
        invariant [idc_mem_rel] ~trace.st(trace.now).error -> idc.mem(A) = trace.st(commit).mem(A)
        invariant [idc_ddirty_rel] ~trace.st(trace.now).error -> idc.ddirty(A) = trace.st(commit).ddirty(A)

        # ---- fetch coherence across the window [commit, now) ----
        # With no FLUSH in flight, every in-flight store to A leaves A dirty at
        # now; hence a fetch condition (~ddirty at now) implies no in-flight
        # store to A, and memory/dirtiness at A are unchanged across the window.
        invariant [store_dirty] (~trace.st(trace.now).error & ~flush_pending & rob_busy(I) & ~rob_shadow(I) &
                                 (rob_ir(I)<<15:13>>:opc) = 5) -> trace.st(trace.now).ddirty(trace.st(rob_tag(I)).mem_addr)
        invariant [mem_now] (~trace.st(trace.now).error & ~flush_pending & ~trace.st(trace.now).ddirty(A)) ->
            (trace.st(commit).mem(A) = trace.st(trace.now).mem(A) & ~trace.st(commit).ddirty(A))
        # the fetched word is the reference instruction (zero-delay from idc's guarantee)
        derived invariant [fetch_coh]
            (fetch_active & idc.fetch_valid0 & ~trace.st(trace.now).error & ~trace.st(trace.now).ddirty(pc))
                -> idc.fetch_data0 = trace.st(trace.now).mem(pc)
            with idc.fetch_output0
        # the loaded word is the reference value at the head's address
        derived invariant [load_coh]
            (mem_retire & r_opcode = 4 & ~trace.st(trace.now).error) -> idc.read_data = trace.st(commit).mem(r_addr)
            with idc.data_output

        # ---- fetch: on the correct path the pc is the predicted successor of the
        #      IF/ID instruction (= the true one unless that instruction is a
        #      not-yet-dispatched mispredicted branch). A word fetched from a
        #      dirty address is garbage (the ISA errors when it executes). ----
        invariant [pc_trk] (~trace.st(trace.now).error & ~spec_wrong & (d_valid -> ~trace.st(trace.now).ddirty(trace.st(trace.now).pc))) ->
            pc = (trace.st(trace.now).pc if ~d_valid else
                 ((trace.st(trace.now).target if d_pred else trace.st(trace.now).pc + 1) if d_opcode = 6 else
                  trace.st(trace.now).pc + 1))
        invariant [d_ir_trk] (~trace.st(trace.now).error & d_valid & ~d_shadow & ~trace.st(trace.now).ddirty(trace.st(trace.now).pc)) -> d_ir = trace.st(trace.now).fetched
        invariant [d_pc_trk] (~trace.st(trace.now).error & d_valid & ~d_shadow) -> d_pc = trace.st(trace.now).pc

        # ---- ROB entry contents (correct-path entries only) ----
        invariant [rob_ir_trk] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I)) -> rob_ir(I) = trace.st(rob_tag(I)).fetched
        invariant [rob_pc_trk] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I)) -> rob_pc(I) = trace.st(rob_tag(I)).pc
        invariant [rob_val_trk] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & rob_done(I)) -> rob_val(I) = trace.st(rob_tag(I)).res
        invariant [rob_take_trk] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & rob_done(I) & (rob_ir(I)<<15:13>>:opc) = 6) -> rob_take(I) = trace.st(rob_tag(I)).take_branch
        invariant [rob_a_trk] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & rob_a_rdy(I) &
                               ((rob_ir(I)<<15:13>>:opc) = 1 | (rob_ir(I)<<15:13>>:opc) = 2 | (rob_ir(I)<<15:13>>:opc) = 4 |
                                (rob_ir(I)<<15:13>>:opc) = 5 | (rob_ir(I)<<15:13>>:opc) = 6 | (rob_ir(I)<<15:13>>:opc) = 7)) -> rob_a(I) = trace.st(rob_tag(I)).a_val
        invariant [rob_b_trk] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & rob_b_rdy(I) &
                               ((rob_ir(I)<<15:13>>:opc) = 1 | (rob_ir(I)<<15:13>>:opc) = 2 | (rob_ir(I)<<15:13>>:opc) = 5)) -> rob_b(I) = trace.st(rob_tag(I)).b_val
        # a pending operand waits on a busy, not-yet-done, correct-path REGISTER-WRITING
        # entry (ALU op or LD -- the only entries the rename table points at) whose result it is
        invariant [rob_a_pend] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & ~rob_a_rdy(I)) ->
            (rob_busy(rob_a_src(I)) & ~rob_shadow(rob_a_src(I)) & ~rob_done(rob_a_src(I)) &
             ((rob_ir(rob_a_src(I))<<15:13>>:opc) = 1 | (rob_ir(rob_a_src(I))<<15:13>>:opc) = 2 |
              (rob_ir(rob_a_src(I))<<15:13>>:opc) = 3 | (rob_ir(rob_a_src(I))<<15:13>>:opc) = 4) &
             trace.st(rob_tag(rob_a_src(I))).res = trace.st(rob_tag(I)).a_val)
        invariant [rob_b_pend] (~trace.st(trace.now).error & rob_busy(I) & ~rob_shadow(I) & ~rob_b_rdy(I)) ->
            (rob_busy(rob_b_src(I)) & ~rob_shadow(rob_b_src(I)) & ~rob_done(rob_b_src(I)) &
             ((rob_ir(rob_b_src(I))<<15:13>>:opc) = 1 | (rob_ir(rob_b_src(I))<<15:13>>:opc) = 2 |
              (rob_ir(rob_b_src(I))<<15:13>>:opc) = 3 | (rob_ir(rob_b_src(I))<<15:13>>:opc) = 4) &
             trace.st(rob_tag(rob_b_src(I))).res = trace.st(rob_tag(I)).b_val)

        # ---- ALU latch ----
        invariant [ex_a_trk] (~trace.st(trace.now).error & ex_valid & ~rob_shadow(ex_idx) & (ex_opcode = 1 | ex_opcode = 2 | ex_opcode = 6)) -> ex_a = trace.st(rob_tag(ex_idx)).a_val
        invariant [ex_b_trk] (~trace.st(trace.now).error & ex_valid & ~rob_shadow(ex_idx) & (ex_opcode = 1 | ex_opcode = 2)) -> ex_b = trace.st(rob_tag(ex_idx)).b_val

        # ---- rename table (meaningful only on the correct path) ----
        invariant [rat_trk] (~trace.st(trace.now).error & ~spec_wrong & rat_valid(R)) ->
            (rob_busy(rat_idx(R)) &
             ((rob_ir(rat_idx(R))<<15:13>>:opc) = 1 | (rob_ir(rat_idx(R))<<15:13>>:opc) = 2 | (rob_ir(rat_idx(R))<<15:13>>:opc) = 3 | (rob_ir(rat_idx(R))<<15:13>>:opc) = 4) &
             (rob_ir(rat_idx(R))<<12:10>>:reg) = R &
             trace.st(trace.now).rf(R) = trace.st(rob_tag(rat_idx(R))).res)
        invariant [rf_now_trk] (~trace.st(trace.now).error & ~spec_wrong & ~rat_valid(R)) -> rf(R) = trace.st(trace.now).rf(R)
        # every busy writer of R is recorded, and rat_idx(R) is the youngest of them
        invariant [rat_youngest] (rob_busy(I) &
             ((rob_ir(I)<<15:13>>:opc) = 1 | (rob_ir(I)<<15:13>>:opc) = 2 | (rob_ir(I)<<15:13>>:opc) = 3 | (rob_ir(I)<<15:13>>:opc) = 4)) ->
            (rat_valid(rob_ir(I)<<12:10>>) &
             (I - rob_head) <= (rat_idx(rob_ir(I)<<12:10>>) - rob_head))
    }
}

# The CPU discharges idc's only assumption: the memory op at the head issues at
# most one data request per cycle (its opcode is a single value).
provide cpu.idc.one_data_op
