#lang ivy1.8

# A very simple two-stage pipelined processor.
#
# In this version, we create an unpipelined reference model
# (essentially an ISA defininition) and show the our simple two-stage
# pipelined version implementes it. This would be be easy to do in a
# direct way using invariants and simple auxiliary variables. However,
# we will do the specification and verification in a more general way
# that we cn apply to mode complex processor designs.
#
# This example is intended to illustrate a design pattern we will call
# 'reference tagging' that lets us break down the proof of large designs
# into isolated proofs of its components. 

# Instruction encoding (16 bits):
#
#     [15:13] opcode   [12:10] rd   [9:7] ra   [6:4] rb   [7:0] imm/target
#
#   opcode 0  NOP
#          1  ADD  rd, ra, rb     rf[rd] := rf[ra] + rf[rb]
#          2  SUB  rd, ra, rb     rf[rd] := rf[ra] - rf[rb]
#          3  LI   rd, imm        rf[rd] := zero_extend(imm8)
#          4  LD   rd, [ra]       rf[rd] := mem[ rf[ra] ]
#          5  ST   [ra], rb       mem[ rf[ra] ] := rf[rb]
#          6  BEQZ ra, target     if rf[ra] == 0 then pc := target
#          7  FLUSH [ra]          make prior writes to mem[ rf[ra] ] visible to fetch
#
# Memory is now *unified*: instructions are fetched from the same `mem` that
# LD/ST access (there is no separate `imem`). Because the implementation caches
# instructions and data separately (I-cache and D-cache) and the caches are not
# kept coherent, a store to an address followed by an instruction fetch of that
# address can read a stale instruction. The ISA models this: a per-address dirty
# bit `ddirty(A)` is set by ST and cleared by FLUSH, and executing an instruction
# at a dirty address drives the ISA into a sticky `error` state, after which the
# implementation is no longer required to match the reference.

# The implementation:
#
# Pipeline stages:
#   F (fetch)   : read the instruction at PC from instruction memory.
#   X (execute) : decode and execute the instruction fetched last cycle,
#                 reading/writing the register file and data memory and
#                 redirecting the PC on a taken branch.
#
# The pipeline register between F and X is (ir, ir_valid). Operands are read
# and results written in the same stage (X), so there are no data hazards. A
# taken conditional branch is resolved in X, so the instruction fetched in its
# shadow must be squashed -- a one-cycle bubble. That is the classic control
# hazard.
#

include order   # ordered abstract types

# Word (data / instruction), address (PC / memory), and register-index types.

type word
interpret word -> bv[16]
type addr
interpret addr -> bv[8]
type reg
interpret reg -> bv[3]
type opc
interpret opc -> bv[3]

# Cache line and its field types. A line is a bv[22]:
#     [21] full  [20] dirty  [19:16] hi_addr  [15:0] data
# Address A maps to line index A<<3:0>>; the hi_addr field is A<<7:4>>.
type cline
interpret cline -> bv[22]
type nib
interpret nib -> bv[4]
type bit
interpret bit -> bv[1]

# The instruction cache now has a *two-word* line (the first step toward
# dual-issue fetch). A line is a bv[36]:
#     [35] full  [34:32] tag  [31:16] word1  [15:0] word0
# Address A splits as   tag = A<<7:5>> (3 bits) . index = A<<4:1>> (nib) .
# wsel = A<<0:0>> (1 bit).  word0 is the even word (wsel=0), word1 the odd word
# (wsel=1). There is a single `full` bit per line rather than a per-word valid
# bit: at most one line is ever *half* full -- the one currently being filled --
# and that transient state is tracked by the fill state machine (ifill_* below),
# not by the array. So a completed line has both words valid; the half-filled
# line has exactly its miss word valid, known from the fill state.
type icline
interpret icline -> bv[36]
type itag
interpret itag -> bv[3]

# The clock: one exported action driven by the environment.

export action posedge

# Initial memory contents. These are immutable, uninterpreted functions (they
# are never assigned), so they represent an arbitrary-but-fixed initial memory
# image. Both the implementation (cpu) and the reference model (trace.arch)
# initialize their memories from this shared source. Sharing the source (rather
# than having the reference read the cpu's memory at init) is what lets the two
# start in the same state without a spurious interference: because posedge
# writes cpu.mem, having trace's initializer observe cpu.mem would make Ivy
# report that posedge can interfere with trace's initialization -- even though
# initialization always completes before any posedge.

function init_mem(A:addr) : word     # initial (unified) memory contents = the program

# The branch predictor is an external module: the pipeline receives its
# "predicted taken" output as an input (the `predicted_taken` wire below).
# Correctness must hold for *any* prediction (a good predictor only affects
# performance, not correctness), so the input is left unconstrained. Later we
# will implement a predictor as a separate isolate driving this input.

# This is the isa model. It is a specification-only isolate that
# provides a single action `step`. It has a number of functions
# that reflect intermediate values in the instruction execution.
# These can be used as references in verifying implmentations
# compositionally. The isa model is written as a module so we can
# re-use it if needed. 

module isa_model(init_mem) = {

    var pc : addr                 # program counter
    var rf(R:reg) : word          # register file
    var mem(A:addr) : word        # unified memory (instructions and data)
    var ddirty(A:addr) : bool     # A has been written since the last FLUSH of A
    var error : bool              # an instruction was fetched from a dirty address

    # Temporary variables computed during execution, but not holding state

    var fetched : word

    # ---- decode of the X-stage instruction (combinational) ----

    var opcode : opc
    var rd : reg
    var ra : reg
    var rb : reg
    var target : addr            # low 8 bits: branch target or immediate

    # ---- operand fetch (combinational) ----

    var a_val : word
    var b_val : word
    var mem_addr : addr          # address for LD/ST: low 8 bits of rf[ra]

    # ---- branch decision (BEQZ) ----

    var take_branch : bool

    # ---- ALU result (ADD/SUB/LI; 0 otherwise) ----
    var res : word

    # ---- reset ----

    after init {
        pc := 0;
        rf(R) := 0;            # zero the register file
        mem(A) := init_mem(A);
        ddirty(A) := false;    # nothing has been written yet
        error := false;
    }

    # Compute the temporary variables

    action prepare = {
        fetched := mem(pc);

        # ---- decode of the X-stage instruction (combinational) ----

        opcode := fetched<<15:13>>;
        rd := fetched<<12:10>>;
        ra := fetched<<9:7>>;
        rb := fetched<<6:4>>;
        target := fetched<<7:0>>;     # low 8 bits: branch target or immediate

        # ---- operand fetch ----

        a_val := rf(ra);
        b_val := rf(rb);
        mem_addr  := a_val<<7:0>>;    # address for LD/ST: low 8 bits of rf[ra]

        # ---- branch decision (BEQZ) ----

        take_branch := (opcode = 6) & (a_val = 0);

        # ---- ALU result, recorded so the pipeline invariants can compare the
        # latched result directly instead of recomputing a_val +/- b_val ----
        res := (a_val + b_val if opcode = 1 else
               (a_val - b_val if opcode = 2 else
               ((0:addr) :: target if opcode = 3 else 0)));
    }

    # Update the architectural state. The temporary variables were computed by
    # `prepare` in the pre-state, so unlike the earlier defined-function version
    # this needs no `old`: `mem_addr`, `target` and `take_branch` are plain
    # variables holding the pre-state values, unaffected by the stores below.

    action step = {

        # Fetch coherence: executing an instruction at an address written since
        # its last flush reads a stale instruction. The ISA records this by
        # entering a sticky error state (it is never cleared once set). This runs
        # before any store below, and `pc`/`ddirty` are untouched, so it reads
        # the pre-state dirty bit at the pre-state pc, as intended.
        if ddirty(pc) {
            error := true;
        }

        # Execute / write back
        if opcode = 1 {                          # ADD
            rf(rd) := a_val + b_val
        } else if opcode = 2 {                   # SUB
            rf(rd) := a_val - b_val
        } else if opcode = 3 {                   # LI
            rf(rd) := (0:addr) :: target
        } else if opcode = 4 {                   # LD
            rf(rd) := mem(mem_addr)
        } else if opcode = 5 {                   # ST
            mem(mem_addr) := b_val;
            ddirty(mem_addr) := true;            # the written line is now dirty
        } else if opcode = 7 {                   # FLUSH
            ddirty(mem_addr) := false;           # writes to this line are now visible
        }

        # Advance the PC
        if take_branch {
            pc := target;          # redirect to the branch target
        } else {
            pc := pc + 1;
        }
    }
}

# The 'trace' is a reference model that stores the sequence of isa
# states resulting from program execution. It is a specification-only
# isolate. The trace model is a bit of boilerplate we need to write to
# help with specificaiton and verification. Probably this can be
# generated from the isa model using AI. 

# This is the index type of the instruction sequence
instance tag : unbounded_sequence

isolate trace = {

    specification {
        
        # This is the isa model

        instance arch : isa_model(init_mem)


        # The value type of the instruction sequence

        type state_t = struct {

            # The architectural state

            pc : addr,                 # program counter
            rf(R:reg) : word,          # register file
            mem(A:addr) : word,        # unified memory (instructions and data)
            ddirty(A:addr) : bool,     # per-address dirty bit
            error : bool,              # sticky fetch-coherence error

            # The intermediate values

            fetched : word, 
            opcode : opc,
            rd : reg,
            ra : reg,
            rb : reg,
            target : addr,            # low 8 bits: branch target or immediate
            a_val : word,
            b_val : word,
            mem_addr  : addr,          # address for LD/ST: low 8 bits of rf[ra]
            take_branch : bool,
            res : word                 # ALU result (ADD/SUB/LI; 0 otherwise)
        }
            
        var now : tag   # the current length of the trace
        var st(T:tag) : state_t 

        # This internal procedure captures the current arch state 

        action current returns(res:state_t) = {
            res.pc := arch.pc;
            res.rf(R:reg) := arch.rf(R:reg);
            res.mem(A:addr) := arch.mem(A:addr);
            res.ddirty(A:addr) := arch.ddirty(A:addr);
            res.error := arch.error;

            # The intermediate values

            res.fetched := arch.fetched;
            res.opcode := arch.opcode;
            res.rd := arch.rd;
            res.ra := arch.ra;
            res.rb := arch.rb;
            res.target := arch.target;
            res.a_val := arch.a_val;
            res.b_val := arch.b_val;
            res.mem_addr  := arch.mem_addr ;
            res.take_branch := arch.take_branch;
            res.res := arch.res;
        }

        # Initalization computes the temporary variable values in the initial ISA
        # state and records this state in the trace.

        after init {
            now := 0;
            arch.prepare;
            st(now) := current;
        }

        # This externally called procedure steps the isa and records the new
        # state. Notice that tag is an abstract sequence type that defines only
        # zero and next, so we write `now.next` instead of `now + 1`. After
        # stepping we compute the temporary variables in the new state, before
        # adding it to the trace, so the temporary values in every trace entry
        # correspond correctly to that entry's architectural state.

        action step = {
            arch.step;
            arch.prepare;
            now := now.next;
            st(now) := current;
        }

        invariant st(now).pc = arch.pc
        invariant st(now).rf(R:reg) = arch.rf(R:reg)
        invariant st(now).mem(A:addr) = arch.mem(A:addr)
        invariant st(now).ddirty(A:addr) = arch.ddirty(A:addr)
        invariant st(now).error = arch.error

        # The intermediate values
        
        invariant st(now).fetched = arch.fetched
        invariant st(now).opcode = arch.opcode
        invariant st(now).rd = arch.rd
        invariant st(now).ra = arch.ra
        invariant st(now).rb = arch.rb
        invariant st(now).target = arch.target
        invariant st(now).a_val = arch.a_val
        invariant st(now).b_val = arch.b_val
        invariant st(now).mem_addr  = arch.mem_addr
        invariant st(now).take_branch = arch.take_branch
        invariant st(now).res = arch.res

        # The invariants above only pin the *most recent* recorded state,
        # st(now). But the pipeline implementation compares a lagging stage
        # against an *earlier* trace entry (st(now-1)). So we must also specify
        # that every recorded entry is a faithful ISA state, and that
        # consecutive entries are related by one ISA step. This is the "trace
        # is a valid execution history" boilerplate.

        # (a) Every recorded state's intermediate values are the correct decode
        #     of its own architectural state. (For st(now) this follows from the
        #     invariants above and arch's definitions; here we extend it to all
        #     recorded entries, which never change once written.)

        invariant T <= now -> st(T).fetched = st(T).mem(st(T).pc)
        invariant T <= now -> st(T).opcode = (st(T).fetched)<<15:13>>
        invariant T <= now -> st(T).rd = (st(T).fetched)<<12:10>>
        invariant T <= now -> st(T).ra = (st(T).fetched)<<9:7>>
        invariant T <= now -> st(T).rb = (st(T).fetched)<<6:4>>
        invariant T <= now -> st(T).target = (st(T).fetched)<<7:0>>
        invariant T <= now -> st(T).a_val = st(T).rf(st(T).ra)
        invariant T <= now -> st(T).b_val = st(T).rf(st(T).rb)
        invariant T <= now -> st(T).mem_addr = (st(T).a_val)<<7:0>>
        invariant T <= now -> st(T).take_branch = ((st(T).opcode = 6) & (st(T).a_val = 0))
        invariant T <= now -> st(T).res = (st(T).a_val + st(T).b_val if st(T).opcode = 1 else (st(T).a_val - st(T).b_val if st(T).opcode = 2 else ((0:addr) :: st(T).target if st(T).opcode = 3 else 0)))

        # (b) Consecutive recorded states are related by one step of the ISA.
        #     If st(T) precedes st(U) (U = T+1, U <= now), then st(U) is the
        #     result of executing st(T)'s instruction. This mirrors arch.step.

        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).pc = (st(T).target if st(T).take_branch else st(T).pc + 1)

        # error is sticky, and is set when st(T)'s instruction is fetched from a
        # dirty address (ddirty(pc) in st(T)).
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).error = (st(T).error | st(T).ddirty(st(T).pc))

        # ddirty(A): set by a ST to A, cleared by a FLUSH of A, else unchanged.
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).ddirty(A) =
                          (true  if (st(T).opcode = 5 & A = st(T).mem_addr) else
                          (false if (st(T).opcode = 7 & A = st(T).mem_addr) else
                           st(T).ddirty(A)))
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).mem(A) = (st(T).b_val if (st(T).opcode = 5 & A = st(T).mem_addr)
                                      else st(T).mem(A))
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).rf(R) = (st(T).a_val + st(T).b_val
                                         if (st(T).opcode = 1 & R = st(T).rd) else
                                     (st(T).a_val - st(T).b_val
                                         if (st(T).opcode = 2 & R = st(T).rd) else
                                     ((0:addr) :: st(T).target
                                         if (st(T).opcode = 3 & R = st(T).rd) else
                                     (st(T).mem(st(T).mem_addr)
                                         if (st(T).opcode = 4 & R = st(T).rd) else
                                     st(T).rf(R)))))

    }
}  with addr,opc, tag

# ============================================================================
# A 5-stage pipeline (IF/ID/EX/MEM/WB) with a branch predictor.
#
# Unlike 5stage_cpu_ref, we do NOT stall fetch on a branch. Instead we predict
# the branch (predict(pc)) and keep fetching speculatively. A misprediction is
# detected in EX (comparing the carried prediction against the operand-based
# branch decision) and is repaired by redirecting the PC and squashing the
# younger, wrong-path instructions.
#
# Verification uses a per-stage ghost "shadow" bit: an instruction is shadowed
# if it was fetched behind a mispredicted (but not-yet-resolved) branch. The
# trace steps only along the correct path -- when the IF stage detects that the
# prediction disagrees with the true branch outcome (known from the trace at
# tag now), it stops stepping the trace and marks subsequent fetches shadowed.
# So the trace never needs to backtrack. The invariants require a stage's data
# to match the trace only when the stage is NOT shadowed; correctness then
# rests on proving that every shadowed instruction is squashed before it can
# write the register file or memory (which holds because the branch resolves in
# EX, before MEM and WB).
# ============================================================================

object cpu = {

    specification {

        # ---- reference tags (ghost) --------------------------------------
        # As in 5stage_cpu_ref, these count non-shadowed instructions past
        # each stage boundary. Shadowed instructions are not real (not in the
        # trace) and do not advance the counts.

        var commit  : tag
        var mcommit : tag
        var ecommit : tag
        var dcommit : tag

        # ---- lane-1 tags (ghost, dual-issue) -----------------------------
        # Each boundary counter (commit/mcommit/ecommit/dcommit) is the trace
        # tag of its stage's lane-0 instruction. A stage that holds two
        # instructions has its lane-1 instruction one tag later; these vars name
        # that "middle" tag, so a boundary that jumps by two (a full bundle
        # crossing) can be written with the `succ` relation and no tag
        # arithmetic: succ(commit,w1_tag) & succ(w1_tag,mcommit), etc.
        var w1_tag : tag                # WB  lane-1 tag  (between commit, mcommit)
        var m1_tag : tag                # MEM lane-1 tag  (between mcommit, ecommit)
        var e1_tag : tag                # EX  lane-1 tag  (between ecommit, dcommit)
        var d1_tag : tag                # ID  lane-1 tag  (between dcommit, now)

        # ---- shadow bits (ghost) -----------------------------------------
        # d_shadow etc.: this stage holds a wrong-path instruction. spec_wrong:
        # the fetch stream is currently on a mispredicted path.

        var d_shadow : bool
        var e_shadow : bool
        var m_shadow : bool
        var w_shadow : bool
        var spec_wrong : bool

        # ---- previous-cycle I-fill address (ghost) -----------------------
        # ic.ifill_data returned by the memory port is mem at the address that
        # was presented one cycle earlier (the port latches it in mfa). So the
        # fill-input coherence invariant `icache_input` must talk about that
        # *previous* ifill_addr, not the current one. We mirror it here: at each
        # posedge, ifill_addr_old := ic.ifill_addr (pre-state). Since this update
        # logic is in the specification, `ic` can see it and relate its current
        # ifill_addr to ifill_addr_old.

        after init {
            commit := 0; mcommit := 0; ecommit := 0; dcommit := 0;
            w1_tag := 0; m1_tag := 0; e1_tag := 0; d1_tag := 0;
            d_shadow := false; e_shadow := false;
            m_shadow := false; w_shadow := false;
            spec_wrong := false;
        }
    }

    isolate mem_intf = {
        var ifill_addr_old : addr

        specification {
            after init {
                ifill_addr_old := 0;
            }

            # Latch the address presented to the memory port this cycle. Read as
            # a combinational wire, ic.ifill_addr is frozen at its pre-state value
            # here, exactly the address the port latches into mfa on a read.

            after posedge {
                ifill_addr_old := ic.ifill_addr;
            }
        }
    } with this
            

    # Per isolate_icache.md: cpu invariants ic does NOT need are kept `private`;
    # those it DOES need stay in `specification`. The tag-ordering (commit-chain)
    # invariants below ARE needed by ic: they force commit <= mcommit <= ecommit
    # <= dcommit <= now, hence mcommit.next <= now when m_valid, so ic can apply
    # the trace's single-step relations at the MEM tag.
    specification {

            # (3) the I-cache data invariant now lives inside the `ic` isolate (proved
            # locally). What cpu must GUARANTEE to ic is the fill-input coherence: the
            # word supplied to a fill equals the reference (when not dirty). cpu proves
            # this from (4) above, since ic.ifill_data is driven from main memory.
            # Stated in terms of ifill_addr_old (the address presented last cycle,
            # now latched in the port's mfa), since ic.ifill_data = mem(mfa). cpu can
            # prove this from main_mem; ic relates ifill_addr_old back to its current
            # ifill_addr via the held-address invariant `held_addr` below.

            invariant [icache_input] (ic.ifill_addr_valid & ic.ifill_data_valid
            & ~trace.st(trace.now).error & ~trace.st(mcommit).ddirty(mem_intf.ifill_addr_old))
            -> ic.ifill_data = trace.st(mcommit).mem(mem_intf.ifill_addr_old)
            with main_mem

        # ---- the non-shadowed instructions form a contiguous tag run -----

        # Each stage now holds 0, 1, or 2 non-shadowed instructions, so each
        # boundary counter is `succ` of the previous by 0/1/2 steps. A two-step
        # jump is expressed through the stage's lane-1 tag as the named middle
        # (succ(lo, mid) & succ(mid, hi)). In-order issue (`*_valid1 -> *_valid`)
        # forbids a gap. With lane 1 empty these reduce to the single-issue set.
        invariant w_valid1 -> w_valid
        invariant ~w_valid -> mcommit = commit
        invariant (w_valid & ~w_valid1) -> commit.succ(mcommit)
        invariant w_valid1 -> commit.succ(w1_tag)
        invariant w_valid1 -> w1_tag.succ(mcommit)

        invariant m_valid1 -> m_valid
        invariant ~m_valid -> ecommit = mcommit
        invariant (m_valid & ~m_valid1) -> mcommit.succ(ecommit)
        invariant m_valid1 -> mcommit.succ(m1_tag)
        invariant m_valid1 -> m1_tag.succ(ecommit)

        # The MEM-stage tag does not exceed the trace head (in the error-free
        # regime): mcommit <= ecommit <= dcommit <= now via the guarded chain
        # above. cpu.ic cherry-picks this (it depends on mem_intf, not this) so it
        # can apply the trace's single-step relations at the MEM tag. Guarded by
        # ~error because the upper chain (dcommit/now) is; ic only uses it under
        # ~error anyway (all its guarantees are).
        invariant [mcommit_le_now] ~trace.st(trace.now).error -> mcommit <= trace.now

        # The EX/ID and ID/IF boundary counts depend on the speculation logic
        # (dcommit/now advance only for correct-path, non-shadowed fetches), so
        # like the shadow facts below they are guarded by ~error. The WB/MEM/EX
        # boundary counts above are pure validity bookkeeping and hold regardless.
        invariant e_valid1 -> e_valid
        invariant (~e_valid & ~trace.st(trace.now).error) -> dcommit = ecommit
        invariant (e_valid & ~e_valid1 & ~trace.st(trace.now).error) -> ecommit.succ(dcommit)
        invariant (e_valid1 & ~trace.st(trace.now).error) -> ecommit.succ(e1_tag)
        invariant (e_valid1 & ~trace.st(trace.now).error) -> e1_tag.succ(dcommit)

        # A bundle shares one shadow bit (both lanes are on the same fetch path),
        # so d_shadow gates both lanes of the ID stage.
        invariant d_valid1 -> d_valid
        invariant ((~d_valid | d_shadow) & ~trace.st(trace.now).error) -> dcommit = trace.now
        invariant (d_valid & ~d_shadow & ~d_valid1 & ~trace.st(trace.now).error) -> dcommit.succ(trace.now)
        invariant (d_valid1 & ~d_shadow & ~trace.st(trace.now).error) -> dcommit.succ(d1_tag)
        invariant (d_valid1 & ~d_shadow & ~trace.st(trace.now).error) -> d1_tag.succ(trace.now)
    }

    private {

        # ---- shadowed instructions are squashed before EX ----------------
        # A wrong-path instruction is squashed when the mispredicting branch
        # resolves in EX, so it never becomes a valid EX/MEM/WB instruction.
        # Hence only the ID stage can hold a valid shadowed instruction.
        #
        # NB: the speculation-tracking invariants (the mispredict/shadow/spec_wrong
        # facts below) are guarded by ~error. They reason about the branch outcome
        # e_pred vs trace.st(ecommit).take_branch, which is only meaningful when the
        # in-flight instructions still match the reference -- i.e. before the trace
        # enters its error state. Once the program has gone wrong we make no claim
        # about the pipeline, so these become vacuous. (invar136 fails without this
        # guard precisely in a reachable-only-with-error state; see the CTI.)

        invariant ~trace.st(trace.now).error -> ~(e_valid & e_shadow)
        invariant ~trace.st(trace.now).error -> ~(m_valid & m_shadow)
        invariant ~trace.st(trace.now).error -> ~(w_valid & w_shadow)

        # ---- while shadowed, the mispredicting branch is in EX -----------
        # If ID holds a shadowed instruction, then EX holds the branch that
        # shadowed it, and that branch is genuinely mispredicted (its carried
        # prediction differs from the true outcome recorded in the trace).

        invariant (d_valid & d_shadow & ~trace.st(trace.now).error) ->
                      (e_valid & e_opcode = 6 &
                       (e_pred ~= trace.st(ecommit).take_branch))

        # Conversely, everything younger than a mispredicted branch is shadowed:
        # if EX holds a mispredicted branch, the ID instruction behind it (which
        # was fetched on the wrong path) is shadowed.

        invariant (e_valid & e_opcode = 6 & ~trace.st(trace.now).error &
                   (e_pred ~= trace.st(ecommit).take_branch)) ->
                      (~d_valid | d_shadow)

        # spec_wrong holds exactly when a mispredicted branch is unresolved in
        # ID or EX.

        invariant ~trace.st(trace.now).error ->
            spec_wrong =
            ( (d_valid & ~d_shadow & d_opcode = 6 &
               (d_pred ~= trace.st(dcommit).take_branch))
            | (e_valid & e_opcode = 6 &
               (e_pred ~= trace.st(ecommit).take_branch)) )

        # ---- error relaxation --------------------------------------------
        # Once the reference has executed an instruction fetched from a dirty
        # (stale) address, the program has "gone wrong" and we no longer require
        # the implementation to match. `error` is sticky and `now` is the
        # largest recorded tag, so `st(now).error` holds exactly when *some*
        # instruction in the executed prefix has erred. We therefore guard every
        # invariant relating implementation data to the reference by
        # ~trace.st(trace.now).error; in the error-free regime this is vacuously
        # true and the proof reduces to the coherent-pipeline argument.

        # ---- committed architectural state matches the trace -------------

        invariant [rf_track] ~trace.st(trace.now).error -> rf(R) = trace.st(commit).rf(R)

        # ---- write-back D-cache coherence (relative to the trace at MEM) ----
        # The effective memory (D-cache line where present-and-dirty, else main
        # memory) equals the reference memory at the MEM stage, st(mcommit).mem:
        #   (1) a dirty cache line's address is dirty in the reference;
        #   (2) a present cache line holds the reference's MEM-stage value;
        #   (4) a not-dirty address holds the reference value in main memory.
        # ((3), the I-cache, is below.)
        invariant [main_mem_dirty] ~trace.st(trace.now).error -> (dc_dirty(A) -> trace.st(mcommit).ddirty(A))
        invariant ~trace.st(trace.now).error -> (dc_present(A) -> dc_val(A) = trace.st(mcommit).mem(A))
        invariant [main_mem] ~trace.st(trace.now).error -> (~dc_dirty(A) -> mem(A) = trace.st(mcommit).mem(A))
    }


    private {

        # ---- the PC is the (correct) fetch address unless mispredicting ---

        invariant [pc_track] (~spec_wrong & ~trace.st(trace.now).error) -> pc = trace.st(trace.now).pc

        # ---- non-shadowed in-flight instructions match the trace ---------

        invariant (d_valid & ~d_shadow & ~trace.st(trace.now).error) -> d_ir = trace.st(dcommit).fetched
        invariant (d_valid & ~d_shadow & ~trace.st(trace.now).error) -> d_pc = trace.st(dcommit).pc
        invariant (e_valid & ~trace.st(trace.now).error) -> e_ir = trace.st(ecommit).fetched
        invariant (e_valid & ~trace.st(trace.now).error) -> e_pc = trace.st(ecommit).pc
        invariant (m_valid & ~trace.st(trace.now).error) -> m_ir = trace.st(mcommit).fetched
        invariant (w_valid & ~trace.st(trace.now).error) -> w_ir = trace.st(commit).fetched

        # ---- MEM latch computed values match the trace -------------------

        invariant (m_valid & ~trace.st(trace.now).error) -> m_addr = trace.st(mcommit).mem_addr
        invariant (m_valid & ~trace.st(trace.now).error) -> m_store = trace.st(mcommit).b_val
        invariant (m_valid & (m_opcode = 1 | m_opcode = 2 | m_opcode = 3) & ~trace.st(trace.now).error) -> m_res = trace.st(mcommit).res

        # ---- WB latch writeback value matches the trace ------------------

        invariant (w_valid & (w_opcode = 1 | w_opcode = 2 | w_opcode = 3) & ~trace.st(trace.now).error) -> w_val = trace.st(commit).res
        invariant (w_valid & w_opcode = 4 & ~trace.st(trace.now).error) -> w_val = trace.st(commit).mem(trace.st(commit).mem_addr)

        # ---- lane-1 (dual-issue) trace match, at the lane-1 tags ----------
        # Lane 1 is the younger instruction of an aligned bundle; it shares the
        # bundle's shadow bit (d_shadow) and, in the easy case, is always
        # "simple" (opcode 0/1/2/3: NOP/ADD/SUB/LI) -- never memory or branch, so
        # there are no lane-1 m_addr/m_store/branch fields to relate.
        # lane 0 of a dual bundle is also simple (issue_two requires f_simple0),
        # so a dual bundle never carries a branch/memory op in lane 0.
        invariant d_valid1 -> (d_opcode = 0 | d_opcode = 1 | d_opcode = 2 | d_opcode = 3)
        invariant e_valid1 -> (e_opcode = 0 | e_opcode = 1 | e_opcode = 2 | e_opcode = 3)
        invariant m_valid1 -> (m_opcode = 0 | m_opcode = 1 | m_opcode = 2 | m_opcode = 3)
        invariant w_valid1 -> (w_opcode = 0 | w_opcode = 1 | w_opcode = 2 | w_opcode = 3)
        invariant d_valid1 -> (d_opcode1 = 0 | d_opcode1 = 1 | d_opcode1 = 2 | d_opcode1 = 3)
        invariant e_valid1 -> (e_opcode1 = 0 | e_opcode1 = 1 | e_opcode1 = 2 | e_opcode1 = 3)
        invariant m_valid1 -> (m_opcode1 = 0 | m_opcode1 = 1 | m_opcode1 = 2 | m_opcode1 = 3)
        invariant w_valid1 -> (w_opcode1 = 0 | w_opcode1 = 1 | w_opcode1 = 2 | w_opcode1 = 3)

        invariant (d_valid1 & ~d_shadow & ~trace.st(trace.now).error) -> d_ir1 = trace.st(d1_tag).fetched
        invariant (d_valid1 & ~d_shadow & ~trace.st(trace.now).error) -> d_pc1 = trace.st(d1_tag).pc
        invariant (e_valid1 & ~trace.st(trace.now).error) -> e_ir1 = trace.st(e1_tag).fetched
        invariant (e_valid1 & ~trace.st(trace.now).error) -> e_pc1 = trace.st(e1_tag).pc

        # ---- EX operands track the trace operand values --------------------
        # e_a/e_b are the register-file reads for the EX instruction; they must
        # equal the trace's recorded a_val/b_val at the EX tag. Once these hold,
        # the ALU-result invariants (m_res = st(mcommit).res, etc.) follow without
        # re-deriving rf-coherence.
        invariant [ea_trk]  (e_valid  & ~ex_stall & ~trace.st(trace.now).error) -> e_a  = trace.st(ecommit).a_val
            with rf_track
        invariant [eb_trk]  (e_valid  & ~ex_stall & ~trace.st(trace.now).error) -> e_b  = trace.st(ecommit).b_val
            with rf_track
        invariant [ea1_trk] (e_valid1 & ~ex_stall & ~trace.st(trace.now).error) -> e_a1 = trace.st(e1_tag).a_val
            with rf_track
        invariant [eb1_trk] (e_valid1 & ~ex_stall & ~trace.st(trace.now).error) -> e_b1 = trace.st(e1_tag).b_val
            with rf_track

        # Intra-bundle independence: lane 0's destination differs from lane 1's
        # source and destination registers (established by f_indep at issue). This
        # is what lets lane 1's operand read see the same rf value the trace has at
        # e1_tag = ecommit.next -- lane 0 (tag ecommit) is inside [commit, e1_tag),
        # so ~ex_stall alone does not cover it.
        invariant [d_indep] d_valid1 -> (~(d_opcode = 1 | d_opcode = 2 | d_opcode = 3)
                               | (d_rd ~= d_ra1 & d_rd ~= d_rb1 & d_rd ~= d_rd1))
        invariant [e_indep] e_valid1 -> (~(e_opcode = 1 | e_opcode = 2 | e_opcode = 3)
                               | (e_rd ~= e_ra1 & e_rd ~= e_rb1 & e_rd ~= e_rd1))
        invariant (m_valid1 & ~trace.st(trace.now).error) -> m_ir1 = trace.st(m1_tag).fetched
        invariant (w_valid1 & ~trace.st(trace.now).error) -> w_ir1 = trace.st(w1_tag).fetched
        invariant (m_valid1 & (m_opcode1 = 1 | m_opcode1 = 2 | m_opcode1 = 3) & ~trace.st(trace.now).error) -> m_res1 = trace.st(m1_tag).res
        invariant (w_valid1 & (w_opcode1 = 1 | w_opcode1 = 2 | w_opcode1 = 3) & ~trace.st(trace.now).error) -> w_val1 = trace.st(w1_tag).res

        # Fetch-reference (now) coherence of the two fetched words, proved in cpu
        # via the ic guarantees as zero-delay (combinational) dependencies. These
        # are what the pc-tracking and lane-data invariants need: the fetched word
        # equals the reference memory at the fetch address for the *current* trace
        # position, not just at mcommit.
        invariant [fetch0_coh]
          fetch_active & ic.fetch_valid & ~trace.st(trace.now).error
             & ~trace.st(trace.now).ddirty(pc)
             -> ic.fetch_data = trace.st(trace.now).mem(pc)
        with ic.icache_output

        invariant [fetch1_coh]
          fetch_active & ic.fetch_valid1 & ~trace.st(trace.now).error
             & ~trace.st(trace.now).ddirty(pc+1)
             -> ic.fetch_data1 = trace.st(trace.now).mem(pc+1)
        with ic.icache_output1, ic.icache_output1_odd


    }

    specification {

        # ---- ghost bookkeeping ------------------------------------------
        # The reference tags, the shadow bits, and the trace step are all
        # ghost state. We update them here, in the specification, rather than
        # in the datapath `after posedge` below, so that the datapath is
        # free of ghost state and can be translated to RTL. This monitor
        # mirrors the datapath's stage movement, reading the pre-state of the
        # real signals (validity bits via `old`; the combinational wires
        # ex_stall / mispredict / f_ptaken are frozen at their pre-state
        # values, so they need no `old`).

        after posedge {
            # Each boundary advances by the number of instructions that cross it
            # (0/1/2). A bundle of two advances the counter twice.
            if old w_valid1 { commit := commit.next.next }
            else if old w_valid { commit := commit.next };
            if dmem_stall {
                # MEM stalls for a D-fill: WB drains (commit advanced above) and
                # bubbles; MEM and everything behind hold, so no other tag moves
                # and no instruction is issued to the trace.
                w_shadow := false
            } else {
            # Tie the physical FLUSH wires to the reference: whenever the MEM-stage
            # instruction (at tag mcommit) is a FLUSH, the I-cache invalidation
            # inputs fire for its address. `ic` assumes this to prove that when the
            # reference clears a dirty bit (FLUSH), the corresponding I-cache line
            # is evicted -- preserving its data invariant.
            ensure (~trace.st(trace.now).error & old m_valid & trace.st(mcommit).opcode = 7)
                       -> (ic.flush_valid & ic.flush_addr = trace.st(mcommit).mem_addr);
            if old m_valid1 { mcommit := mcommit.next.next }
            else if old m_valid { mcommit := mcommit.next };
            w_shadow := m_shadow;
            if ~ex_stall {
                m_shadow := e_shadow;
                if old e_valid1 { ecommit := ecommit.next.next }
                else if old e_valid { ecommit := ecommit.next };
                if mispredict {
                    spec_wrong := false
                } else {
                    if old d_valid1 & ~d_shadow { dcommit := dcommit.next.next }
                    else if old d_valid & ~d_shadow { dcommit := dcommit.next };
                    e_shadow := d_shadow;
                    if flush_in_pipe | ifetch_stall {
                        # IF stalled (pending FLUSH or awaiting an I-cache fill):
                        # a bubble enters ID, no instruction is issued to the
                        # trace, and `now` does not advance.
                        d_shadow := false
                    } else {
                        d_shadow := spec_wrong;
                        if ~spec_wrong {
                            if f_ptaken ~= trace.st(trace.now).take_branch {
                                spec_wrong := true
                            };
                            trace.step;
                            # a dual issue fetches two instructions: step the trace
                            # again for the second (which is non-branch, so it needs
                            # no prediction check).
                            if issue_two { trace.step }
                        }
                    }
                }
            }
            };
            # Lane-1 tags: the middle tag of any two-instruction stage is one past
            # that stage's lane-0 boundary. Set unconditionally (vacuous when the
            # lane is empty); this maintains succ(boundary, lane1_tag) always, and
            # succ(lane1_tag, next_boundary) whenever the stage holds two.
            w1_tag := commit.next;
            m1_tag := mcommit.next;
            e1_tag := ecommit.next;
            d1_tag := dcommit.next
        }
    }

    # The branch predictor is the sub-isolate `bp`, declared further down (after
    # the datapath signals it consumes). It drives bp.predicted_taken, which the
    # fetch stage reads via f_ptaken. Since bp's logic is hidden in its own
    # isolate, the CPU is verified with the prediction left arbitrary.

    # ---- architectural state ----

    var pc : addr
    var rf(R:reg) : word
    var mem(A:addr) : word         # unified main memory (instructions and data)

    # ---- D-cache (direct-mapped, write-back, 16 lines x 1 word) ----
    # Each line is a packed bv[22] as described at the top: [21] full, [20] dirty,
    # [19:16] hi_addr, [15:0] data. Lines are built with `concat` and their fields
    # read with `bfe` (see the ln_* accessors below). Data accesses (LD/ST) go
    # through this cache; instruction fetch reads the separate I-cache. A store
    # that lives only in the (write-back) D-cache leaves a stale value in main
    # memory -- the incoherence the ISA's ddirty/error mechanism accounts for.

    var dcache(I:nib) : cline

    # ---- I-cache ----
    # The I-cache (array, two-word-line fill state machine, accessors, and its
    # data invariant) now lives in the nested isolate `ic` (declared below, after
    # the datapath signals it connects to), so that its data invariant is proved
    # *locally*. cpu reaches it only through ic's interface wires.

    # ---- packed-line accessors and cache queries (proof-only) ----
    # In a `specification` block so ivy_to_rtl does not emit them (they are used
    # only by the invariants; otherwise they would materialize as spurious lookup
    # memories). The datapath reads the same fields with bfe inline. A line is
    # [21] full | [20] dirty | [19:16] hi_addr | [15:0] data.
    specification {
        # function ln_full(L:cline) : bool
        # definition ln_full(L) = (L<<21:21>>:bit) = 1
        # function ln_dirty(L:cline) : bool
        # definition ln_dirty(L) = (L<<20:20>>:bit) = 1
        function ln_hi(L:cline) : nib
        definition ln_hi(L) = L<<19:16>>
        function ln_data(L:cline) : word
        definition ln_data(L) = L<<15:0>>
        # A is present iff its line is full and the hi_addr field matches; the
        # cached address is then structurally (hi_addr :: index(A)) = A, so no
        # separate "line is at the right index" invariant is needed.
        function dc_line(A:addr) : cline
        definition dc_line(A) = dcache(A<<3:0>>)
        function dc_present(A:addr) : bool
        definition dc_present(A) = (dc_line(A)<<21:21>>:bit) = 1  & (ln_hi(dc_line(A)) = A<<7:4>>)
        function dc_dirty(A:addr) : bool
        definition dc_dirty(A) = dc_present(A) & (dc_line(A)<<20:20>>:bit) = 1
        function dc_val(A:addr) : word
        definition dc_val(A) = ln_data(dc_line(A))
        # (The I-cache accessors il_*/ic_* moved into the `ic` isolate below.)
    }

    # ---- main-memory read-fill controller (multi-cycle) ----
    # Each memory read takes two cycles: an initiating cycle (memory free) and a
    # busy cycle in which the read completes and the value is available
    # (bypassed). Write-backs are modelled as instant, so only read fills use
    # this port. A D-fill is one read (one word); an I-fill is *two* reads (the
    # two-word line), issued miss-word-first as a small state machine (ifill_*
    # above): read the miss word, install it (line half full), then read and
    # install the sibling word (line full). A D-fill freezes IF and the sibling
    # read has priority over a new D-fill, so at most one fill (hence one
    # half-full line) is ever in progress and D-over-I arbitration is automatic.
    # mbusy marks the busy cycle; mfa is the address being read; mfi says whether
    # this read belongs to an I-fill (else a D-fill).

    var mbusy : bool
    var mfa : addr
    var mfi : bool

    # ---- pipeline latches ----

    var d_ir : word                 # IF/ID
    var d_valid : bool
    var d_pred : bool               #   predicted-taken bit carried with the instruction
    var d_pc : addr                 #   the instruction's own PC
    var e_ir : word                 # ID/EX
    var e_valid : bool
    var e_pred : bool
    var e_pc : addr
    var m_ir : word                 # EX/MEM
    var m_valid : bool
    var m_res : word
    var m_addr : addr
    var m_store : word
    var w_ir : word                 # MEM/WB
    var w_valid : bool
    var w_val : word

    # ---- lane-1 pipeline latches (dual-issue Step 1: two-lane skeleton) ----
    # The younger instruction of an aligned pair rides in lane 1. In Step 1 the
    # issue width is hardwired to 1 (d_valid1 is always driven false), so every
    # *_valid1 is provably false and lane 1 is an ever-empty bubble carried
    # alongside lane 0. The computed lane-1 values (m_res1/w_val1) are don't-cares
    # while the lane is empty; they get their real combinational datapath in
    # Step 2 together with the issue logic that fills the lane.
    var d_ir1 : word                # IF/ID   (lane 1)
    var d_valid1 : bool
    var d_pred1 : bool
    var d_pc1 : addr
    var e_ir1 : word                # ID/EX   (lane 1)
    var e_valid1 : bool
    var e_pred1 : bool
    var e_pc1 : addr
    var m_ir1 : word                # EX/MEM  (lane 1)
    var m_valid1 : bool
    var m_res1 : word
    var m_addr1 : addr
    var m_store1 : word
    var w_ir1 : word                # MEM/WB  (lane 1)
    var w_valid1 : bool
    var w_val1 : word

    # ---- decode wires ----

    implementation {
    wire d_opcode : opc
    definition d_opcode = d_ir<<15:13>>
    wire d_opcode1 : opc
    definition d_opcode1 = d_ir1<<15:13>>
    wire d_rd : reg
    definition d_rd = d_ir<<12:10>>
    wire d_ra1 : reg
    definition d_ra1 = d_ir1<<9:7>>
    wire d_rb1 : reg
    definition d_rb1 = d_ir1<<6:4>>
    wire d_rd1 : reg
    definition d_rd1 = d_ir1<<12:10>>

    wire e_opcode : opc
    wire e_rd : reg
    wire e_ra : reg
    wire e_rb : reg
    wire e_target : addr
    definition e_opcode = e_ir<<15:13>>
    definition e_rd = e_ir<<12:10>>
    definition e_ra = e_ir<<9:7>>
    definition e_rb = e_ir<<6:4>>
    definition e_target = e_ir<<7:0>>

    wire m_opcode : opc
    wire m_rd : reg
    definition m_opcode = m_ir<<15:13>>
    definition m_rd = m_ir<<12:10>>

    wire w_opcode : opc
    wire w_rd : reg
    definition w_opcode = w_ir<<15:13>>
    definition w_rd = w_ir<<12:10>>

    # ---- EX operands and the true branch decision ----

    wire e_a : word
    wire e_b : word
    definition e_a = rf(e_ra)
    definition e_b = rf(e_rb)

    wire e_take : bool               # the true (operand-based) branch decision
    definition e_take = (e_opcode = 6) & (e_a = 0)

    # ---- lane-1 decode / operands / ALU (dual-issue) ----------------------
    # Lane 1 carries the younger instruction of an aligned pair. In the easy
    # case it is always "simple" (NOP/ADD/SUB/LI: opcode 0/1/2/3) -- never a
    # branch, memory op, or FLUSH -- so it needs no branch decision and no
    # D-cache access, only decode, operand read, and the ALU.
    wire e_opcode1 : opc
    wire e_rd1 : reg
    wire e_ra1 : reg
    wire e_rb1 : reg
    wire e_target1 : addr
    definition e_opcode1 = e_ir1<<15:13>>
    definition e_rd1 = e_ir1<<12:10>>
    definition e_ra1 = e_ir1<<9:7>>
    definition e_rb1 = e_ir1<<6:4>>
    definition e_target1 = e_ir1<<7:0>>
    wire e_a1 : word
    wire e_b1 : word
    definition e_a1 = rf(e_ra1)
    definition e_b1 = rf(e_rb1)
    wire e_res1 : word               # lane-1 ALU result (computed in EX)
    definition e_res1 = (e_a1 + e_b1 if e_opcode1 = 1 else
                        (e_a1 - e_b1 if e_opcode1 = 2 else
                        ((0:addr) :: e_target1 if e_opcode1 = 3 else 0)))

    wire m_opcode1 : opc
    wire m_rd1 : reg
    definition m_opcode1 = m_ir1<<15:13>>
    definition m_rd1 = m_ir1<<12:10>>
    wire w_opcode1 : opc
    wire w_rd1 : reg
    definition w_opcode1 = w_ir1<<15:13>>
    definition w_rd1 = w_ir1<<12:10>>

    # ---- data-hazard stall (as in 5stage_cpu_ref) ----

    # Register-file writer slots (both lanes of MEM and WB). Lane 1 is always
    # simple (opcode 1/2/3 write; 0/NOP does not), never a load.
    wire m0_wr : bool
    definition m0_wr = m_valid & (m_opcode = 1 | m_opcode = 2 | m_opcode = 3 | m_opcode = 4)
    wire m1_wr : bool
    definition m1_wr = m_valid1 & (m_opcode1 = 1 | m_opcode1 = 2 | m_opcode1 = 3)
    wire w0_wr : bool
    definition w0_wr = w_valid & (w_opcode = 1 | w_opcode = 2 | w_opcode = 3 | w_opcode = 4)
    wire w1_wr : bool
    definition w1_wr = w_valid1 & (w_opcode1 = 1 | w_opcode1 = 2 | w_opcode1 = 3)

    # A source register has a pending in-flight writer (RAW; no forwarding, so
    # the reader must stall until the writer retires). Intra-bundle dependences
    # are prevented at issue, so only MEM/WB (older) slots appear here. One wire
    # per source register read (both EX lanes) -- nullary so it translates to RTL
    # (a parameterized function would not be recognized as combinational).
    wire hz_ea : bool
    definition hz_ea = (m0_wr & m_rd = e_ra) | (m1_wr & m_rd1 = e_ra)
                     | (w0_wr & w_rd = e_ra) | (w1_wr & w_rd1 = e_ra)
    wire hz_eb : bool
    definition hz_eb = (m0_wr & m_rd = e_rb) | (m1_wr & m_rd1 = e_rb)
                     | (w0_wr & w_rd = e_rb) | (w1_wr & w_rd1 = e_rb)
    wire hz_ea1 : bool
    definition hz_ea1 = (m0_wr & m_rd = e_ra1) | (m1_wr & m_rd1 = e_ra1)
                      | (w0_wr & w_rd = e_ra1) | (w1_wr & w_rd1 = e_ra1)
    wire hz_eb1 : bool
    definition hz_eb1 = (m0_wr & m_rd = e_rb1) | (m1_wr & m_rd1 = e_rb1)
                      | (w0_wr & w_rd = e_rb1) | (w1_wr & w_rd1 = e_rb1)

    wire ex_stall : bool
    definition ex_stall = (e_valid  & (hz_ea  | hz_eb))
                        | (e_valid1 & (hz_ea1 | hz_eb1))

    # ---- misprediction: the EX branch's prediction disagrees with its true
    #      outcome. Detected only once its operand is available (~ex_stall).

    wire mispredict : bool
    definition mispredict = e_valid & ~ex_stall & (e_opcode = 6) & (e_pred ~= e_take)

    }
    # ---- the branch predictor, as a sub-isolate `bp` ----
    # `bp` declares its own input/output wires and its logic uses only those; it
    # never reaches into the CPU. Here, in the parent, we connect it: its inputs
    # are driven from the CPU's fetch PC and branch resolution, and the CPU's
    # prediction (f_ptaken, below) reads its output. Because bp's logic lives in
    # its (hidden) implementation, Ivy verifies the CPU with bp.predicted_taken
    # left arbitrary -- correctness holds for any prediction.

    isolate bp = {
        wire fetch_pc : addr          # input: PC being fetched (to predict)
        wire br_valid : bool          # input: a conditional branch resolves this cycle
        wire br_pc : addr             # input: the resolving branch's PC
        wire br_taken : bool          # input: its true outcome
        wire predicted_taken : bool   # output: the prediction for fetch_pc

        implementation {
            type bhtidx
            interpret bhtidx -> bv[4]  # 16-entry branch history table
            type ctr
            interpret ctr -> bv[2]     # 2-bit saturating counter, states 0..3

            var bht(I:bhtidx) : ctr

            wire pred_idx : bhtidx
            definition pred_idx = fetch_pc<<3:0>>
            wire upd_idx : bhtidx
            definition upd_idx = br_pc<<3:0>>

            # predict taken when the indexed counter is in a taken state (2 or 3)
            definition predicted_taken = (bht(pred_idx) = 2) | (bht(pred_idx) = 3)

            after init {
                bht(I) := 1            # weakly not-taken
            }

            # on a resolved branch, nudge its counter toward the outcome,
            # saturating at 0 and 3
            after posedge {
                if br_valid {
                    if br_taken {
                        if bht(upd_idx) ~= 3 { bht(upd_idx) := bht(upd_idx) + 1 }
                    } else {
                        if bht(upd_idx) ~= 0 { bht(upd_idx) := bht(upd_idx) - 1 }
                    }
                }
            }
        }
    }

    # connect the predictor's inputs to the CPU (in the parent)
    definition bp.fetch_pc = pc
    definition bp.br_valid = e_valid & (e_opcode = 6) & ~ex_stall
    definition bp.br_pc = e_pc
    definition bp.br_taken = e_take

    # ============================================================================
    # The I-cache, as the sub-isolate `ic`.
    #
    # `ic` owns the I-cache array, the two-word fill state machine, the accessors,
    # and the I-cache data invariant, so that invariant is proved *locally* (only
    # ic's own state is in scope). ic exposes an interface: cpu drives the fetch
    # address and consumes the fetched word; ic requests memory reads (ifill_addr)
    # which cpu's shared memory port services (returning ifill_data); and a FLUSH
    # in MEM drives ic's invalidation inputs. ic depends on the cpu specification
    # and trace (`with this, trace`) because its coherence invariant is stated
    # relative to the reference trace at the MEM-stage tag (mcommit).
    # ============================================================================
    isolate ic = {
        # ---- interface wires ----
        wire fetch_addr : addr          # input:  PC being fetched
        wire fetch_addr_valid : bool    # input:  IF is attempting a fetch this cycle
        wire ifill_data : word          # input:  word returned by the memory port
        wire ifill_data_valid : bool    # input:  an I-read completes this cycle
        wire flush_addr : addr          # input:  address FLUSHed in MEM
        wire flush_valid : bool         # input:  a FLUSH executes in MEM this cycle
        wire fetch_data : word          # output: selected word at fetch_addr
        wire fetch_valid : bool         # output: fetch_data valid (hit / mid-fill / arrival)
        wire fetch_data1 : word         # output: word at the odd sibling (dual issue lane 1)
        wire fetch_valid1 : bool        # output: fetch_data1 valid
        wire fetch_addr1 : addr         # output: the odd sibling address (fetch_addr | 1)
        wire ifill_addr : addr          # output: address ic wants read from memory
        wire ifill_addr_valid : bool    # output: ic is requesting a memory read
        wire ifill_busy : bool          # output: a fill is in progress (its port slot)

        # ---- I-cache array and fill state (real state) ----
        var icache(I:nib) : icline
        var ifill_on   : bool           # an I-fill (two words) is in progress
        var ifill_got  : bool           # the miss word has been installed; sibling pending
        var ifill_miss : addr           # the miss word's address

        implementation {
            # sibling of the miss word (bit 0 toggled; parity known, so +1/-1)
            wire sib : addr
            definition sib = (ifill_miss + 1 if (ifill_miss<<0:0>>:bit) = 0 else ifill_miss - 1)

            # ---- fetch read: mux the low/high word; a hit is a completed-line
            # hit, a mid-fill (miss-word) hit, or the just-arrived fill word.
            wire f_index : nib
            definition f_index = fetch_addr<<4:1>>
            wire f_wsel : bit
            definition f_wsel = fetch_addr<<0:0>>
            wire f_iline : icline
            definition f_iline = icache(f_index)
            wire f_full_hit : bool
            definition f_full_hit = ((f_iline<<35:35>>:bit) = 1) & ((f_iline<<34:32>>:itag) = fetch_addr<<7:5>>)
            wire f_fill_hit : bool
            definition f_fill_hit = ifill_got & (fetch_addr = ifill_miss)
            wire f_arr_hit : bool
            definition f_arr_hit = f_full_hit | f_fill_hit
            wire f_cword : word
            definition f_cword = ((f_iline<<15:0>>:word) if f_wsel = 0 else (f_iline<<31:16>>:word))
            wire f_bypass : bool            # the arriving fill word is for fetch_addr
            # Gated on ifill_on: a legitimate ifill_data_valid only occurs on the
            # busy cycle of a read this isolate requested, when ifill_on is set.
            # Without the gate, an (arbitrary) ifill_data_valid could spuriously
            # signal a hit in a non-filling state (e.g. at init) and break the
            # guarantee, since fetch_data would then be the arbitrary ifill_data.
            # Also void the bypass when a FLUSH this cycle targets the fill
            # address: the returned word is stale (same reason the install is
            # gated below), so the fetch must miss and refetch rather than
            # forward it.
            definition f_bypass = ifill_on & ifill_data_valid & (ifill_addr = fetch_addr)
                                  & ~(flush_valid & (flush_addr = ifill_addr))

            definition fetch_valid = f_arr_hit | f_bypass
            definition fetch_data  = (f_cword if f_arr_hit else ifill_data)

            # ---- lane 1 (dual issue): the odd sibling word of the same pair ----
            # The younger instruction of an aligned pair is the odd address of
            # fetch_addr's own two-word line, so it shares the line's index and
            # tag: a full-line hit for lane 1 is exactly f_full_hit, and its data
            # is the high word (word1). This output is only consumed by cpu when
            # fetch_addr is even (dual issue); cpu ignores it on an odd PC.
            # The sibling is the next address; lane 1 is only offered on an even
            # PC (f_wsel = 0), where fetch_addr+1 is the odd word of the same line
            # (same index/tag, bit 0 set). On an odd PC lane 1 is voided.
            definition fetch_addr1 = fetch_addr + 1
            wire f_fill_hit1 : bool         # the odd word is the just-installed miss word
            definition f_fill_hit1 = ifill_got & (fetch_addr1 = ifill_miss)
            wire f_arr_hit1 : bool
            definition f_arr_hit1 = f_full_hit | f_fill_hit1
            wire f_cword1 : word            # the high (odd) word of the line
            definition f_cword1 = (f_iline<<31:16>>:word)
            wire f_bypass1 : bool           # the arriving fill word is for the odd sibling
            definition f_bypass1 = ifill_on & ifill_data_valid & (ifill_addr = fetch_addr1)
                                   & ~(flush_valid & (flush_addr = ifill_addr))
            definition fetch_valid1 = (f_wsel = 0) & (f_arr_hit1 | f_bypass1)
            definition fetch_data1  = (f_cword1 if f_arr_hit1 else ifill_data)

            # ---- fill request: which word to read (miss word, then sibling), and
            # whether a read is wanted. A new miss requests fetch_addr; once a fill
            # is on, it requests the outstanding word.
            definition ifill_addr = (fetch_addr if ~ifill_on & ~ifill_got else (ifill_miss if ~ifill_got else sib))
            definition ifill_addr_valid = ifill_on | ifill_got | (fetch_addr_valid & ~fetch_valid)
            definition ifill_busy = ifill_on | ifill_got

            # ---- FLUSH invalidation of the addressed line (tag match) ----
            wire fl_index : nib
            definition fl_index = flush_addr<<4:1>>
            wire fl_iline : icline
            definition fl_iline = icache(fl_index)
            wire fl_ihit : bool
            definition fl_ihit = ((fl_iline<<35:35>>:bit) = 1) & ((fl_iline<<34:32>>:itag) = flush_addr<<7:5>>)

            after init {
                icache(I) := 0;
                ifill_on := false;
                ifill_got := false
            }

            after posedge {
                # Ignore the returned fill word when a FLUSH this cycle targets the
                # very address being read: that word is stale (read before the
                # FLUSH made the prior store visible) and would violate coherence.
                if ifill_on & ifill_data_valid & ~(flush_valid & (flush_addr = ifill_addr)) {
                    if ~ifill_got {
                        # miss word: (re)allocate the line with this word, full = 0
                        if (ifill_miss<<0:0>>:bit) = 0 {
                            icache(ifill_miss<<4:1>>) :=
                                ((0:bit) :: (ifill_miss<<7:5>>:itag) :: (0:word) :: ifill_data : icline)
                        } else {
                            icache(ifill_miss<<4:1>>) :=
                                ((0:bit) :: (ifill_miss<<7:5>>:itag) :: ifill_data :: (0:word) : icline)
                        };
                        ifill_on := false;
                        ifill_got := true
                    } else {
                        # sibling word: fill the other slot, preserve the miss word, full = 1
                        if (sib<<0:0>>:bit) = 0 {
                            icache(sib<<4:1>>) :=
                                ((1:bit) :: (sib<<7:5>>:itag)
                                         :: (icache(sib<<4:1>>)<<31:16>>:word) :: ifill_data : icline)
                        } else {
                            icache(sib<<4:1>>) :=
                                ((1:bit) :: (sib<<7:5>>:itag)
                                         :: ifill_data :: (icache(sib<<4:1>>)<<15:0>>:word) : icline)
                        };
                        ifill_on := false;
                        ifill_got := false
                    }
                } else if ~ifill_on & ifill_got {
                    ifill_on := true;
                } else if ~ifill_busy & fetch_addr_valid & ~fetch_valid {
                    # new miss: latch the miss address and start the fill
                    ifill_on := true;
                    ifill_got := false;
                    ifill_miss := fetch_addr
                };
                # FLUSH: evict the whole addressed word-pair line
                if flush_valid & fl_ihit {
                    icache(fl_index) := 0
                };
                # If the FLUSH targets the miss word we already installed, that
                # cached word is now stale (the FLUSH made a prior store to it
                # visible); drop ifill_got so the fill machine rereads and
                # reinstalls the miss word from the now-current memory.
                if flush_valid & (flush_addr = ifill_miss) {
                    ifill_on := false;
                    ifill_got := false
                }
            }
        }

        specification {
            # packed-line accessors (proof-only)
            # function il_full(L:icline) : bool
            # definition il_full(L) = (L<<35:35>>:bit) = 1
            function il_tag(L:icline) : itag
            definition il_tag(L) = L<<34:32>>
            function il_w0(L:icline) : word
            definition il_w0(L) = L<<15:0>>
            function il_w1(L:icline) : word
            definition il_w1(L) = L<<31:16>>
            function ic_line(A:addr) : icline
            definition ic_line(A) = icache(A<<4:1>>)
            # function ic_val(A:addr) : word
            # definition ic_val(A) = (il_w0(ic_line(A)) if (A<<0:0>>:bit) = 0 else il_w1(ic_line(A)))
            # function ic_present(A:addr) : bool
            # definition ic_present(A) = (((ic_line(A)<<35:35>>:bit) = 1) & (il_tag(ic_line(A)) = A<<7:5>>))
            #                          | (ifill_got & A = ifill_miss)

            # GUARANTEE: a valid fetched word is coherent with the reference memory
            # at the MEM stage (for a not-dirty address).
            invariant [icache_output]
                  fetch_addr_valid & fetch_valid & ~trace.st(trace.now).error
                          & ~trace.st(mcommit).ddirty(fetch_addr)
                              -> fetch_data = trace.st(mcommit).mem(fetch_addr)
            with icache_input

            # GUARANTEE for lane 1: the odd sibling word is likewise coherent.
            # Same proof as icache_output via `hard` at fetch_addr1 (array hit)
            # and icache_input (the fill bypass, a combinational input path).
            invariant [icache_output1]
                  fetch_addr_valid & fetch_valid1 & ~trace.st(trace.now).error
                          & ~trace.st(mcommit).ddirty((fetch_addr + 1))
                              -> fetch_data1 = trace.st(mcommit).mem((fetch_addr + 1))
            with icache_input

            invariant [icache_output1_odd] fetch_addr_valid & fetch_valid1 -> (fetch_addr<<0:0>>:bit = 0)

        }

        private {
            # The I-cache data invariant -- proved locally here.
            invariant [hard] ~trace.st(trace.now).error ->
                         ((((((ic_line(A)<<35:35>>:bit) = 1) & (il_tag(ic_line(A)) = A<<7:5>>))
                                     | (ifill_got & A = ifill_miss)) & ~trace.st(mcommit).ddirty(A)) ->
            (il_w0(ic_line(A)) if (A<<0:0>>:bit) = 0 else il_w1(ic_line(A))) = trace.st(mcommit).mem(A))

            # Well-formedness of the half-filled line: while mid-fill, the line at
            # the miss word's index is NOT marked full and carries the miss word's
            # tag. The `~full` part is what stops a FLUSH -- which only clears a
            # full line whose tag matches -- from clobbering the in-progress fill
            # line (the CTI where the fill clause claims a word the array lost).
            invariant [midfill] (ifill_got) ->
                         ( ((ic_line(ifill_miss)<<35:35>>:bit) = 0)
                         & (il_tag(ic_line(ifill_miss)) = ifill_miss<<7:5>>) )

            # Held-address property: while a fill is on, the address ic presents
            # (ifill_addr) equals the one latched last cycle (ifill_addr_old).
            # This lets ic turn `icache_input` (phrased in terms of ifill_addr_old,
            # the address whose data the port is returning) into a fact about the
            # word it is about to install at ifill_addr.
            invariant [held_addr] ifill_on -> ifill_addr = mem_intf.ifill_addr_old
       }
    } with mem_intf, trace, word, addr, nib, bit, icline, itag, tag, opc, icache_input, mcommit_le_now

    implementation {

    # connect the I-cache isolate's inputs (in the parent)
    # (ic's outputs -- fetch_data/fetch_valid, ifill_addr/ifill_addr_valid/ifill_busy
    #  -- are read by cpu; its inputs are driven here and in the memory-port block.)

    # ---- fetch stall on a pending FLUSH ----
    # While a FLUSH is in ID/EX/MEM, instruction fetch stalls so that no
    # instruction behind the FLUSH is fetched until the FLUSH has (in MEM) made
    # prior writes to its address visible (write-back + cache invalidation).

    wire flush_in_pipe : bool
    definition flush_in_pipe = (d_valid & d_opcode = 7)
                             | (e_valid & e_opcode = 7)
                             | (m_valid & m_opcode = 7)

    # ---- fetch and prediction ----
    # Instruction fetch goes through the two-word I-cache, which now lives in the
    # `ic` isolate. cpu drives ic's fetch address and reads back the fetched word
    # (ic.fetch_data) and a validity bit (ic.fetch_valid, which folds in the
    # I-cache hit, the mid-fill hit, and the just-arrived fill word). A fetch that
    # is not valid stalls IF (ifetch_stall).

    wire fetched : word
    definition fetched = ic.fetch_data
    wire fetched1 : word              # the odd sibling word (dual-issue lane 1)
    definition fetched1 = ic.fetch_data1

    wire f_is_branch : bool
    definition f_is_branch = ((fetched<<15:13>>:opc) = 6)

    wire f_ptaken : bool             # predicted-taken for the fetched instruction
    definition f_ptaken = f_is_branch & bp.predicted_taken

    wire f_target : addr
    definition f_target = fetched<<7:0>>

    wire pred_next_pc : addr         # the predicted next fetch address
    definition pred_next_pc = (f_target if f_ptaken else pc + 1)

    # ---- instruction-fetch fill stall ----
    # IF actually attempts a fetch when it is not held for another reason:
    wire fetch_active : bool
    definition fetch_active = ~ex_stall & ~mispredict & ~flush_in_pipe
    # Fetch cannot complete this cycle: the I-cache reports the word not (yet)
    # available (miss with no fill result ready).
    wire ifetch_stall : bool
    definition ifetch_stall = ~ic.fetch_valid

    # ---- MEM-stage D-cache access (for the address m_addr) ----

    wire m_index : nib
    definition m_index = m_addr<<3:0>>
    wire m_hi : nib                    # hi_addr of the accessed address
    definition m_hi = m_addr<<7:4>>
    wire m_line : cline                # the D-cache line at this index
    definition m_line = dcache(m_index)
    wire m_line_full : bool
    definition m_line_full = (m_line<<21:21>>:bit) = 1
    wire m_line_dirty : bool
    definition m_line_dirty = (m_line<<20:20>>:bit) = 1
    wire m_line_hi : nib               # hi_addr currently cached in this line
    definition m_line_hi = m_line<<19:16>>
    wire m_line_data : word
    definition m_line_data = m_line<<15:0>>
    wire m_hit : bool
    definition m_hit = m_line_full & (m_line_hi = m_hi)
    wire m_victim_addr : addr          # address to write the victim back to
    definition m_victim_addr = m_line_hi :: m_index
    wire m_fill_data : word            # main-memory word for m_addr (pre-clock)
    definition m_fill_data = mem(m_addr)

    # ---- D-cache read-fill stall ----
    # Only a load miss needs a memory read (a store miss installs a dirty line
    # with no fetch; write-backs are instant). A load miss stalls MEM (and the
    # stages behind it) until the fill's busy cycle, when the value is bypassed.
    wire d_miss : bool
    definition d_miss = m_valid & (m_opcode = 4) & ~m_hit
    wire d_fill_go : bool              # D-fill for m_addr completes this cycle
    definition d_fill_go = mbusy & ~mfi & (mfa = m_addr)
    wire dmem_stall : bool
    definition dmem_stall = d_miss & ~d_fill_go

    # ---- dual-issue decision (aligned even pair, both simple, independent) ----
    # Decode both fetched words. Issue two only when the pair is aligned and safe:
    # ic.fetch_valid1 (which already implies an even PC) and both instructions are
    # "simple" (NOP/ADD/SUB/LI), and lane 1 does not depend on lane 0 (no RAW on
    # lane 0's destination, and distinct destinations). Otherwise fetch a single
    # instruction and advance the PC by one -- the split is just "fetch as two
    # singles", so no recirculation is needed. (Placed here so its dependencies --
    # dmem_stall/ifetch_stall/... -- are all in scope.)
    wire f_op0 : opc
    definition f_op0 = fetched<<15:13>>
    wire f_op1 : opc
    definition f_op1 = fetched1<<15:13>>
    wire f_rd0 : reg
    definition f_rd0 = fetched<<12:10>>
    wire f_ra1 : reg
    definition f_ra1 = fetched1<<9:7>>
    wire f_rb1 : reg
    definition f_rb1 = fetched1<<6:4>>
    wire f_rd1 : reg
    definition f_rd1 = fetched1<<12:10>>
    wire f_simple0 : bool
    definition f_simple0 = (f_op0 = 0 | f_op0 = 1 | f_op0 = 2 | f_op0 = 3)
    wire f_simple1 : bool
    definition f_simple1 = (f_op1 = 0 | f_op1 = 1 | f_op1 = 2 | f_op1 = 3)
    wire f_lane0_wr : bool            # lane 0 writes a register (ADD/SUB/LI)
    definition f_lane0_wr = (f_op0 = 1 | f_op0 = 2 | f_op0 = 3)
    wire f_indep : bool
    definition f_indep = ~f_lane0_wr
                       | ((f_rd0 ~= f_ra1) & (f_rd0 ~= f_rb1) & (f_rd0 ~= f_rd1))
    wire issue_two : bool
    definition issue_two = ~dmem_stall & ~ex_stall & ~mispredict & ~flush_in_pipe
                         & ~ifetch_stall & ic.fetch_valid1
                         & f_simple0 & f_simple1 & f_indep

    # ---- reset ----

    after init {
        pc := 0;
        d_valid := false;
        e_valid := false;
        m_valid := false;
        w_valid := false;
        d_valid1 := false;      # lane 1 starts empty (and stays empty in Step 1)
        e_valid1 := false;
        m_valid1 := false;
        w_valid1 := false;
        rf(R) := 0;
        mem(A) := init_mem(A);
        dcache(I) := 0;         # all D-cache lines empty (full bit = 0)
        mbusy := false;         # no memory fill in progress
        # (the I-cache array and fill state are reset inside the `ic` isolate)
    }

    # ---- clock edge ----

    after posedge {

        # WB: retire the WB bundle (up to two register-file writes). Lane 0 first,
        # then lane 1, so on a same-destination pair the younger (lane 1) wins;
        # issue forbids that case anyway, so the two writes are independent.
        if w_valid & (w_opcode = 1 | w_opcode = 2 | w_opcode = 3 | w_opcode = 4) {
            rf(w_rd) := w_val
        };
        if w_valid1 & (w_opcode1 = 1 | w_opcode1 = 2 | w_opcode1 = 3) {
            rf(w_rd1) := w_val1
        };

        # MEM: access the write-back D-cache. A LD/ST hits if the indexed line is
        # valid and its tag matches. A load miss is served by a two-cycle memory
        # read: while it is outstanding (dmem_stall) MEM and the stages behind it
        # hold and a bubble goes to WB; in the fill's busy cycle the value arrives
        # (bypassed as m_fill_data) and the completion below runs. Store misses and
        # write-backs are instant. All reads are via wires (pre-clock).
        w_ir := m_ir;
        w_valid := m_valid & ~dmem_stall;
        w_val := (m_res if m_opcode ~= 4 else
                 (m_line_data if m_hit else m_fill_data));
        # lane 1: simple ALU, never a load, so w_val1 is just the ALU result.
        w_ir1 := m_ir1;
        w_valid1 := m_valid1 & ~dmem_stall;
        w_val1 := m_res1;
        if ~dmem_stall & m_valid & (m_opcode = 4 | m_opcode = 5) {
            # On a miss, write the dirty victim back before reinstalling.
            if ~m_hit & m_line_full & m_line_dirty {
                mem(m_victim_addr) := m_line_data
            };
            if m_opcode = 5 {
                # ST: install a dirty line holding the stored word (full, dirty,
                # hi_addr, data). A 1-word line is fully overwritten, so a write
                # miss needs no fetch.
                dcache(m_index) := ((1:bit) :: (1:bit) :: m_hi :: m_store : cline)
            } else if ~m_hit {
                # LD miss: install a clean line with the fetched word.
                dcache(m_index) := ((1:bit) :: (0:bit) :: m_hi :: m_fill_data : cline)
            }
        };
        # FLUSH m_addr: write the D-cache line back if it is present and dirty,
        # then evict m_addr from the D-cache (full bit -> 0). The I-cache eviction
        # is done inside the `ic` isolate, driven by the flush wires connected
        # below (ic.flush_addr / ic.flush_valid).
        if ~dmem_stall & m_valid & (m_opcode = 7) {
            if m_hit & m_line_dirty {
                mem(m_addr) := m_line_data
            };
            if m_hit  { dcache(m_index) := 0 }
        };

        # EX: held while MEM stalls for a D-fill; bubbled on a data hazard;
        # otherwise executes and moves to MEM.
        if dmem_stall {
        } else if ex_stall {
            m_valid := false;
            m_valid1 := false
        } else {
            m_ir := e_ir;
            m_valid := e_valid;
            m_res := (e_a + e_b if e_opcode = 1 else
                     (e_a - e_b if e_opcode = 2 else
                     ((0:addr) :: e_target if e_opcode = 3 else 0)));
            m_addr := e_a<<7:0>>;
            m_store := e_b;
            # lane 1: simple ALU only (no memory), so m_addr1/m_store1 are unused.
            m_ir1 := e_ir1;
            m_valid1 := e_valid1;
            m_res1 := e_res1;
            m_addr1 := 0;
            m_store1 := 0
        };

        # ID -> EX and IF -> ID, unless EX or MEM is stalled (then all hold).
        if ~dmem_stall & ~ex_stall {
            if mispredict {
                # Squash the younger, wrong-path instructions and redirect.
                e_valid := false;                              # squash the ID instruction
                d_valid := false;                              # squash the current fetch
                e_valid1 := false;                             # lane 1 squashed too
                d_valid1 := false;
                pc := (e_target if e_take else e_pc + 1)       # correct next PC
            } else {
                # ID -> EX
                e_ir := d_ir;
                e_valid := d_valid;
                e_pred := d_pred;
                e_pc := d_pc;
                # lane 1 (Step 1: bubble)
                e_ir1 := d_ir1;
                e_valid1 := d_valid1;
                e_pred1 := d_pred1;
                e_pc1 := d_pc1;

                if flush_in_pipe | ifetch_stall {
                    # IF stalled behind a pending FLUSH, or waiting for an I-cache
                    # fill: insert a bubble into ID and hold the PC.
                    d_valid := false;
                    d_valid1 := false
                } else {
                    # IF -> ID: speculative fetch. On an I-cache miss the word is
                    # supplied (bypassed) from main memory in the fill's busy cycle
                    # (i_fill_go); the I-cache array itself is written by the fill
                    # controller below, not here (the sibling word of a line may be
                    # filled when fetch is not consuming it).
                    d_ir := fetched;
                    d_valid := true;
                    d_pred := f_ptaken;
                    d_pc := pc;
                    # lane 1: issue the odd sibling of the pair when safe. Both
                    # lanes of an issued pair are non-branch, so lane 1 carries no
                    # prediction. On a dual issue the PC advances by two.
                    d_ir1 := fetched1;
                    d_valid1 := issue_two;
                    d_pred1 := false;
                    d_pc1 := pc + 1;
                    pc := (pc + 2 if issue_two else pred_next_pc)
                }
            }
        };

        # ---- main-memory read-fill port (shared by the I-cache and D-cache) ----
        # Each read takes two cycles (initiate, then busy); the value is available
        # on the busy cycle as mem(mfa). The I-cache (isolate `ic`) requests reads
        # via ic.ifill_addr / ic.ifill_addr_valid and installs the result itself;
        # here we only own the port and its arbitration. Priority: finish an
        # in-progress I-fill's next (sibling) read (ic.ifill_busy) > a D load-miss
        # > start a new I-fill. So the two-read I-fill is never interrupted and at
        # most one fill is ever in flight.
        if mbusy {
            mbusy := false                     # this read completes this cycle
        } else if ic.ifill_addr_valid & ic.ifill_busy {
            mbusy := true; mfi := true; mfa := ic.ifill_addr
        } else if d_miss {
            mbusy := true; mfi := false; mfa := m_addr
        } else if ic.ifill_addr_valid {
            mbusy := true; mfi := true; mfa := ic.ifill_addr
        }
    }
    # ---- connect the I-cache isolate `ic` ----
    # These interconnect definitions are in neither a specification nor an
    # implementation section, so they are visible to RTL translation and to the
    # sub-isolate. Inputs: the fetch address (pc) and whether IF is attempting a
    # fetch; the fill-data return path from the shared memory port; and the FLUSH
    # invalidation. Outputs of ic (fetch_data/fetch_valid, ifill_addr/…) are read
    # by cpu above.
    definition ic.fetch_addr = pc
    definition ic.fetch_addr_valid = fetch_active
    definition ic.ifill_data = mem(mfa)          # value read by the port (busy cycle)
    definition ic.ifill_data_valid = mbusy & mfi # an I-read completes this cycle
    definition ic.flush_addr = m_addr
    definition ic.flush_valid = ~dmem_stall & m_valid & (m_opcode = 7)
    }
}
