#lang ivy1.8

# A standard 5-stage in-order pipeline (IF, ID, EX, MEM, WB), verified against
# an ISA reference by MODULAR STAGE DECOMPOSITION.
#
# As in the reference-tagging examples, an unpipelined reference model (the ISA)
# is recorded in a ghost `trace` of architectural states, and each pipeline
# element carries a tag into that trace. What is different here is the proof
# structure: every stage is its own isolate, and between each consecutive pair
# of stages there is a ghost "interface" isolate stating the assumptions and
# guarantees at that boundary. Each stage is then proved using only its two
# neighbouring interfaces, so the whole proof decomposes into small local pieces
# rather than one monolithic invariant.
#
# The methodology -- registers, stage isolates, interface isolates, and the
# simple/complex read-after-write hazard patterns -- is described in
# doc/projects/decomposition.md. For a pipeline this simple the decomposition is
# more machinery than the problem needs (a monolithic proof is easier); it is
# the scaffolding intended for larger designs.

# Instruction encoding (16 bits):
#
#     [15:13] opcode   [12:10] rd   [9:7] ra   [6:4] rb   [7:0] imm/target
#
#   opcode 0  NOP
#          1  ADD  rd, ra, rb     rf[rd] := rf[ra] + rf[rb]
#          2  SUB  rd, ra, rb     rf[rd] := rf[ra] - rf[rb]
#          3  LI   rd, imm        rf[rd] := zero_extend(imm8)
#          4  LD   rd, [ra]       rf[rd] := mem[ rf[ra] ]
#          5  ST   [ra], rb       mem[ rf[ra] ] := rf[rb]
#          6  BEQZ ra, target     if rf[ra] == 0 then pc := target
#          7  FLUSH [ra]          make prior writes to mem[ rf[ra] ] visible to
#                                 fetch. No architectural effect *yet* -- there is
#                                 no I-cache -- so for now it is a no-op that only
#                                 stalls the pipe (the stall is what the I-cache
#                                 will later rely on for fetch coherence).

include order   # ordered abstract types

# Word (data / instruction), address (PC / memory), and register-index types.

type word
interpret word -> bv[16]
type addr
interpret addr -> bv[8]
type reg
interpret reg -> bv[3]
type opc
interpret opc -> bv[3]

# I-cache line geometry. A cache line holds TWO words (an even/odd pair):
#   [35] full   [34:32] tag   [31:16] word1 (odd)   [15:0] word0 (even)
# Address A splits as tag = A<<7:5>> (itag), index = A<<4:1>> (nib), and
# word-select A<<0:0>> (bit). The two-word line lets a later dual-issue fetch
# read an aligned instruction pair from one line; for now only lane 0 is used.
type nib
interpret nib -> bv[4]     # 16-entry cache index
type bit
interpret bit -> bv[1]     # word-select / full flag
type icline
interpret icline -> bv[36] # a packed two-word cache line
type itag
interpret itag -> bv[3]    # line tag (high address bits)

# The clock: one exported action driven by the environment.

export action posedge

# Initial memory contents. These are immutable, uninterpreted functions (they
# are never assigned), so they represent an arbitrary-but-fixed initial memory
# image. Both the implementation (cpu) and the reference model (trace.arch)
# initialize their memories from this shared source. Sharing the source (rather
# than having the reference read the cpu's memory at init) is what lets the two
# start in the same state without a spurious interference: because posedge
# writes cpu.mem, having trace's initializer observe cpu.mem would make Ivy
# report that posedge can interfere with trace's initialization -- even though
# initialization always completes before any posedge.

function init_mem(A:addr) : word     # initial (unified) memory contents -- the program

# This is the isa model. It is a specification-only isolate that
# provides a single action `step`. It has a number of functions
# that reflect intermediate values in the instruction execution.
# These can be used as references in verifying implmentations
# compositionally. The isa model is written as a module so we can
# re-use it if needed. 

module isa_model(init_mem) = {

    # The architectural state

    var pc : addr                 # program counter
    var rf(R:reg) : word          # register file
    var mem(A:addr) : word        # unified memory (instructions AND data)
    var ddirty(A:addr) : bool     # A has been written since its last FLUSH
    var error : bool              # sticky: an instruction was fetched from a dirty address

    # Temporary variables computed during execution, but not holding state

    var fetched : word

    # ---- decode of the X-stage instruction (combinational) ----

    var opcode : opc
    var rd : reg
    var ra : reg
    var rb : reg
    var target : addr            # low 8 bits: branch target or immediate

    # ---- operand fetch (combinational) ----

    var a_val : word
    var b_val : word
    var mem_addr : addr          # address for LD/ST: low 8 bits of rf[ra]

    # ---- destination register write value (combinational) ----
    # The value a register-writing instruction (ADD/SUB/LI/LD) writes to rf[rd].
    # Making it an explicit ISA intermediate lets the pipeline's result-tracking
    # invariants read `st(tag).res` instead of re-deriving a per-opcode case split.

    var res : word

    # ---- branch decision (BEQZ) ----

    var take_branch : bool

    # ---- reset ----

    after init {
        pc := 0;
        rf(R) := 0;            # zero the register file
        mem(A) := init_mem(A);
        ddirty(A) := false;    # nothing has been written yet
        error := false;
    }

    # Compute the temporary variables

    action prepare = {
        fetched := mem(pc);    # instructions are fetched from the unified memory

        # ---- decode of the X-stage instruction (combinational) ----

        opcode := fetched<<15:13>>;
        rd := fetched<<12:10>>;
        ra := fetched<<9:7>>;
        rb := fetched<<6:4>>;
        target := fetched<<7:0>>;     # low 8 bits: branch target or immediate

        # ---- operand fetch ----

        a_val := rf(ra);
        b_val := rf(rb);
        mem_addr  := a_val<<7:0>>;    # address for LD/ST: low 8 bits of rf[ra]

        # ---- destination register write value ----

        res := (a_val + b_val if opcode = 1 else            # ADD
               (a_val - b_val if opcode = 2 else            # SUB
               ((0:addr) :: target if opcode = 3 else       # LI
               (mem(mem_addr) if opcode = 4 else 0))));     # LD

        # ---- branch decision (BEQZ) ----

        take_branch := (opcode = 6) & (a_val = 0);
    }

    # Update the architectural state

    action step = {

        # Fetch coherence: executing an instruction at an address written since
        # its last FLUSH reads a stale instruction. The ISA records this by
        # entering a sticky error state (never cleared once set). This runs
        # before any store below, and pc/ddirty are untouched, so it reads the
        # pre-state dirty bit at the pre-state pc, as intended.
        if ddirty(pc) {
            error := true;
        }

        # Execute / write back
        if opcode = 1 {                          # ADD
            rf(rd) := a_val + b_val
        } else if opcode = 2 {                   # SUB
            rf(rd) := a_val - b_val
        } else if opcode = 3 {                   # LI
            rf(rd) := (0:addr) :: target
        } else if opcode = 4 {                   # LD
            rf(rd) := mem(mem_addr)
        } else if opcode = 5 {                   # ST
            mem(mem_addr) := b_val;
            ddirty(mem_addr) := true;            # the written line is now dirty
        } else if opcode = 7 {                   # FLUSH
            ddirty(mem_addr) := false;           # writes to this line are now visible
        }

        # Advance the PC
        if take_branch {
            pc := target;          # redirect to the branch target
        } else {
            pc := pc + 1;
        }
    }
}

# The 'trace' is a reference model that stores the sequence of isa
# states resulting from program execution. It is a specification-only
# isolate. The trace model is a bit of boilerplate we need to write to
# help with specificaiton and verification. Probably this can be
# generated from the isa model using AI. 

isolate trace = {

    specification {
        
        # This is the isa model

        instance arch : isa_model(init_mem)

        # This is the index type of the instruction sequence
        instance tag : unbounded_sequence

        # The value type of the instruction sequence

        type state_t = struct {

            # The architectural state

            pc : addr,                 # program counter
            rf(R:reg) : word,          # register file
            mem(A:addr) : word,        # unified memory (instructions AND data)
            ddirty(A:addr) : bool,     # per-address dirty bit
            error : bool,              # sticky fetch-coherence error

            # The intermediate values

            fetched : word, 
            opcode : opc,
            rd : reg,
            ra : reg,
            rb : reg,
            target : addr,            # low 8 bits: branch target or immediate
            a_val : word,
            b_val : word,
            mem_addr  : addr,          # address for LD/ST: low 8 bits of rf[ra]
            res : word,                # destination register write value
            take_branch : bool
        }
            
        var now : tag   # the current length of the trace
        var st(T:tag) : state_t 

        # This internal procedure captures the current arch state 

        action current returns(res:state_t) = {
            res.pc := arch.pc;
            res.rf(R:reg) := arch.rf(R:reg);
            res.mem(A:addr) := arch.mem(A:addr);
            res.ddirty(A:addr) := arch.ddirty(A:addr);
            res.error := arch.error;

            # The intermediate values

            res.fetched := arch.fetched;
            res.opcode := arch.opcode;
            res.rd := arch.rd;
            res.ra := arch.ra;
            res.rb := arch.rb;
            res.target := arch.target;
            res.a_val := arch.a_val;
            res.b_val := arch.b_val;
            res.mem_addr  := arch.mem_addr ;
            res.res := arch.res;
            res.take_branch := arch.take_branch;
        }

        # Initalization computes the temporary variable values in the initial ISA state
        # and records this state in the trace. 
        
        after init {
            now := 0;
            arch.prepare;
            st(now) := current;
        }
        
        # This externally called procedure steps the isa and records
        # the new state. Notice that tag is an abstract sequence type that
        # defines only zero and next, so we write `now.next` instead
        # of `now + 1`. After stepping we compute the temporary
        # variables in the new state, before adding it to the trace.
        # In this way the values of the temporary variables in every trace
        # entry correspond correctly to the architectural state variables.
        
        action step = {
            arch.step;
            arch.prepare;
            now := now.next;
            st(now) := current;
        }

        invariant st(now).pc = arch.pc
        invariant st(now).rf(R:reg) = arch.rf(R:reg)
        invariant st(now).mem(A:addr) = arch.mem(A:addr)
        invariant st(now).ddirty(A:addr) = arch.ddirty(A:addr)
        invariant st(now).error = arch.error

        # The intermediate values
        
        invariant st(now).fetched = arch.fetched
        invariant st(now).opcode = arch.opcode
        invariant st(now).rd = arch.rd
        invariant st(now).ra = arch.ra
        invariant st(now).rb = arch.rb
        invariant st(now).target = arch.target
        invariant st(now).a_val = arch.a_val
        invariant st(now).b_val = arch.b_val
        invariant st(now).mem_addr  = arch.mem_addr
        invariant st(now).res = arch.res
        invariant st(now).take_branch = arch.take_branch

        # The invariants above only pin the *most recent* recorded state,
        # st(now). But the pipeline implementation compares a lagging stage
        # against an *earlier* trace entry (st(now-1)). So we must also specify
        # that every recorded entry is a faithful ISA state, and that
        # consecutive entries are related by one ISA step. This is the "trace
        # is a valid execution history" boilerplate.

        # (a) Every recorded state's intermediate values are the correct decode
        #     of its own architectural state. (For st(now) this follows from the
        #     invariants above and arch's definitions; here we extend it to all
        #     recorded entries, which never change once written.)

        invariant T <= now -> st(T).fetched = st(T).mem(st(T).pc)
        invariant T <= now -> st(T).opcode = (st(T).fetched)<<15:13>>
        invariant T <= now -> st(T).rd = (st(T).fetched)<<12:10>>
        invariant T <= now -> st(T).ra = (st(T).fetched)<<9:7>>
        invariant T <= now -> st(T).rb = (st(T).fetched)<<6:4>>
        invariant T <= now -> st(T).target = (st(T).fetched)<<7:0>>
        invariant T <= now -> st(T).a_val = st(T).rf(st(T).ra)
        invariant T <= now -> st(T).b_val = st(T).rf(st(T).rb)
        invariant T <= now -> st(T).mem_addr = (st(T).a_val)<<7:0>>
        invariant T <= now -> st(T).res = (st(T).a_val + st(T).b_val if st(T).opcode = 1 else
                                          (st(T).a_val - st(T).b_val if st(T).opcode = 2 else
                                          ((0:addr) :: st(T).target if st(T).opcode = 3 else
                                          (st(T).mem(st(T).mem_addr) if st(T).opcode = 4 else 0))))
        invariant T <= now -> st(T).take_branch = ((st(T).opcode = 6) & (st(T).a_val = 0))

        # (b) Consecutive recorded states are related by one step of the ISA.
        #     If st(T) precedes st(U) (U = T+1, U <= now), then st(U) is the
        #     result of executing st(T)'s instruction. This mirrors arch.step.

        # error is sticky, and is set when st(T)'s instruction is fetched from a
        # dirty address (ddirty(pc) in st(T)).
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).error = (st(T).error | st(T).ddirty(st(T).pc))
        # ddirty(A): set by a ST to A, cleared by a FLUSH of A, else unchanged.
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).ddirty(A) =
                          (true if (st(T).opcode = 5 & A = st(T).mem_addr) else
                           (false if (st(T).opcode = 7 & A = st(T).mem_addr) else
                            st(T).ddirty(A)))
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).pc = (st(T).target if st(T).take_branch else st(T).pc + 1)
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).mem(A) = (st(T).b_val if (st(T).opcode = 5 & A = st(T).mem_addr)
                                      else st(T).mem(A))
        invariant (tag.succ(T,U) & U <= now) ->
                      st(U).rf(R) = (st(T).res
                                     if ((st(T).opcode = 1 | st(T).opcode = 2 |
                                          st(T).opcode = 3 | st(T).opcode = 4)
                                         & R = st(T).rd)
                                     else st(T).rf(R))

        # Once we fetch a dirty address, we remain in error state
        invariant T < now & st(T).ddirty(st(T).pc) -> st(now).error
    }
}  with addr,opc

# ============================================================================
# A standard 5-stage pipeline: IF, ID, EX, MEM, WB.
#
#   IF  : fetch mem(pc)
#   ID  : latch the instruction (decode is combinational, via wires)
#   EX  : read operands from rf, do the ALU op / branch decision / addr calc
#   MEM : data-memory access (LD reads, ST writes)
#   WB  : write the result to rf
#
# Operands are read in EX and results written in WB (no forwarding of the ALU
# result yet), so a RAW dependency on an instruction still in MEM or WB is a
# data hazard; we detect it and STALL the EX stage until the producer retires.
#
# The operand of a branch is likewise read in EX, so a branch resolves in EX.
# To keep the trace (which records instructions at issue, in program order)
# free of wrong-path instructions, we do NOT speculate: fetch stalls while a
# branch is unresolved (in ID or EX), and the PC is redirected from EX. (A
# branch predictor will replace this later.)
#
# Following the decomposition methodology (doc/projects/decomposition.md), the
# model is split into per-stage isolates -- if_stage, id_stage, ex_stage,
# mem_stage, wb_stage -- with a ghost interface isolate -- if_id, id_ex, ex_mem,
# mem_wb -- at each boundary. The architectural register file lives in wb_stage
# and the two EX operand reads are forwarded from ex_stage down to wb_stage (the
# SIMPLE read-after-write hazard pattern). The pc lives in if_stage and a branch
# redirect is forwarded from ex_stage (the COMPLEX hazard pattern, since the pc
# is written in two stages -- incremented in IF, redirected in EX).
# ============================================================================

isolate cpu = {

    specification {

        # ---- CPU ghost state ----------------------------------------------
        # Here, we advance the trace when the CPU issues a real (correct-path)
        # instruction. With branch prediction we fetch speculatively, so a fetch
        # is NOT always a real instruction: while fetch is on a mispredicted
        # path (spec_wrong) the fetched word is wrong-path and the trace must
        # not step for it.
        #
        # spec_wrong holds exactly when a MISPREDICTED branch is unresolved in
        # ID/EX (pc_reserved) or in IF/ID (a valid instruction whose carried
        # prediction d_pred disagrees with the true outcome). This is the
        # antecedent of pc_track: while it holds, pc is speculative.
        wire spec_wrong : bool
        definition spec_wrong = if_id.pc_reserved
                              | (if_stage.d_valid & (if_stage.d_pred ~= trace.st(if_id.commit).take_branch))

        # The per-stage tag advances live in the stage specs; here we only
        # advance the trace (issue a new instruction) on a correct-path fetch --
        # and not while fetch is stalled behind a draining FLUSH or an I-cache
        # miss (~ic.fetch_valid), when no instruction is issued.
        after posedge {
            if ~ex_stall {
                if ~spec_wrong & ~flush_in_pipe & ic.fetch_valid { trace.step }
            }
        }
    }

    # ---- decode / control wires ----
    # ex_stall reads the stage objects' outputs, so it is DEFINED below, after
    # the stage objects.

    wire ex_stall : bool            # data hazard (computed in ex_stage; aliased here)
    wire flush_in_pipe : bool       # a FLUSH is in flight (IF/ID..EX/MEM) -> stall fetch

    # ---- fetch stage (IF) --------------------------------------------------
    # The fetch stage owns the program counter, the instruction memory, and the
    # IF/ID pipe register (d_ir/d_valid) -- its registered output. On the clock
    # edge it advances/redirects the PC and latches the fetched word into the
    # pipe register (or a bubble). Because the output is a register (not a
    # combinational wire), downstream stages read it as ordinary pre-edge state
    # (`old if_stage.d_ir`), and its trace-tracking invariant is a plain state
    # invariant that a later isolate can assume directly.
    #
    #   inputs :  ex_stall, pc_ex_we, pc_ex_wval
    #   outputs:  the IF/ID pipe register d_ir/d_valid (state), read directly by
    #             cpu; pc/commit are read by if_stage's own invariants.

    # Implementation of the IF stage logic
    #
    # We put the stage implementations in isolates inside implementation sections.
    # This means that, by default, these implementations are not visible to other
    # isolalates unless we explicitly reference them in a 'when' clause. 

    implementation {
        isolate if_stage = {
            # ---- state ----
            register pc : addr                   # program counter
            register d_ir : word                 # IF/ID pipe register (registered output)
            register d_valid : bool
            register d_pred : bool               #   predicted-taken bit carried with the instruction
            register d_pc : addr                 #   the instruction's own PC

            # ---- interface wires ----
            wire ex_stall : bool            # input:  EX is stalled -> freeze fetch
            wire flush_in_pipe : bool       # input:  a FLUSH is draining -> stall fetch (bubble)
            wire pc_ex_we : bool            # input:  EX repairs the pc this cycle (misprediction)
            wire pc_ex_wval : addr          # input:  the value EX writes to the pc (corrected next pc)
            wire predicted_taken : bool     # input:  the predictor's guess for the fetch PC
            wire fetch_data : word          # input:  the instruction word from the I-cache at pc
            wire fetch_valid : bool         # input:  the I-cache hit this cycle (else a fill is pending)

            # ---- fetch output (combinational, internal) ----
            wire fetched : word

            # ---- implementation (hidden from other stages) ----

            # Instructions are fetched from the I-cache (ic), which is filled from
            # the unified memory in mem_stage. On a miss (~fetch_valid) IF stalls
            # while the cache fills, exactly as it stalls for a draining FLUSH.
            definition fetched = fetch_data
            wire ifetch_stall : bool
            definition ifetch_stall = ~fetch_valid

            # ---- prediction of the instruction being fetched ----
            wire f_is_branch : bool
            definition f_is_branch = ((fetched<<15:13>>:opc) = 6)
            wire f_ptaken : bool             # predicted-taken for the fetched instruction
            definition f_ptaken = f_is_branch & predicted_taken
            wire f_target : addr
            definition f_target = fetched<<7:0>>
            wire pred_next_pc : addr         # the predicted next fetch address
            definition pred_next_pc = (f_target if f_ptaken else pc + 1)

            after init {
                pc := 0;
                d_valid := false;
                d_pred := false
            }

            after posedge {
                if ~ex_stall {
                    if flush_in_pipe | ifetch_stall {
                        # A FLUSH is draining, or the I-cache missed: stall fetch.
                        # Hold the PC and send a bubble into IF/ID (a plain stall,
                        # not shadowed).
                        d_valid := false
                    } else {
                        # IF -> ID: speculatively fetch the next word and advance the
                        # PC to the PREDICTED next address (we never stall for a
                        # branch). Carry the prediction and this instruction's own PC
                        # down the pipe so EX can repair a misprediction.
                        d_ir := fetched;
                        d_valid := true;
                        d_pred := f_ptaken;
                        d_pc := pc;
                        pc := pred_next_pc           # predicted next fetch address
                    }
                };
                # Forwarded "late" pc write: a mispredicted branch in EX. Redirect
                # the pc to the corrected next address and flush the wrong-path
                # word just fetched into IF/ID. pc_ex_we already implies ~ex_stall,
                # so it overrides the predicted fetch above.
                if pc_ex_we {
                    pc := pc_ex_wval;
                    d_valid := false             # flush the mispredicted fetch
                }
            }
            specification {
                # ---- tag chain at the ID boundary ----
                # Only a NON-shadowed valid instruction in IF/ID is a real,
                # issued-but-not-yet-passed instruction; a shadowed (wrong-path)
                # one is not counted, so the boundary tag equals trace.now.
                invariant (if_stage.d_valid & ~if_id.pc_reserved)  & ~trace.st(trace.now).error -> if_id.commit.succ(trace.now)
                invariant (~if_stage.d_valid | if_id.pc_reserved)  & ~trace.st(trace.now).error -> if_id.commit = trace.now

                # ----- architectural state tracking -----
                # (Guarded by ~error: once the ISA has fetched stale code, the
                # implementation is no longer required to track it.)
                invariant [pc_track] (~trace.st(trace.now).error &
                                      ~(if_id.pc_reserved | (d_valid & (d_pred ~= trace.st(if_id.commit).take_branch))))
                                     -> pc = trace.st(trace.now).pc
            }
        } with cpu, trace, word, addr, reg, opc, if_id
    }
        
    # Specification of the IF/ID stage interface
    #
    # Note: this specification is in a "private" section so that it is used
    # only by specific request, and not by all isolates that use 'cpu'.
    
    private  {
        isolate if_id = {

            specification {

                # ---- reference tag for the IF/ID boundary (ghost) ----
                # commit counts how many instructions have passed the ID boundary.
                # The instruction in the IF/ID pipe register (if valid) is the next
                # to pass, so its trace tag is commit; trace.now (the number issued)
                # equals commit when the register is empty, or commit + 1 when it
                # holds a valid instruction.
                var commit : trace.tag
                var pc_reserved : bool # pc is shadowed by instruction in later stage
                wire pc_writes_done : bool    # true if last downstream pc write finished

                after init {
                    commit := 0;
                    pc_reserved := false;    
                }

                # When ID advances (EX not stalled) and the pipe register held a
                # valid instruction, that instruction passes the ID boundary.
                # The pc tag advances if the fetch doesn't stall and if the instruction
                # isn't a a taken branch, or if it is a taken branch and the instruction is in the
                # a EX stage. However, nothing happens on an EX stall. 

                after posedge {
                    if ~ex_stall {
                        # A shadowed IF/ID instruction (pre-edge pc_reserved) is
                        # on the wrong path: it does not pass the ID boundary, so
                        # neither commit nor the shadow flag advances for it. We
                        # test the PRE-edge shadow value because pc_writes_done
                        # clears pc_reserved on this same edge.
                        if old if_stage.d_valid & ~(old pc_reserved) {
                            # A MISPREDICTED instruction passing the ID boundary
                            # (its carried prediction disagrees with the true
                            # outcome) shadows the wrong-path followers behind it.
                            if (old if_stage.d_pred) ~= trace.st(commit).take_branch {
                                pc_reserved := true;
                            }
                            commit := commit.next;
                        };
                        # When the mispredicted branch resolves in EX, un-shadow.
                        if pc_writes_done {
                            pc_reserved := false;
                        }
                    }
                }
            }

            # These invariants are guarantees of the IF stage at the IF/ID boundary
            
            isolate if_props = {

                specification {

                    after posedge {}   # boilerplate to make the follow be invariants of posedge

                    invariant [commit_bound] ~trace.st(trace.now).error -> commit <= trace.now

                    # ---- the IF/ID pipe register tracks the trace ----
                    # Only a non-shadowed instruction matches the trace; a
                    # shadowed one holds a wrong-path word. The instruction WORD
                    # additionally requires ~error and that this instruction's own
                    # fetch address is not dirty (a dirty fetch reads a stale word,
                    # which drives the ISA to error at this instruction's step).
                    invariant (if_stage.d_valid & ~pc_reserved & ~trace.st(trace.now).error
                               )
                                  -> if_stage.d_ir = trace.st(commit).fetched
                    invariant (if_stage.d_valid & ~pc_reserved & ~trace.st(trace.now).error)
                                  -> if_stage.d_pc = trace.st(commit).pc

                    # A valid instruction is predicted taken only if it is a
                    # branch: d_pred and d_ir are latched together from the same
                    # fetched word, and f_ptaken = f_is_branch & predicted. For an
                    # invalid slot the carried prediction is irrelevant. (The
                    # ID/EX twin e_pred_branch inducts from this.)
                    invariant [d_pred_branch] (if_stage.d_valid & if_stage.d_pred) -> (if_stage.d_ir<<15:13>>:opc = 6)
                }
            } with cpu, trace, word, addr, reg, opc, if_id, if_stage

            # These invariants are guarantees of the ID stage at the IF/ID boundary
            
            isolate id_props = {

                specification {
                    invariant [pc_we_track] (~trace.st(trace.now).error
                                             )
                                            -> (ex_stage.pc_ex_we -> pc_reserved)
                        with id_ex.ex_props.pc_we_track, id_ex.ex_props.pc_wval_track, if_props.commit_bound
                    invariant [pc_wval_track] (~trace.st(trace.now).error
                                              )
                                            -> (pc_writes_done -> ex_stage.pc_ex_we & ex_stage.pc_ex_wval = trace.st(commit).pc)
                        with id_ex.ex_props.pc_we_track, id_ex.ex_props.pc_wval_track, if_props.commit_bound

                    # ---- fetch data forwarded to the IF/ID boundary ----
                    # Same one-step forward as at id_ex, now across the ID/EX
                    # instruction. This is the version if_stage consumes to prove
                    # d_ir at the fetch edge. (Zero-delay on the id_ex forward and
                    # the ID/EX tag chain.)
                    invariant [fetch_track] (~trace.st(trace.now).error & ~trace.st(commit).ddirty(if_stage.pc) & ~ex_stall & ~flush_in_pipe & ic.fetch_valid) ->
                        ic.fetch_data = trace.st(commit).mem(if_stage.pc)
                    with id_ex.ex_props.fetch_track, id_stage.e_tag_lo, id_stage.e_tag_eq, if_props.commit_bound
                }
            } with cpu, trace, word, addr, reg, opc, if_id, id_stage, id_ex
            
        }
    }

    # ---- decode stage (ID) -------------------------------------------------
    # The decode stage owns the ID/EX pipe register (e_ir/e_valid) -- its
    # registered output -- and the EX-boundary tag commit. On the clock edge it
    # latches the instruction from if_stage's IF/ID pipe register (read pre-edge
    # with `old`) into its own register, unless EX is stalled. As with if_stage,
    # the output is a register, so cpu reads it as pre-edge state and its
    # trace-tracking invariant is a plain state invariant.
    #
    #   inputs :  ex_stall; the IF/ID pipe register if_stage.d_ir/d_valid
    #   outputs:  the ID/EX pipe register e_ir/e_valid (state), read directly by
    #             cpu; commit is read by id_stage's own invariants.

    implementation {
        isolate id_stage = {


            # ---- state ----
            register e_ir : word                 # ID/EX pipe register (registered output)
            register e_valid : bool
            register e_pred : bool               #   carried prediction (from d_pred)
            register e_pc : addr                 #   the instruction's own PC (from d_pc)

            # ---- interface wires ----
            wire ex_stall : bool            # input:  EX is stalled -> hold the register
            wire pc_ex_we : bool            # input:  misprediction resolving in EX -> squash

            # ---- implementation (hidden from other stages) ----

            after init {
                e_valid := false;
                e_pred := false
            }

            after posedge {
                # ID -> EX: latch the instruction from if_stage's IF/ID pipe
                # register into this stage's ID/EX pipe register, unless EX is
                # stalled (then hold). The input register lives in if_stage and is
                # updated by its own edge this cycle, so read pre-edge with `old`.
                # On a misprediction (pc_ex_we) the instruction moving in behind
                # the branch is on the wrong path, so squash it instead of
                # latching it.
                if ~ex_stall {
                    if pc_ex_we {
                        e_valid := false
                    } else {
                        e_ir := old if_stage.d_ir;
                        e_valid := old if_stage.d_valid;
                        e_pred := old if_stage.d_pred;
                        e_pc := old if_stage.d_pc
                    }
                }
            }

            specification {
                # ---- tag chain: the ID/EX register sits between the if_id and
                #      id_ex boundaries, so this stage relates their tags ----
                invariant [e_tag_lo] e_valid & ~trace.st(trace.now).error -> id_ex.commit.succ(if_id.commit)
                with if_id.if_props.commit_bound
                invariant [e_tag_eq] ~e_valid & ~trace.st(trace.now).error -> if_id.commit = id_ex.commit
                with if_id.if_props.commit_bound

                definition if_id.pc_writes_done = e_valid & (e_pred ~= trace.st(id_ex.commit).take_branch) & ~ex_stall

                invariant [pc_res] (~trace.st(trace.now).error ) ->
                                    (if_id.pc_reserved <-> e_valid & (e_pred ~= trace.st(id_ex.commit).take_branch))
                with if_id.if_props.commit_bound

            }
        } with cpu, trace, word, addr, reg, opc, if_id, id_ex
    }

    # Specification of the ID/EX stage interface

    private {
        isolate id_ex = {
            specification {

                # ---- reference tag for the ID/EX boundary (ghost) ----
                # commit counts how many instructions have passed the EX boundary.
                # The instruction in the ID/EX pipe register (if valid) is the next
                # to pass, so its trace tag is commit; the ID-boundary tag
                # if_id.commit equals commit when the register is empty, or
                # commit + 1 when it holds a valid instruction.

                var commit : trace.tag

                after init {
                    commit := 0;
                }

                # When EX advances (not stalled) and the register held a valid
                # instruction, that instruction passes the EX boundary.
                after posedge {
                    if ~ex_stall  {
                        if old id_stage.e_valid { commit := commit.next }
                    }
                }

                # Guarantees of the ID stage at ID/EX boundary

                isolate id_props = {
                    # (The tag-chain invariants relating if_id.commit and this
                    # boundary's commit live in id_stage, which sits between them.)
                    invariant [commit_bound]  ~trace.st(trace.now).error -> commit <= trace.now

                    # ---- the ID/EX pipe register tracks the trace ----
                    invariant [e_ir_track] (id_stage.e_valid & ~trace.st(trace.now).error
                                            )
                                               -> id_stage.e_ir = trace.st(commit).fetched
                    invariant [e_pc_track] (id_stage.e_valid & ~trace.st(trace.now).error)
                                               -> id_stage.e_pc = trace.st(commit).pc

                    # A valid instruction is predicted taken only if it is a
                    # branch (f_ptaken = f_is_branch & predicted). A valid ID/EX
                    # instruction is never shadowed, so this keeps the mispredict
                    # test e_pred ~= take_branch from firing spuriously on a
                    # non-branch. Inducts from the IF-level twin.
                    invariant [e_pred_branch] (id_stage.e_valid & id_stage.e_pred) -> (id_stage.e_ir<<15:13>>:opc = 6)

                } with cpu, trace, word, addr, reg, opc, if_id, id_ex, id_stage


                # Guarantees of the EX stage at ID/EX boundary

                isolate ex_props = {
                    # This is the incoming interface of the late (EX) pc-write
                    # stage, so its guarantees are the doc's r_z_we / r_z_wval for
                    # r = pc. The write enable pc_ex_we (gated on ~ex_stall) now
                    # holds iff a valid, non-stalled MISPREDICTED branch is in EX
                    # (its carried prediction disagrees with the true outcome);
                    # the written value is the CORRECTED next pc -- the target if
                    # actually taken, else the branch's own PC + 1 (fall-through).
                    invariant [pc_we_track] (~trace.st(trace.now).error) ->
                        (ex_stage.pc_ex_we <-> id_stage.e_valid & ~ex_stall & (id_stage.e_pred ~= trace.st(commit).take_branch))
                    with id_props.e_ir_track, id_props.e_pred_branch, id_props.commit_bound, ex_mem.mem_props.a_track
                    invariant [pc_wval_track] (ex_stage.pc_ex_we & ~trace.st(trace.now).error) ->
                        ex_stage.pc_ex_wval = (trace.st(commit).target if trace.st(commit).take_branch else trace.st(commit).pc + 1)
                    with id_props.e_ir_track, id_props.e_pc_track, id_props.commit_bound, ex_mem.mem_props.a_track

                    # ---- fetch data forwarded to the ID/EX boundary ----
                    # mem(if_stage.pc) is unchanged from ex_mem.commit to id_ex.commit
                    # unless the EX/MEM instruction stores if_stage.pc -- which sets
                    # ddirty(if_stage.pc) at id_ex.commit, so the ~ddirty guard excludes
                    # it. While a FLUSH drains (flush_in_pipe) a store may not yet have
                    # reached mem, so we do not claim coherence then. (Zero-delay on the
                    # ex_mem base and the EX/MEM tag chain.)
                    invariant [fetch_track] (~trace.st(trace.now).error & ~trace.st(commit).ddirty(if_stage.pc) & ~ex_stall & ~flush_in_pipe & ic.fetch_valid) ->
                        ic.fetch_data = trace.st(commit).mem(if_stage.pc)
                    with mem_ic.ic_props.icache_output, ex_stage.m_tag_lo, ex_stage.m_tag_eq, id_props.commit_bound
                } with cpu, trace, word, addr, reg, opc, id_ex, ex_mem, ex_stage, mem_ic
            }
        }
    }

    # ---- execute stage (EX) ------------------------------------------------
    # The execute stage owns the EX/MEM pipe register (m_ir/m_valid/m_res/
    # m_addr/m_store) -- its registered output -- the register file, and the
    # MEM-boundary tag commit. Combinationally it decodes the instruction in
    # id_stage's ID/EX pipe register, reads its operands from the register file,
    # computes the branch decision and the data hazard, and (for MEM) exposes the
    # opcode of its own register. On the clock edge it writes back the retiring
    # WB result into the register file and latches the ALU result into the EX/MEM
    # register (or a bubble when stalled). As a registered output, the EX/MEM
    # register's trace-tracking invariants are plain state invariants.
    #
    #   inputs :  wb_we/wb_rd/wb_val (WB writeback); the ID/EX pipe register
    #             id_stage.e_ir/e_valid
    #   outputs:  the EX/MEM pipe register m_* (state, read pre-edge by cpu);
    #             e_opcode/pc_ex_wval/pc_ex_we (to control / IF), m_opcode (to MEM),
    #             ex_stall (to IF/ID/cpu)

    implementation {
        isolate ex_stage = {

            # ---- state ----
            register m_ir : word                 # EX/MEM pipe register (registered output)
            register m_valid : bool
            register m_res : word                #   ALU/LI result
            register m_addr : addr               #   memory address (LD/ST)
            register m_store : word              #   store data (ST)

            # ---- interface wires ----
            wire wb_we  : bool              # input:  WB write enable
            wire wb_rd  : reg               # input:  WB write index
            wire wb_val : word              # input:  WB write value
            wire mem_stall : bool           # input:  stall signal from M stage
            wire e_pred : bool              # input:  carried prediction (id_stage.e_pred)
            wire e_pc : addr                # input:  the EX instruction's own PC (id_stage.e_pc)
            wire e_opcode : opc             # output: opcode of the instruction in EX
            wire e_take : bool              # output: the true (operand-based) branch decision
            wire pc_ex_wval : addr          # output: corrected next pc on a misprediction
            wire pc_ex_we : bool            # output: EX repairs the pc this cycle (misprediction, gated on ~ex_stall)
            wire m_opcode : opc             # output: opcode of the instruction in MEM
            wire ex_stall : bool            # output: data hazard -> stall EX

            # ---- implementation (hidden from other stages) ----

            # ---- EX decode (of id_stage's ID/EX pipe register) ----
            wire e_ra : reg
            wire e_rb : reg
            wire e_target : addr
            definition e_opcode  = id_stage.e_ir<<15:13>>
            definition e_ra      = id_stage.e_ir<<9:7>>
            definition e_rb      = id_stage.e_ir<<6:4>>
            definition e_target  = id_stage.e_ir<<7:0>>     # low-8 field: branch target / LI immediate

            # ---- EX operands (read from the register file) ----
            wire e_a : word
            wire e_b : word

            # ---- branch resolution and pc repair, resolved in EX ----
            # e_take is the true branch decision; pc_ex_we fires only on a
            # MISPREDICTION (the carried prediction disagrees with e_take), and
            # then pc_ex_wval is the corrected next pc: the target if actually
            # taken, else the fall-through (this instruction's PC + 1). pc_ex_we
            # is gated on ~ex_stall so it means "EX repairs the pc this cycle".
            definition e_take = (e_opcode = 6) & (e_a = 0)
            definition pc_ex_we = ~ex_stall & id_stage.e_valid & (e_opcode = 6) & (e_pred ~= e_take)
            definition pc_ex_wval = (e_target if e_take else e_pc + 1)

            # ---- MEM decode (of this stage's own EX/MEM pipe register) ----
            wire m_rd : reg
            definition m_opcode = m_ir<<15:13>>
            definition m_rd     = m_ir<<12:10>>

            # ---- data-hazard detection: stall EX if a source register of the EX
            #      instruction matches the destination of a register writer still
            #      in MEM (local) or WB (via the writeback port wb_we/wb_rd) ----
            definition ex_stall = id_stage.e_valid & (
                 (m_valid & (m_opcode = 1 | m_opcode = 2 | m_opcode = 3 | m_opcode = 4)
                          & (m_rd = e_ra | m_rd = e_rb)) | mem_stall)


            after init {
                m_valid := false;
            }

            after posedge {
                # EX -> MEM: if EX is stalled, bubble; else compute the ALU result
                # / address / store data and latch into the EX/MEM pipe register.
                # The instruction word comes from id_stage's ID/EX pipe register,
                # read pre-edge with `old`.
                if ex_stall {
                    m_valid := false
                } else {
                    m_ir := old id_stage.e_ir;
                    m_valid := old id_stage.e_valid;
                    m_res := (e_a + e_b if e_opcode = 1 else
                             (e_a - e_b if e_opcode = 2 else
                             ((0:addr) :: e_target if e_opcode = 3 else 0)));   # LI immediate
                    m_addr := e_a<<7:0>>;
                    m_store := e_b
                }
            }

            specification {
                # ---- tag chain: the EX/MEM register sits between the id_ex and
                #      ex_mem boundaries, so this stage relates their tags ----
                invariant [m_tag_lo] m_valid -> ex_mem.commit.succ(id_ex.commit)
                invariant [m_tag_eq] ~m_valid -> id_ex.commit = ex_mem.commit
            }
        }  with cpu, trace, word, addr, reg, opc, id_ex, ex_mem
    }
        
    # Specification of interface at the EX/MEM boundary

    private {
        isolate ex_mem = {

            specification {

                # ---- reference tag for the EX/MEM boundary (ghost) ----
                # commit counts how many instructions have passed the MEM boundary.
                # The instruction in the EX/MEM pipe register (if valid) is the next
                # to pass, so its trace tag is commit; the EX-boundary tag
                # id_stage.commit equals commit when the register is empty, or
                # commit + 1 when it holds a valid instruction.
                var commit : trace.tag

                after init {
                    commit := 0
                }

                # The EX/MEM register always advances (it is downstream of the stall
                # point), so whenever it held a valid instruction that instruction
                # passes the MEM boundary.
                after posedge {
                    if old ex_stage.m_valid { commit := commit.next }
                }
            }

            # Guarantees of the EX stage the EX/MEM boundary

            isolate ex_props = {
                # (The tag-chain invariants relating id_ex.commit and this
                # boundary's commit live in ex_stage, which sits between them.)
                invariant [commit_bound] ~trace.st(trace.now).error -> commit <= trace.now

                # ---- the EX/MEM pipe register tracks the trace ----
                invariant (ex_stage.m_valid & ~trace.st(trace.now).error
                           )
                              -> ex_stage.m_ir = trace.st(commit).fetched
                invariant (ex_stage.m_valid & ~trace.st(trace.now).error
                           ) -> ex_stage.m_addr = trace.st(commit).mem_addr
                invariant (ex_stage.m_valid & ~trace.st(trace.now).error
                           ) -> ex_stage.m_store = trace.st(commit).b_val
                # m_res holds the ALU / LI result (opcodes ADD, SUB, LI); for
                # those instructions that is exactly the destination write value
                # res. (A LD's result is produced in MEM as w_val, not here.)
                invariant (ex_stage.m_valid & ~trace.st(trace.now).error
                           & (trace.st(commit).opcode = 1 | trace.st(commit).opcode = 2
                                               | trace.st(commit).opcode = 3))
                              -> ex_stage.m_res = trace.st(commit).res


            }  with cpu, trace, word, addr, reg, opc, id_ex, ex_stage, ex_mem

            isolate mem_props = {
                invariant [a_track] (~mem_stage.mem_stall & ~trace.st(trace.now).error) -> wb_stage.wb_a = trace.st(commit).rf(ex_stage.e_ra)
                with mem_wb.wb_props.wb_a_track, ex_props.commit_bound
                invariant (~mem_stage.mem_stall & ~trace.st(trace.now).error) -> wb_stage.wb_b = trace.st(commit).rf(ex_stage.e_rb)
                with mem_wb.wb_props.wb_b_track, ex_props.commit_bound

                # (The fetch-data base case at the MEM boundary now lives in the
                # mem_ic interface isolate as the I-cache guarantee icache_output.)
            } with cpu, trace, word, addr, reg, opc, ex_mem, mem_stage, mem_wb

            # TODO guarantess of MEM stage at EX/MEM boundary
        }
    }

    # ---- memory stage (MEM) ------------------------------------------------
    # The memory stage owns the MEM/WB pipe register (w_ir/w_valid/w_val) -- its
    # registered output -- the data memory, and the WB-boundary tag commit. On
    # the clock edge it reads ex_stage's EX/MEM pipe register (pre-edge), accesses
    # data memory (LD reads, ST writes), and latches the writeback value into the
    # MEM/WB register. As a registered output, its trace-tracking invariants are
    # plain state invariants.
    #
    #   inputs :  the EX/MEM pipe register ex_stage.m_* (+ ex_stage.m_opcode)
    #   outputs:  the MEM/WB pipe register w_* (state, read by wb_stage);
    #             w_opcode/w_rd (to wb_stage)

    implementation {
        isolate mem_stage = {

            # interface wires
            wire ra : reg          # input: reagister read address from ex_stage
            wire rb : reg          # input: reagister read address from ex_stage
            wire mem_stall : bool  # output: stall signal to ex_stage

            # ---- state ----
            register w_ir : word                 # MEM/WB pipe register (registered output)
            register w_valid : bool
            register w_val : word                #   value to write to rf

            # ---- MEM/WB decode (of this stage's own register), exposed to wb_stage ----
            wire w_opcode : opc
            wire w_rd : reg

            # ---- implementation (hidden from other stages) ----

            wire m_opcode = ex_stage.m_ir<<15:13>> : opc
            definition w_opcode = w_ir<<15:13>>
            definition w_rd     = w_ir<<12:10>>

            after init {
                w_valid := false
            }

            wire is_reg_write = w_valid & (w_opcode = 1 | w_opcode = 2 | w_opcode = 3 | w_opcode = 4)
            definition mem_stall = is_reg_write & (ra = w_rd | rb = w_rd)

            after posedge {
                # MEM: read ex_stage's EX/MEM pipe register (pre-edge, via `old`)
                # and latch the writeback value into the MEM/WB pipe register. A LD
                # reads the (pre-edge) main memory (in main_mem); a ST is applied to
                # main memory by the main_mem isolate, driven from ex_stage.m_*.
                w_ir := old ex_stage.m_ir;
                w_valid := old ex_stage.m_valid;
                w_val := (main_mem.mem(old ex_stage.m_addr) if m_opcode = 4
                         else old ex_stage.m_res)       # LD loads; else ALU/LI result
            }

            specification {
                # ---- tag chain: the MEM/WB register sits between the ex_mem and
                #      mem_wb boundaries, so this stage relates their tags ----
                invariant w_valid -> mem_wb.commit.succ(ex_mem.commit)
                invariant ~w_valid -> ex_mem.commit = mem_wb.commit
            }
        } with cpu, trace, word, addr, reg, opc, ex_mem, mem_wb, mem_ic, main_mem
    }

    # ---- main memory (main_mem) --------------------------------------------
    # With caches in front of it, main memory is its own isolate: it owns the
    # unified RAM, the two-cycle read/fill port shared by the caches, and the
    # port arbiter. The MEM stage reads a load value through ld_data and applies
    # a committing store through the dwrite_* inputs; the I-cache drives the fill
    # port (fill_addr/fill_req) and reads the returned word on ifill_data.
    implementation {
        isolate main_mem = {
            # ---- state ----
            register mem(A:addr) : word          # unified main memory
            register mbusy : bool                # a fill read is in its busy (return) cycle
            register mfa : addr                  # the fill read address latched last cycle
            register mfi : bool                  # the busy read is for the I-cache

            # ---- interface wires ----
            wire fill_addr : addr    # input:  address a cache wants read
            wire fill_req  : bool    # input:  a cache requests a read
            wire dwrite_en : bool    # input:  a data store commits this cycle
            wire dwrite_addr : addr  # input:  the store address
            wire dwrite_data : word  # input:  the store data
            wire ifill_data : word          # output: the returned fill word (busy cycle)
            wire ifill_data_valid : bool    # output: a read completes this cycle

            definition ifill_data = mem(mfa)
            definition ifill_data_valid = mbusy & mfi

            after init {
                mem(A) := init_mem(A);
                mbusy := false;
                mfi := false
            }

            after posedge {
                # apply a committing store to main memory
                if dwrite_en {
                    mem(dwrite_addr) := dwrite_data
                };
                # fill-port arbiter: finish a busy read, else start a requested one
                if mbusy {
                    mbusy := false
                } else if fill_req {
                    mbusy := true;
                    mfi := true;
                    mfa := fill_addr
                }
            }

            specification {
                # main memory tracks the trace at the MEM boundary.
                invariant [mem_track] ~trace.st(trace.now).error -> mem(A) = trace.st(ex_mem.commit).mem(A)
                    with ex_mem.ex_props.commit_bound

                invariant [mfa_ok]ifill_data_valid -> mfa = mem_ic.ifill_addr_old
            }
        } with cpu, trace, word, addr, reg, opc, ex_mem, mem_ic
    }

    # Specification of the MEM/WB boundary

    private {
        isolate mem_wb = {
            specification {

                # ---- reference tag for the MEM/WB boundary (ghost) ----
                # commit counts how many instructions have retired (passed WB). The
                # instruction in the MEM/WB pipe register (if valid) is the next to
                # retire, so its trace tag is commit; the MEM-boundary tag
                # ex_stage.commit equals commit when the register is empty, or
                # commit + 1 when it holds a valid instruction.
                var commit : trace.tag

                after init {
                    commit := 0
                }

                after posedge {
                    if old mem_stage.w_valid { commit := commit.next }
                }
            }

            # Guarantees of the MEM stage at the MEM/WB boundary
            
            isolate mem_props = {
                # (The tag-chain invariants relating ex_mem.commit and this
                # boundary's commit live in mem_stage, which sits between them.)
                invariant [commit_bound] ~trace.st(trace.now).error -> commit <= trace.now

                # ---- the MEM/WB pipe register tracks the trace ----
                invariant (mem_stage.w_valid & ~trace.st(trace.now).error
                           )
                              -> mem_stage.w_ir = trace.st(commit).fetched
                # w_val is the destination write value for every register-writing
                # opcode (ADD, SUB, LI, LD), which is exactly res.
                invariant (mem_stage.w_valid & ~trace.st(trace.now).error &
                                                (trace.st(commit).opcode = 1 | trace.st(commit).opcode = 2
                                                | trace.st(commit).opcode = 3 | trace.st(commit).opcode = 4))
                              -> mem_stage.w_val = trace.st(commit).res

            } with cpu, trace, word, addr, reg, opc, ex_mem, mem_stage, mem_wb, main_mem, mem_ic

            isolate wb_props = {
                invariant [wb_a_track] ~trace.st(trace.now).error -> wb_stage.wb_a = trace.st(commit).rf(ex_stage.e_ra) with mem_props.commit_bound, wb_stage.rf_track
                invariant [wb_b_track] ~trace.st(trace.now).error -> wb_stage.wb_b = trace.st(commit).rf(ex_stage.e_rb) with mem_props.commit_bound, wb_stage.rf_track

            } with cpu, trace, word, addr, reg, opc, mem_wb, wb_stage

        }
    }

    # ---- instruction cache (IC) --------------------------------------------
    # The read-only instruction cache sits between fetch and the unified memory:
    # if_stage presents the pc on fetch_addr and reads the instruction word back
    # on fetch_data. STAGE A (interface skeleton): `ic` is a combinational
    # PASS-THROUGH -- it reads mem directly and always "hits" (fetch_valid =
    # true), so there are no fills and IF never stalls for fetch. This exists to
    # establish the ic/mem_ic isolate boundary and the icache_output guarantee
    # that fetch consumes. STAGE B will replace the body with the real two-word-
    # line cache, a two-cycle fill port, and FLUSH eviction, keeping mem_ic fixed.

    implementation {
        isolate ic = {
            # ---- interface wires ----
            wire fetch_addr : addr          # input:  PC being fetched
            wire fetch_addr_valid : bool    # input:  IF is attempting a fetch this cycle
            wire ifill_data : word          # input:  word returned by the memory port
            wire ifill_data_valid : bool    # input:  an I-read completes this cycle
            wire flush_addr : addr          # input:  address FLUSHed in MEM
            wire flush_valid : bool         # input:  a FLUSH executes in MEM this cycle
            wire fetch_data : word          # output: selected word at fetch_addr
            wire fetch_valid : bool         # output: fetch_data valid (hit / mid-fill / arrival)
            wire fetch_data1 : word         # output: word at the odd sibling (dual-issue lane 1)
            wire fetch_valid1 : bool        # output: fetch_data1 valid
            wire fetch_addr1 : addr         # output: the odd sibling address (fetch_addr + 1)
            wire ifill_addr : addr          # output: address ic wants read from memory
            wire ifill_addr_valid : bool    # output: ic is requesting a memory read
            wire ifill_busy : bool          # output: a fill is in progress (its port slot)

            # ---- I-cache array and fill state (real state) ----
            var icache(I:nib) : icline
            var ifill_on   : bool           # an I-fill (two words) is in progress
            var ifill_got  : bool           # the miss word has been installed; sibling pending
            var ifill_miss : addr           # the miss word's address

            # ---- combinational datapath. These definitions are visible (not in a
            # hidden `implementation` block) so the mem_ic.ic_props isolate can
            # pull in the fetch-read logic to prove icache_output. ----

                # sibling of the miss word (bit 0 toggled; parity known, so +1/-1)
                wire sib : addr
                definition sib = (ifill_miss + 1 if (ifill_miss<<0:0>>:bit) = 0 else ifill_miss - 1)

                # ---- fetch read: mux the low/high word; a hit is a completed-line
                # hit, a mid-fill (miss-word) hit, or the just-arrived fill word.
                wire f_index : nib
                definition f_index = fetch_addr<<4:1>>
                wire f_wsel : bit
                definition f_wsel = fetch_addr<<0:0>>
                wire f_iline : icline
                definition f_iline = icache(f_index)
                wire f_full_hit : bool
                definition f_full_hit = ((f_iline<<35:35>>:bit) = 1) & ((f_iline<<34:32>>:itag) = fetch_addr<<7:5>>)
                wire f_fill_hit : bool
                definition f_fill_hit = ifill_got & (fetch_addr = ifill_miss)
                wire f_arr_hit : bool
                definition f_arr_hit = f_full_hit | f_fill_hit
                wire f_cword : word
                definition f_cword = ((f_iline<<15:0>>:word) if f_wsel = 0 else (f_iline<<31:16>>:word))
                wire f_bypass : bool            # the arriving fill word is for fetch_addr
                definition f_bypass = ifill_on & ifill_data_valid & (ifill_addr = fetch_addr)
                                      & ~(flush_valid & (flush_addr = ifill_addr))

                definition fetch_valid = f_arr_hit | f_bypass
                definition fetch_data  = (f_cword if f_arr_hit else ifill_data)

                # ---- lane 1 (dual issue): the odd sibling word of the same pair.
                # Kept for a later dual-issue pipeline; our single-lane fetch does
                # not consume it yet.
                definition fetch_addr1 = fetch_addr + 1
                wire f_fill_hit1 : bool
                definition f_fill_hit1 = ifill_got & (fetch_addr1 = ifill_miss)
                wire f_arr_hit1 : bool
                definition f_arr_hit1 = f_full_hit | f_fill_hit1
                wire f_cword1 : word
                definition f_cword1 = (f_iline<<31:16>>:word)
                wire f_bypass1 : bool
                definition f_bypass1 = ifill_on & ifill_data_valid & (ifill_addr = fetch_addr1)
                                       & ~(flush_valid & (flush_addr = ifill_addr))
                definition fetch_valid1 = (f_wsel = 0) & (f_arr_hit1 | f_bypass1)
                definition fetch_data1  = (f_cword1 if f_arr_hit1 else ifill_data)

                # ---- fill request: which word to read (miss word, then sibling),
                # and whether a read is wanted.
                definition ifill_addr = (fetch_addr if ~ifill_on & ~ifill_got else (ifill_miss if ~ifill_got else sib))
                definition ifill_addr_valid = ifill_on | ifill_got | (fetch_addr_valid & ~fetch_valid)
                definition ifill_busy = ifill_on | ifill_got

                # ---- FLUSH invalidation of the addressed line (tag match) ----
                wire fl_index : nib
                definition fl_index = flush_addr<<4:1>>
                wire fl_iline : icline
                definition fl_iline = icache(fl_index)
                wire fl_ihit : bool
                definition fl_ihit = ((fl_iline<<35:35>>:bit) = 1) & ((fl_iline<<34:32>>:itag) = flush_addr<<7:5>>)

                after init {
                    icache(I) := 0;
                    ifill_on := false;
                    ifill_got := false
                }

                after posedge {
                    # Ignore the returned fill word when a FLUSH this cycle targets the
                    # very address being read: that word is stale and would violate coherence.
                    if ifill_on & ifill_data_valid & ~(flush_valid  & (fl_index = ifill_miss<<4:1>>)) {
                        if ~ifill_got {
                            # miss word: (re)allocate the line with this word, full = 0
                            if (ifill_miss<<0:0>>:bit) = 0 {
                                icache(ifill_miss<<4:1>>) :=
                                    ((0:bit) :: (ifill_miss<<7:5>>:itag) :: (0:word) :: ifill_data : icline)
                            } else {
                                icache(ifill_miss<<4:1>>) :=
                                    ((0:bit) :: (ifill_miss<<7:5>>:itag) :: ifill_data :: (0:word) : icline)
                            };
                            ifill_on := false;
                            ifill_got := true
                        } else {
                            # sibling word: fill the other slot, preserve the miss word, full = 1
                            if (sib<<0:0>>:bit) = 0 {
                                icache(sib<<4:1>>) :=
                                    ((1:bit) :: (sib<<7:5>>:itag)
                                             :: (icache(sib<<4:1>>)<<31:16>>:word) :: ifill_data : icline)
                            } else {
                                icache(sib<<4:1>>) :=
                                    ((1:bit) :: (sib<<7:5>>:itag)
                                             :: ifill_data :: (icache(sib<<4:1>>)<<15:0>>:word) : icline)
                            };
                            ifill_on := false;
                            ifill_got := false
                        }
                    } else if ~ifill_on & ifill_got {
                        ifill_on := true;
                    } else if ~ifill_busy & fetch_addr_valid & ~fetch_valid {
                        # new miss: latch the miss address and start the fill
                        ifill_on := true;
                        ifill_got := false;
                        ifill_miss := fetch_addr
                    };
                    # FLUSH: evict the whole addressed word-pair line
                    if flush_valid & fl_ihit {
                        icache(fl_index) := 0
                    };
                    # If the FLUSH targets the miss word we already installed, that
                    # cached word is now stale; drop ifill_got so it is reread.
                    if flush_valid & (flush_addr = ifill_miss) {
                        ifill_on := false;
                        ifill_got := false
                    }
                }

            specification {
                # ---- ic's INTERNAL data invariants (not seen outside ic) ----
                # packed-line accessors (proof-only)
                function il_tag(L:icline) : itag
                definition il_tag(L) = L<<34:32>>
                function il_w0(L:icline) : word
                definition il_w0(L) = L<<15:0>>
                function il_w1(L:icline) : word
                definition il_w1(L) = L<<31:16>>
                function ic_line(A:addr) : icline
                definition ic_line(A) = icache(A<<4:1>>)

                # The I-cache data invariant.
                invariant [hard] ~trace.st(trace.now).error ->
                             ((((((ic_line(A)<<35:35>>:bit) = 1) & (il_tag(ic_line(A)) = A<<7:5>>))
                                         | (ifill_got & A = ifill_miss)) & ~trace.st(ex_mem.commit).ddirty(A)) ->
                (il_w0(ic_line(A)) if (A<<0:0>>:bit) = 0 else il_w1(ic_line(A))) = trace.st(ex_mem.commit).mem(A))
                    with mem_ic.mem_props.icache_input, ex_mem.ex_props.commit_bound

                # Well-formedness of the half-filled line: while mid-fill, the line
                # at the miss word's index is NOT marked full and carries the miss
                # word's tag. The ~full part stops a FLUSH from clobbering it.
                invariant [midfill] (ifill_got) ->
                             ( ((ic_line(ifill_miss)<<35:35>>:bit) = 0)
                             & (il_tag(ic_line(ifill_miss)) = ifill_miss<<7:5>>) )

                # Held-address property: while a fill is on, the address ic presents
                # equals the one latched last cycle. This turns icache_input (phrased
                # in ifill_addr_old) into a fact about the word ic is installing.
                invariant [held_addr] ifill_on -> ifill_addr = mem_ic.ifill_addr_old
            }
        } with cpu, mem_ic, trace, word, addr, nib, bit, icline, itag, opc, ex_mem, mem_ic.mem_props.icache_input, ex_mem.ex_props.commit_bound
    }

    # ---- the memory / I-cache interface (mem_ic) ---------------------------
    # The interface between the memory (mem_stage) and the I-cache (ic), in the
    # standard two-sided form. It carries the ghost `ifill_addr_old` (the address
    # the memory port latched last cycle -- the read is two-cycle, so the datum
    # returned this cycle is for the address presented last cycle). mem_props
    # holds the memory's ASSUMPTION icache_input (a returned fill word is coherent
    # with the reference memory); ic_props holds the cache's GUARANTEEs
    # icache_output / icache_output1 (a valid fetched word is coherent), proved by
    # pulling in ic's fetch-read logic together with icache_input.

    private {
        isolate mem_ic = {
            # ghost: the fill address the port latched on the previous cycle.
            var ifill_addr_old : addr

            specification {
                after init {
                    ifill_addr_old := 0
                }
                after posedge {
                    ifill_addr_old := ic.ifill_addr
                }
            }

            # ---- memory-side guarantee: a returned fill word is coherent ----
            # The word the port returns (ic.ifill_data) for the address it latched
            # last cycle (ifill_addr_old) equals the reference memory at the MEM
            # boundary, when that address is not dirty. Proved from mem_stage's port
            # arbitration (mfa holds ifill_addr_old) and mem_track.
            isolate mem_props = {
                # The busy read's latched address equals the address ic presented
                # last cycle: both mfa (in the arbiter) and ifill_addr_old (here)
                # latch ic.ifill_addr on the read-start edge, and mbusy is never set
                # two cycles running, so this holds unguarded. It bridges the
                # one-cycle port latch for icache_input.
                invariant [mfa_track] main_mem.mbusy -> main_mem.mfa = ifill_addr_old

                invariant [icache_input] (ic.ifill_addr_valid & ic.ifill_data_valid
                        & ~trace.st(trace.now).error & ~trace.st(ex_mem.commit).ddirty(ifill_addr_old))
                    -> ic.ifill_data = trace.st(ex_mem.commit).mem(ifill_addr_old)
                    with mfa_track, main_mem.mem_track, ex_mem.ex_props.commit_bound
            } with cpu, trace, word, addr, nib, bit, icline, itag, opc, ic, main_mem, ex_mem, mem_ic

            # ---- I-cache-side guarantees: a valid fetched word is coherent ----
            # Proved by pulling in ic (its fetch-read logic and its internal
            # invariants hard/midfill/held_addr) together with icache_input. Only
            # these guarantees are exposed; the internal invariants stay in ic.
            isolate ic_props = {
                # GUARANTEE: a valid fetched word is coherent with the reference
                # memory at the MEM boundary (for a not-dirty address). This is the
                # base the if_id/id_ex fetch_track forwards consume.
                invariant [icache_output]
                      ic.fetch_addr_valid & ic.fetch_valid & ~trace.st(trace.now).error
                              & ~trace.st(ex_mem.commit).ddirty(ic.fetch_addr)
                                  -> ic.fetch_data = trace.st(ex_mem.commit).mem(ic.fetch_addr)
                    with ic.hard, mem_props.icache_input, ex_mem.ex_props.commit_bound

                # GUARANTEE for lane 1 (kept for a later dual-issue pipeline).
                invariant [icache_output1]
                      ic.fetch_addr_valid & ic.fetch_valid1 & ~trace.st(trace.now).error
                              & ~trace.st(ex_mem.commit).ddirty((ic.fetch_addr + 1))
                                  -> ic.fetch_data1 = trace.st(ex_mem.commit).mem((ic.fetch_addr + 1))
                    with ic.hard, mem_props.icache_input, ex_mem.ex_props.commit_bound

                invariant [icache_output1_odd] ic.fetch_addr_valid & ic.fetch_valid1 -> (ic.fetch_addr<<0:0>>:bit = 0)
            } with cpu, trace, word, addr, nib, bit, icline, itag, opc, ic, mem_ic, ex_mem
        } with cpu
    }

    # ---- writeback stage (WB) ----------------------------------------------
    # WB is the terminal stage: its output is the combinational register-file
    # write port, not a pipe register. It reads mem_stage's MEM/WB register and
    # drives the write port (wb_we/wb_rd/wb_val) consumed by ex_stage's register
    # file. It holds no state and no reference tag.

    implementation {
        isolate wb_stage = {

            wire wb_ra : reg                # input: a operand register 
            wire wb_rb : reg                # input: b operand register
            wire wb_we  : bool              # output: register-file write enable
            wire wb_rd  : reg               # output: write index
            wire wb_val : word              # output: write value
            wire wb_a : word                # output: a operand value
            wire wb_b : word                # output: b operand value

            register rf(R:reg) : word            # register file (read as EX operands, written by WB)
                
            # ---- implementation (hidden from other stages) ----
            wire w_opcode = mem_stage.w_ir<<15:13>> : opc
            definition wb_we  = mem_stage.w_valid & (w_opcode = 1 | w_opcode = 2 | w_opcode = 3 | w_opcode = 4)
            definition wb_rd  = mem_stage.w_ir<<12:10>>
            definition wb_val = mem_stage.w_val
            

            definition wb_a = rf(wb_ra)
            definition wb_b = rf(wb_rb)

            after init {
                rf(R) := 0
            }

            after posedge {
                # WB writeback into the register file. The operands read this cycle
                # are frozen pre-edge wires, so writing rf here does not disturb
                # them (a genuine same-register hazard is stalled anyway).
                if wb_we {
                    rf(wb_rd) := wb_val
                };
            }
            specification {
                # ---- the register file tracks the committed architectural state ----
                invariant [rf_track] ~trace.st(trace.now).error -> rf(R) = trace.st(mem_wb.commit).rf(R) with mem_wb.mem_props.commit_bound
            }
        } with cpu, trace, word, addr, reg, opc, mem_wb
    } 

    # ---- branch predictor (sub-isolate `bp`) ----
    # bp declares its own input/output wires and its logic uses only those; it
    # never reaches into the CPU. We connect it in the parent below: its inputs
    # are driven from the fetch PC and the EX branch resolution, and IF's
    # prediction input reads its output. Because bp's implementation is hidden,
    # every stage is verified with bp.predicted_taken left arbitrary -- so
    # correctness holds for ANY prediction (a predictor affects only
    # performance, not correctness). bp therefore needs no interface spec.

    implementation {
        isolate bp = {
            wire fetch_pc : addr          # input: PC being fetched (to predict)
            wire br_valid : bool          # input: a conditional branch resolves this cycle
            wire br_pc : addr             # input: the resolving branch's PC
            wire br_taken : bool          # input: its true outcome
            wire predicted_taken : bool   # output: the prediction for fetch_pc

            implementation {
                type bhtidx
                interpret bhtidx -> bv[4]  # 16-entry branch history table
                type ctr
                interpret ctr -> bv[2]     # 2-bit saturating counter, states 0..3

                var bht(I:bhtidx) : ctr

                wire pred_idx : bhtidx
                definition pred_idx = fetch_pc<<3:0>>
                wire upd_idx : bhtidx
                definition upd_idx = br_pc<<3:0>>

                # predict taken when the indexed counter is in a taken state (2 or 3)
                definition predicted_taken = (bht(pred_idx) = 2) | (bht(pred_idx) = 3)

                after init {
                    bht(I) := 1            # weakly not-taken
                }

                # on a resolved branch, nudge its counter toward the outcome,
                # saturating at 0 and 3
                after posedge {
                    if br_valid {
                        if br_taken {
                            if bht(upd_idx) ~= 3 { bht(upd_idx) := bht(upd_idx) + 1 }
                        } else {
                            if bht(upd_idx) ~= 0 { bht(upd_idx) := bht(upd_idx) - 1 }
                        }
                    }
                }
            }
        } with cpu, word, addr, reg, opc
    }

    # ---- stage-output-dependent combinational wires ----
    # These read the stage objects' registers / outputs, so they are defined here
    # (after all stage objects).
    definition ex_stall = ex_stage.ex_stall

    # A FLUSH must drain to the point where it would take effect (the MEM stage,
    # once the I-cache exists) before anything behind it is fetched. So fetch
    # stalls while a FLUSH is anywhere from IF/ID up to the EX/MEM register. This
    # is a plain fetch stall (bubble), independent of the branch speculation.
    definition flush_in_pipe =
          (if_stage.d_valid & (if_stage.d_ir<<15:13>>:opc = 7))
        | (id_stage.e_valid & (id_stage.e_ir<<15:13>>:opc = 7))
        | (ex_stage.m_valid & (ex_stage.m_opcode = 7))

    # ---- connect the stage inputs ----
    definition if_stage.ex_stall    = ex_stall
    definition if_stage.flush_in_pipe = flush_in_pipe
    definition if_stage.pc_ex_we    = ex_stage.pc_ex_we
    definition if_stage.pc_ex_wval  = ex_stage.pc_ex_wval
    definition if_stage.predicted_taken = bp.predicted_taken
    definition if_stage.fetch_data  = ic.fetch_data
    definition if_stage.fetch_valid = ic.fetch_valid

    # ---- I-cache wiring ----
    # fetch presents the pc; a fetch is attempted whenever IF is not frozen.
    definition ic.fetch_addr = if_stage.pc
    definition ic.fetch_addr_valid = ~ex_stall & ~flush_in_pipe
    # the two-cycle memory port (in mem_stage) returns fill data to ic
    definition ic.ifill_data = main_mem.ifill_data
    definition ic.ifill_data_valid = main_mem.ifill_data_valid
    definition main_mem.fill_addr = ic.ifill_addr
    definition main_mem.fill_req  = ic.ifill_addr_valid

    # main memory <-> MEM stage: the committing store (the LD read is a direct
    # cross-isolate read of main_mem.mem in mem_stage).
    definition main_mem.dwrite_en  = ex_stage.m_valid & (ex_stage.m_ir<<15:13>>:opc = 5)
    definition main_mem.dwrite_addr = ex_stage.m_addr
    definition main_mem.dwrite_data = ex_stage.m_store
    # a FLUSH executing in MEM evicts its 'a'-operand address from the I-cache
    definition ic.flush_addr  = ex_stage.m_addr
    definition ic.flush_valid = ex_stage.m_valid & (ex_stage.m_ir<<15:13>>:opc = 7)

    definition id_stage.ex_stall    = ex_stall
    definition id_stage.pc_ex_we    = ex_stage.pc_ex_we

    definition ex_stage.wb_we       = wb_stage.wb_we
    definition ex_stage.wb_rd       = wb_stage.wb_rd
    definition ex_stage.wb_val      = wb_stage.wb_val
    definition ex_stage.e_pred      = id_stage.e_pred
    definition ex_stage.e_pc        = id_stage.e_pc

    # connect the predictor (inputs from fetch PC and EX branch resolution)
    definition bp.fetch_pc  = if_stage.pc
    definition bp.br_valid  = id_stage.e_valid & (ex_stage.e_opcode = 6) & ~ex_stall
    definition bp.br_pc     = id_stage.e_pc
    definition bp.br_taken  = ex_stage.e_take
    
    definition mem_stage.ra = ex_stage.e_ra
    definition mem_stage.rb = ex_stage.e_rb
    definition wb_stage.wb_ra = ex_stage.e_ra
    definition wb_stage.wb_rb = ex_stage.e_rb
    definition ex_stage.e_a = wb_stage.wb_a
    definition ex_stage.e_b = wb_stage.wb_b
    definition ex_stage.mem_stall = mem_stage.mem_stall
}
