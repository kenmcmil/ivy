#lang ivy1.8

# An out-of-order CPU (Tomasulo's algorithm with a re-order buffer), verified
# against the ISA reference by reference tagging.
#
# STAGE 3c, ALTERNATE PROOF (this file): the SAME datapath as ooo_cpu_ref.ivy
# at stage 3c (full ISA, single-wide dispatch, one ALU, 4-entry ROB, LD/ST
# queue with store-to-load forwarding and two memory slots) verified WITHOUT a
# trace of reference states, in the style of ooo_cpu_mem_alt_ref.ivy: each ROB
# entry carries ghost copies of its correct values (taken from the reference at
# dispatch) instead of a tag into a recorded history, and the reference is the
# single ISA state `arch` after every dispatched correct-path instruction.
#
# Instruction encoding (16 bits):
#
#     [15:13] opcode   [12:10] rd   [9:7] ra   [6:4] rb   [7:0] imm/target
#
#   opcode 0  NOP
#          1  ADD  rd, ra, rb     rf[rd] := rf[ra] + rf[rb]
#          2  SUB  rd, ra, rb     rf[rd] := rf[ra] - rf[rb]
#          3  LI   rd, imm        rf[rd] := zero_extend(imm8)
#          4  LD   rd, [ra]       rf[rd] := mem[ rf[ra] ]
#          5  ST   [ra], rb       mem[ rf[ra] ] := rf[rb]
#          6  BEQZ ra, target     if rf[ra] == 0 then pc := target
#          7  FLUSH [ra]          make prior writes to mem[ rf[ra] ] visible to fetch
#
# Memory is unified and the I- and D-caches are not coherent, so (as in
# dual_issue_cpu_ref.ivy) the ISA carries a per-address dirty bit `ddirty(A)`
# (set by ST, cleared by FLUSH) and a sticky `error` set when an instruction is
# fetched from a dirty address; once error holds the implementation is no
# longer required to match, and every invariant relating the implementation
# to the trace is guarded by ~trace.st(trace.now).error.
#
# ---------------------------------------------------------------------------
# Microarchitecture
#
#   Fetch (IF)        : d_ir := idc.fetch_data0 at pc (stalls on an I-cache
#                       miss); pc := predicted next pc (bp predicts a fetched
#                       BEQZ; d_pred/d_pc ride with the instruction). Stalls
#                       when the ROB is full, and while a FLUSH is anywhere in
#                       flight (IF/ID latch or ROB) -- so a FLUSH is always the
#                       youngest instruction and nothing behind it is fetched
#                       until it has taken effect.
#   Dispatch (ID)     : allocates ROB entry `rob_tail`, renames rd (ALU ops and
#                       LD), captures operands (from rf / the ROB / the ALU
#                       result bus / the retiring load's data, else waits).
#   Issue / Execute   : the oldest ready, un-issued ALU/BEQZ entry goes to the
#                       one-cycle ALU; the result (and a BEQZ's outcome) is
#                       written to the entry and broadcast to waiting entries.
#   Memory (LD/ST Q)  : the LD/ST queue is the ROB order itself, scanned from
#                       the head. A ST/FLUSH is performable only when it is the
#                       head (memory is never written speculatively); it
#                       completes and retires in the cycle idc serves it. A LOAD
#                       is performable when its address is ready and no older
#                       unperformed memory op BLOCKS it -- a FLUSH, or a store
#                       whose address is not yet known; it passes older stores
#                       to other addresses and older loads. If the youngest
#                       older store to its own address exists, the load FORWARDS
#                       that store's data (once ready); otherwise it reads idc.
#                       Two memory slots work in parallel each cycle: the CACHE
#                       slot serves the oldest performable op that needs idc (a
#                       ST/FLUSH at the head or a non-forwarding load), and the
#                       FORWARDING slot the oldest performable forwarding load
#                       (which needs no cache access, so a store missing in the
#                       cache does not hold up the loads that depend on it).
#                       Either way a load's value goes into its entry
#                       (rob_val/rob_done), is broadcast to waiting entries and
#                       bypassed to a dispatching consumer, and the load later
#                       retires like an ALU op -- possibly speculatively, long
#                       before it is the head.
#   Retire            : the head entry, once done, writes the register file,
#                       frees its slot, clears the rename entry if it is still
#                       the youngest writer; a mispredicted BEQZ squashes the
#                       whole ROB, clears the rename table, kills the ALU/fetch
#                       latches and redirects the pc.
#
# ---------------------------------------------------------------------------
# Proof approach (ghost values instead of tags)
#
# See ooo_cpu_mem_alt_ref.ivy for the scheme: per-entry ghost values g_ir, g_pc,
# g_a, g_b, g_res, g_take copied from arch's prepared intermediates at a
# correct-path dispatch; datapath fields equal them; a pending operand's source
# has g_res(src) = g_a(I); g_res/g_take are consistent functions of the ghost
# operands; the architectural state is characterized through GHOST rename
# tables (grat for registers, mrat + per-load ld_src for memory, fl for the
# single in-flight FLUSH). The LD/ST queue and forwarding add nothing to the
# ghost state: the datapath's forwarding search is tied to ld_src by the same
# derived facts as in the tag-based proof (the forwarding slot's load forwards
# exactly from ld_src, whose data is ready; the cache slot's load is unbound),
# so a forwarded value is g_b(ld_src) = g_res(load) and a cache value is
# idc.mem(addr) = g_res(load).

include order
include idcache

type word
interpret word -> bv[16]
type addr
interpret addr -> bv[8]
type reg
interpret reg -> bv[3]
type opc
interpret opc -> bv[3]
type robidx                      # re-order buffer index (4 entries)
interpret robidx -> bv[2]
type bit                         # an idcache type parameter
interpret bit -> bv[1]

export action posedge

# Initial memory contents: an arbitrary fixed program image, shared by the
# implementation and the reference (see dual_issue_cpu_ref.ivy for why).
function init_mem(A:addr) : word

# ===========================================================================
# The ISA model (the full shared ISA; `res` also records a LD's value).
# ===========================================================================

module isa_model(init_mem) = {

    var pc : addr                 # program counter
    var rf(R:reg) : word          # register file
    var mem(A:addr) : word        # unified memory (instructions and data)
    var ddirty(A:addr) : bool     # A has been written since the last FLUSH of A
    var error : bool              # an instruction was fetched from a dirty address

    # Temporary variables computed by `prepare`, not holding state

    var fetched : word
    var opcode : opc
    var rd : reg
    var ra : reg
    var rb : reg
    var target : addr             # low 8 bits: branch target or immediate
    var a_val : word
    var b_val : word
    var mem_addr : addr           # address for LD/ST/FLUSH: low 8 bits of rf[ra]
    var take_branch : bool        # BEQZ outcome
    var res : word                # the value written to rd (ADD/SUB/LI/LD; 0 otherwise)

    after init {
        pc := 0;
        rf(R) := 0;
        mem(A) := init_mem(A);
        ddirty(A) := false;
        error := false;
    }

    action prepare = {
        fetched := mem(pc);
        opcode := fetched<<15:13>>;
        rd := fetched<<12:10>>;
        ra := fetched<<9:7>>;
        rb := fetched<<6:4>>;
        target := fetched<<7:0>>;
        a_val := rf(ra);
        b_val := rf(rb);
        mem_addr := a_val<<7:0>>;
        take_branch := (opcode = 6) & (a_val = 0);
        res := (a_val + b_val if opcode = 1 else
               (a_val - b_val if opcode = 2 else
               ((0:addr) :: target if opcode = 3 else
               (mem(mem_addr) if opcode = 4 else 0))));
    }

    action step = {
        # Fetch coherence: an instruction executed from a dirty address is a
        # stale fetch; the ISA enters the sticky error state.
        if ddirty(pc) {
            error := true;
        }
        if opcode = 1 | opcode = 2 | opcode = 3 | opcode = 4 {
            rf(rd) := res
        } else if opcode = 5 {
            mem(mem_addr) := b_val;
            ddirty(mem_addr) := true;
        } else if opcode = 7 {
            ddirty(mem_addr) := false;
        };
        if take_branch {
            pc := target
        } else {
            pc := pc + 1
        }
    }
}

# ===========================================================================
# The reference: the ISA state after every dispatched correct-path instruction.
# (No recorded history: the ROB's ghost values replace it.)
# ===========================================================================

isolate trace = {

    specification {

        instance arch : isa_model(init_mem)

        after init {
            arch.prepare;
        }

        # execute the instruction arch has prepared, and prepare the next
        action step = {
            arch.step;
            arch.prepare;
        }

        # arch's intermediate values decode its own architectural state
        invariant arch.fetched = arch.mem(arch.pc)
        invariant arch.opcode = (arch.fetched)<<15:13>>
        invariant arch.rd = (arch.fetched)<<12:10>>
        invariant arch.ra = (arch.fetched)<<9:7>>
        invariant arch.rb = (arch.fetched)<<6:4>>
        invariant arch.target = (arch.fetched)<<7:0>>
        invariant arch.a_val = arch.rf(arch.ra)
        invariant arch.b_val = arch.rf(arch.rb)
        invariant arch.mem_addr = (arch.a_val)<<7:0>>
        invariant arch.take_branch = ((arch.opcode = 6) & (arch.a_val = 0))
        invariant arch.res = (arch.a_val + arch.b_val if arch.opcode = 1 else (arch.a_val - arch.b_val if arch.opcode = 2 else ((0:addr) :: arch.target if arch.opcode = 3 else (arch.mem(arch.mem_addr) if arch.opcode = 4 else 0))))
    }
} with addr, opc

# ===========================================================================
# The out-of-order CPU.
# ===========================================================================

object cpu = {

    # ---- ghost reference values -------------------------------------------
    specification {
        # the correct values of entry I's instruction, copied from arch at dispatch
        var g_ir(I:robidx) : word         # its instruction word
        var g_pc(I:robidx) : addr         # its pc
        var g_a(I:robidx) : word          # its operands
        var g_b(I:robidx) : word
        var g_res(I:robidx) : word        # its result (the value written to rd; a LD's loaded word)
        var g_take(I:robidx) : bool       # its BEQZ outcome
        var rob_shadow(I:robidx) : bool   # entry I is wrong-path (behind a mispredict)
        var d_shadow : bool               # the IF/ID instruction is wrong-path
        var spec_wrong : bool             # the fetch stream is on a mispredicted path
        var mp_idx : robidx               # while spec_wrong: the mispredicted branch's entry
        # ghost rename tables (correct-path instructions only)
        var grat_valid(R:reg) : bool      # R has an in-flight correct-path writer ...
        var grat_idx(R:reg) : robidx      # ... the youngest being this entry
        var mrat_valid(A:addr) : bool     # A has an in-flight correct-path store ...
        var mrat_idx(A:addr) : robidx     # ... the youngest being this entry
        var ld_src_valid(I:robidx) : bool # load I is bound to the youngest older store to its address
        var ld_src(I:robidx) : robidx
        var fl_valid : bool               # a correct-path FLUSH is in flight (it is the youngest instruction)
        var fl_idx : robidx
        var fl_addr : addr

        after init {
            d_shadow := false;
            spec_wrong := false;
            grat_valid(R) := false;
            mrat_valid(A) := false;
            fl_valid := false;
        }
    }

    # ---- architectural state ----
    var pc : addr
    var rf(R:reg) : word

    # ---- memory subsystem: the reusable `idcache` module (I-cache, D-cache,
    # main memory, FLUSH-based coherence, multi-cycle fill port). Its spec is
    # over its own abstract idc.mem / idc.ddirty, which the CPU relates to the
    # reference at the retire tag (commit) below. Only fetch lane 0 is used.
    instance idc : idcache(posedge, word, addr, bit, init_mem)

    # ---- IF/ID latch ----
    var d_ir : word
    var d_valid : bool
    var d_pred : bool                 # predicted-taken bit carried with the instruction
    var d_pc : addr                   # the instruction's own pc

    # ---- rename table ----
    var rat_valid(R:reg) : bool       # R has an in-flight writer
    var rat_idx(R:reg) : robidx       # ... namely ROB entry rat_idx(R) (the youngest)

    # ---- re-order buffer (with the reservation-station fields per entry) ----
    var rob_head : robidx             # oldest entry
    var rob_tail : robidx             # next free entry
    var rob_busy(I:robidx) : bool     # entry holds an instruction
    var rob_ir(I:robidx) : word       # its instruction word
    var rob_pc(I:robidx) : addr       # its pc (for the branch redirect)
    var rob_pred(I:robidx) : bool     # its carried branch prediction
    var rob_take(I:robidx) : bool     # its true branch outcome (valid when done)
    var rob_issued(I:robidx) : bool   # it has been sent to the ALU (or needs no ALU)
    var rob_done(I:robidx) : bool     # its result is in rob_val (never for a ST/FLUSH)
    var rob_val(I:robidx) : word
    var rob_a(I:robidx) : word        # operand a (valid when rob_a_rdy)
    var rob_a_rdy(I:robidx) : bool
    var rob_a_src(I:robidx) : robidx  # else: the ROB entry producing it
    var rob_b(I:robidx) : word
    var rob_b_rdy(I:robidx) : bool
    var rob_b_src(I:robidx) : robidx

    # ---- ALU latch ----
    var ex_valid : bool
    var ex_idx : robidx
    var ex_ir : word
    var ex_a : word
    var ex_b : word

    implementation {

    # ---- ROB occupancy ----
    wire rob_full : bool
    definition rob_full = rob_busy(rob_tail)

    # ---- dispatch decode ----
    wire d_opcode : opc
    definition d_opcode = d_ir<<15:13>>
    wire d_rd : reg
    definition d_rd = d_ir<<12:10>>
    wire d_ra : reg
    definition d_ra = d_ir<<9:7>>
    wire d_rb : reg
    definition d_rb = d_ir<<6:4>>
    wire d_target : addr
    definition d_target = d_ir<<7:0>>
    wire d_wr : bool                  # writes rd (ALU op or LD): renamed
    definition d_wr = (d_opcode = 1 | d_opcode = 2 | d_opcode = 3 | d_opcode = 4)
    wire d_branch : bool
    definition d_branch = (d_opcode = 6)
    wire d_exec : bool                # goes through the ALU (ALU op or branch)
    definition d_exec = (d_opcode = 1 | d_opcode = 2 | d_opcode = 3 | d_opcode = 6)
    wire d_mem : bool                 # a memory op: executes at the head
    definition d_mem = (d_opcode = 4 | d_opcode = 5 | d_opcode = 7)
    wire d_needs_a : bool             # reads ra
    definition d_needs_a = (d_opcode = 1 | d_opcode = 2 | d_opcode = 4 | d_opcode = 5 | d_opcode = 6 | d_opcode = 7)
    wire d_needs_b : bool             # reads rb
    definition d_needs_b = (d_opcode = 1 | d_opcode = 2 | d_opcode = 5)

    # ---- retire / memory-at-head decode ----
    wire r_ir : word
    definition r_ir = rob_ir(rob_head)
    wire r_opcode : opc
    definition r_opcode = r_ir<<15:13>>
    wire r_rd : reg
    definition r_rd = r_ir<<12:10>>
    wire r_target : addr
    definition r_target = r_ir<<7:0>>
    wire r_wr : bool                  # writes rd (ALU op or LD)
    definition r_wr = (r_opcode = 1 | r_opcode = 2 | r_opcode = 3 | r_opcode = 4)
    wire r_branch : bool
    definition r_branch = (r_opcode = 6)
    wire r_mem : bool
    definition r_mem = (r_opcode = 4 | r_opcode = 5 | r_opcode = 7)
    wire r_val : word                 # the retiring ALU result (pre-state read)
    definition r_val = rob_val(rob_head)
    wire r_rat_clear : bool           # the retiring entry is still rd's youngest writer
    definition r_rat_clear = rat_valid(r_rd) & rat_idx(r_rd) = rob_head
    wire r_pc : addr
    definition r_pc = rob_pc(rob_head)
    wire r_take : bool
    definition r_take = rob_take(rob_head)
    wire r_pred : bool
    definition r_pred = rob_pred(rob_head)

    # ---- head-relative entry indices, for oldest-first selection ----
    wire h0 : robidx
    definition h0 = rob_head
    wire h1 : robidx
    definition h1 = rob_head + 1
    wire h2 : robidx
    definition h2 = rob_head + 2
    wire h3 : robidx
    definition h3 = rob_head + 3

    # ---- the LD/ST queue: per head-relative position j, an unperformed store
    # with a known address (a forwarding candidate; passable when the address
    # differs), a blocker (an unperformed FLUSH, or a store whose address is not
    # yet known), and an unperformed load with a known address ----
    wire q0_op : opc
    definition q0_op = rob_ir(h0)<<15:13>>
    wire q1_op : opc
    definition q1_op = rob_ir(h1)<<15:13>>
    wire q2_op : opc
    definition q2_op = rob_ir(h2)<<15:13>>
    wire q3_op : opc
    definition q3_op = rob_ir(h3)<<15:13>>
    wire q0_addr : addr
    definition q0_addr = rob_a(h0)<<7:0>>
    wire q1_addr : addr
    definition q1_addr = rob_a(h1)<<7:0>>
    wire q2_addr : addr
    definition q2_addr = rob_a(h2)<<7:0>>
    wire q3_addr : addr
    definition q3_addr = rob_a(h3)<<7:0>>
    wire q0_st : bool
    definition q0_st = rob_busy(h0) & ~rob_done(h0) & q0_op = 5 & rob_a_rdy(h0)
    wire q1_st : bool
    definition q1_st = rob_busy(h1) & ~rob_done(h1) & q1_op = 5 & rob_a_rdy(h1)
    wire q2_st : bool
    definition q2_st = rob_busy(h2) & ~rob_done(h2) & q2_op = 5 & rob_a_rdy(h2)
    wire q0_blk : bool
    definition q0_blk = rob_busy(h0) & ~rob_done(h0) & ((q0_op = 5 & ~rob_a_rdy(h0)) | q0_op = 7)
    wire q1_blk : bool
    definition q1_blk = rob_busy(h1) & ~rob_done(h1) & ((q1_op = 5 & ~rob_a_rdy(h1)) | q1_op = 7)
    wire q2_blk : bool
    definition q2_blk = rob_busy(h2) & ~rob_done(h2) & ((q2_op = 5 & ~rob_a_rdy(h2)) | q2_op = 7)
    wire q0_ld : bool
    definition q0_ld = rob_busy(h0) & ~rob_done(h0) & q0_op = 4 & rob_a_rdy(h0)
    wire q1_ld : bool
    definition q1_ld = rob_busy(h1) & ~rob_done(h1) & q1_op = 4 & rob_a_rdy(h1)
    wire q2_ld : bool
    definition q2_ld = rob_busy(h2) & ~rob_done(h2) & q2_op = 4 & rob_a_rdy(h2)
    wire q3_ld : bool
    definition q3_ld = rob_busy(h3) & ~rob_done(h3) & q3_op = 4 & rob_a_rdy(h3)

    # ---- store-to-load forwarding source for the load at position i: the
    # youngest older unperformed store with a known address equal to the load's ----
    wire f1_m0 : bool
    definition f1_m0 = q0_st & q0_addr = q1_addr
    wire f2_m1 : bool
    definition f2_m1 = q1_st & q1_addr = q2_addr
    wire f2_m0 : bool
    definition f2_m0 = q0_st & q0_addr = q2_addr
    wire f3_m2 : bool
    definition f3_m2 = q2_st & q2_addr = q3_addr
    wire f3_m1 : bool
    definition f3_m1 = q1_st & q1_addr = q3_addr
    wire f3_m0 : bool
    definition f3_m0 = q0_st & q0_addr = q3_addr
    wire fwd1 : bool
    definition fwd1 = f1_m0
    wire fsrc1 : robidx
    definition fsrc1 = h0
    wire fwd2 : bool
    definition fwd2 = f2_m1 | f2_m0
    wire fsrc2 : robidx
    definition fsrc2 = (h1 if f2_m1 else h0)
    wire fwd3 : bool
    definition fwd3 = f3_m2 | f3_m1 | f3_m0
    wire fsrc3 : robidx
    definition fsrc3 = (h2 if f3_m2 else (h1 if f3_m1 else h0))

    # ---- performable memory ops: a load with a known address, no older blocker,
    # and (if forwarding) its source's data ready; a ST/FLUSH only at the head ----
    wire ldok0 : bool
    definition ldok0 = q0_ld
    wire ldok1 : bool
    definition ldok1 = q1_ld & ~q0_blk & (~fwd1 | rob_b_rdy(fsrc1))
    wire ldok2 : bool
    definition ldok2 = q2_ld & ~q0_blk & ~q1_blk & (~fwd2 | rob_b_rdy(fsrc2))
    wire ldok3 : bool
    definition ldok3 = q3_ld & ~q0_blk & ~q1_blk & ~q2_blk & (~fwd3 | rob_b_rdy(fsrc3))
    wire stok0 : bool
    definition stok0 = rob_busy(h0) & ~rob_done(h0) & (q0_op = 5 | q0_op = 7) & rob_a_rdy(h0) & rob_b_rdy(h0)

    # ---- the CACHE slot serves the oldest performable op that needs idc: a
    # ST/FLUSH at the head, or a load that does not forward ----
    wire c0 : bool
    definition c0 = ldok0 | stok0
    wire c1 : bool
    definition c1 = ldok1 & ~fwd1
    wire c2 : bool
    definition c2 = ldok2 & ~fwd2
    wire c3 : bool
    definition c3 = ldok3 & ~fwd3
    wire mem_valid : bool
    definition mem_valid = c0 | c1 | c2 | c3
    wire mem_sel : robidx
    definition mem_sel = (h0 if c0 else (h1 if c1 else (h2 if c2 else h3)))
    wire mem_ir : word
    definition mem_ir = rob_ir(mem_sel)
    wire mem_opcode : opc
    definition mem_opcode = mem_ir<<15:13>>
    wire mem_is_load : bool
    definition mem_is_load = (mem_opcode = 4)
    wire mem_a : word                 # its operands (address / store data)
    definition mem_a = rob_a(mem_sel)
    wire mem_b : word
    definition mem_b = rob_b(mem_sel)
    wire mem_addr : addr
    definition mem_addr = mem_a<<7:0>>
    wire mem_ready : bool             # the request to idc
    definition mem_ready = mem_valid
    wire mem_perform : bool           # the op performs if idc does not stall
    definition mem_perform = mem_valid & ~idc.data_stall
    wire ld_perform : bool            # a cache load performs: idc's word lands in the entry and is broadcast
    definition ld_perform = mem_perform & mem_is_load
    wire mem_retire : bool            # a ST/FLUSH performs at the head: it retires now
    definition mem_retire = mem_perform & ~mem_is_load
    wire retire : bool
    definition retire = (rob_busy(rob_head) & rob_done(rob_head)) | mem_retire

    # ---- the FORWARDING slot serves the oldest performable forwarding load ----
    wire w1 : bool
    definition w1 = ldok1 & fwd1
    wire w2 : bool
    definition w2 = ldok2 & fwd2
    wire w3 : bool
    definition w3 = ldok3 & fwd3
    wire fwd_perform : bool           # a forwarding load performs: its source's data lands in the entry and is broadcast
    definition fwd_perform = w1 | w2 | w3
    wire fwd_sel : robidx
    definition fwd_sel = (h1 if w1 else (h2 if w2 else h3))
    wire fwd_src : robidx
    definition fwd_src = (fsrc1 if w1 else (fsrc2 if w2 else fsrc3))
    wire fwd_data : word
    definition fwd_data = rob_b(fwd_src)
    # a retiring BEQZ whose outcome differs from its prediction: squash
    wire squash : bool
    definition squash = retire & r_branch & (r_take ~= r_pred)
    wire redirect_pc : addr           # the correct next pc after the branch
    definition redirect_pc = (r_target if r_take else r_pc + 1)

    # ---- a FLUSH in flight (IF/ID or ROB) stalls fetch until it retires ----
    wire flush_pending : bool
    definition flush_pending = (d_valid & d_opcode = 7)
                             | (rob_busy(0) & (rob_ir(0)<<15:13>>:opc) = 7)
                             | (rob_busy(1) & (rob_ir(1)<<15:13>>:opc) = 7)
                             | (rob_busy(2) & (rob_ir(2)<<15:13>>:opc) = 7)
                             | (rob_busy(3) & (rob_ir(3)<<15:13>>:opc) = 7)

    wire dispatch : bool
    definition dispatch = d_valid & ~rob_full & ~squash
    wire if_stall : bool
    definition if_stall = d_valid & rob_full
    wire fetch_active : bool          # IF presents the pc to idc
    definition fetch_active = ~if_stall & ~squash & ~flush_pending
    wire fetch_en : bool              # ... and latches the word if idc returns it
    definition fetch_en = fetch_active & idc.fetch_valid0

    # ---- ALU ----
    wire ex_opcode : opc
    definition ex_opcode = ex_ir<<15:13>>
    wire ex_target : addr
    definition ex_target = ex_ir<<7:0>>
    wire ex_res : word
    definition ex_res = (ex_a + ex_b if ex_opcode = 1 else
                        (ex_a - ex_b if ex_opcode = 2 else
                        ((0:addr) :: ex_target if ex_opcode = 3 else 0)))
    wire ex_take : bool               # the true BEQZ outcome
    definition ex_take = (ex_opcode = 6) & (ex_a = 0)

    # ---- operand capture at dispatch ----
    # An operand is ready if its register has no in-flight writer, or the
    # writer is done, or the writer is completing right now on the ALU result
    # bus, in the cache slot (idc's word) or in the forwarding slot (its source
    # store's data) -- the dispatching entry is not yet in the ROB, so it would
    # otherwise miss that broadcast.
    wire d_a_idx : robidx
    definition d_a_idx = rat_idx(d_ra)
    wire d_a_bus : bool
    definition d_a_bus = ex_valid & ex_idx = d_a_idx
    wire d_a_ld : bool
    definition d_a_ld = ld_perform & d_a_idx = mem_sel
    wire d_a_fw : bool
    definition d_a_fw = fwd_perform & d_a_idx = fwd_sel
    wire d_a_rdy : bool
    definition d_a_rdy = ~d_needs_a | ~rat_valid(d_ra) | rob_done(d_a_idx) | d_a_bus | d_a_ld | d_a_fw
    wire d_a_val : word
    definition d_a_val = (rf(d_ra) if ~rat_valid(d_ra) else
                         (ex_res if d_a_bus else
                         (idc.read_data if d_a_ld else
                         (fwd_data if d_a_fw else rob_val(d_a_idx)))))

    wire d_b_idx : robidx
    definition d_b_idx = rat_idx(d_rb)
    wire d_b_bus : bool
    definition d_b_bus = ex_valid & ex_idx = d_b_idx
    wire d_b_ld : bool
    definition d_b_ld = ld_perform & d_b_idx = mem_sel
    wire d_b_fw : bool
    definition d_b_fw = fwd_perform & d_b_idx = fwd_sel
    wire d_b_rdy : bool
    definition d_b_rdy = ~d_needs_b | ~rat_valid(d_rb) | rob_done(d_b_idx) | d_b_bus | d_b_ld | d_b_fw
    wire d_b_val : word
    definition d_b_val = (rf(d_rb) if ~rat_valid(d_rb) else
                         (ex_res if d_b_bus else
                         (idc.read_data if d_b_ld else
                         (fwd_data if d_b_fw else rob_val(d_b_idx)))))

    # ---- issue selection: the oldest ready, un-issued ALU/BEQZ entry ----
    # (memory ops never issue to the ALU: they go through the LD/ST queue)
    wire rdy0 : bool
    definition rdy0 = rob_busy(h0) & ~rob_issued(h0) & rob_a_rdy(h0) & rob_b_rdy(h0)
                    & ~((rob_ir(h0)<<15:13>>:opc) = 4 | (rob_ir(h0)<<15:13>>:opc) = 5 | (rob_ir(h0)<<15:13>>:opc) = 7)
    wire rdy1 : bool
    definition rdy1 = rob_busy(h1) & ~rob_issued(h1) & rob_a_rdy(h1) & rob_b_rdy(h1)
                    & ~((rob_ir(h1)<<15:13>>:opc) = 4 | (rob_ir(h1)<<15:13>>:opc) = 5 | (rob_ir(h1)<<15:13>>:opc) = 7)
    wire rdy2 : bool
    definition rdy2 = rob_busy(h2) & ~rob_issued(h2) & rob_a_rdy(h2) & rob_b_rdy(h2)
                    & ~((rob_ir(h2)<<15:13>>:opc) = 4 | (rob_ir(h2)<<15:13>>:opc) = 5 | (rob_ir(h2)<<15:13>>:opc) = 7)
    wire rdy3 : bool
    definition rdy3 = rob_busy(h3) & ~rob_issued(h3) & rob_a_rdy(h3) & rob_b_rdy(h3)
                    & ~((rob_ir(h3)<<15:13>>:opc) = 4 | (rob_ir(h3)<<15:13>>:opc) = 5 | (rob_ir(h3)<<15:13>>:opc) = 7)
    wire issue : bool
    definition issue = ~squash & (rdy0 | rdy1 | rdy2 | rdy3)
    wire issue_idx : robidx
    definition issue_idx = (h0 if rdy0 else (h1 if rdy1 else (h2 if rdy2 else h3)))

    }

    # ---- the branch predictor, as a sub-isolate `bp` (as in 5stage_bp_cpu_ref) ----
    isolate bp = {
        wire fetch_pc : addr          # input: PC being fetched (to predict)
        wire br_valid : bool          # input: a conditional branch resolves this cycle
        wire br_pc : addr             # input: the resolving branch's PC
        wire br_taken : bool          # input: its true outcome
        wire predicted_taken : bool   # output: the prediction for fetch_pc

        implementation {
            type bhtidx
            interpret bhtidx -> bv[4]  # 16-entry branch history table
            type ctr
            interpret ctr -> bv[2]     # 2-bit saturating counter, states 0..3

            var bht(I:bhtidx) : ctr

            wire pred_idx : bhtidx
            definition pred_idx = fetch_pc<<3:0>>
            wire upd_idx : bhtidx
            definition upd_idx = br_pc<<3:0>>

            definition predicted_taken = (bht(pred_idx) = 2) | (bht(pred_idx) = 3)

            after init {
                bht(I) := 1            # weakly not-taken
            }

            after posedge {
                if br_valid {
                    if br_taken {
                        if bht(upd_idx) ~= 3 { bht(upd_idx) := bht(upd_idx) + 1 }
                    } else {
                        if bht(upd_idx) ~= 0 { bht(upd_idx) := bht(upd_idx) - 1 }
                    }
                }
            }
        }
    }

    # connect the predictor (in the parent): predict at fetch, train at retire
    definition bp.fetch_pc = pc
    definition bp.br_valid = retire & r_branch
    definition bp.br_pc = r_pc
    definition bp.br_taken = r_take

    # ---- connect the idcache module (in the parent, so both the datapath and
    # the sub-blocks see the interconnect) ----
    # Fetch port: present the pc whenever IF is really fetching.
    definition idc.fetch_req  = fetch_active
    definition idc.fetch_addr = pc
    # Data port: the cache slot's op. Its opcode is a single value, so
    # read/write/flush are mutually exclusive (one_data_op).
    definition idc.read_req   = mem_ready & (mem_opcode = 4)
    definition idc.write_req  = mem_ready & (mem_opcode = 5)
    definition idc.flush_req  = mem_ready & (mem_opcode = 7)
    definition idc.data_addr  = mem_addr
    definition idc.write_data = mem_b

    implementation {

    # ---- fetch and prediction ----
    wire fetched : word
    definition fetched = idc.fetch_data0
    wire f_is_branch : bool
    definition f_is_branch = ((fetched<<15:13>>:opc) = 6)
    wire f_ptaken : bool             # predicted-taken for the fetched instruction
    definition f_ptaken = f_is_branch & bp.predicted_taken
    wire f_target : addr
    definition f_target = fetched<<7:0>>
    wire pred_next_pc : addr
    definition pred_next_pc = (f_target if f_ptaken else pc + 1)

    # ---- reset ----
    after init {
        pc := 0;
        rf(R) := 0;
        d_valid := false;
        rat_valid(R) := false;
        rob_head := 0;
        rob_tail := 0;
        rob_busy(I) := false;
        rob_issued(I) := false;
        rob_done(I) := false;
        ex_valid := false;
        # main memory and both caches are initialized inside idc.
    }

    # ---- clock edge ----
    # Every value read below is a pre-state value: the blocks are ordered so
    # that no block reads an array element an earlier block wrote, the retire
    # block's reads go through wires, and the two result broadcasts (ALU and
    # retiring load) are written as one statement. The action therefore has
    # exactly the semantics of a nonblocking always-block (see the golden).
    after posedge {

        # Complete the ALU operation: write the result (and a BEQZ's outcome).
        if ex_valid {
            rob_val(ex_idx) := ex_res;
            rob_done(ex_idx) := true;
            rob_take(ex_idx) := ex_take
        };
        # Perform loads: the cache slot's load gets idc's word, the forwarding
        # slot's load its source store's data. (ex_idx is an issued ALU op and
        # the two loads are never-issued distinct entries, so no two coincide.)
        if ld_perform {
            rob_val(mem_sel) := idc.read_data;
            rob_done(mem_sel) := true
        };
        if fwd_perform {
            rob_val(fwd_sel) := fwd_data;
            rob_done(fwd_sel) := true
        };

        # Broadcast: the ALU result to every entry waiting on ex_idx, the cache
        # load's word to those waiting on mem_sel, the forwarded data to those
        # waiting on fwd_sel.
        rob_a(I) := (ex_res if (ex_valid & rob_busy(I) & ~rob_a_rdy(I) & rob_a_src(I) = ex_idx) else
                    (idc.read_data if (ld_perform & rob_busy(I) & ~rob_a_rdy(I) & rob_a_src(I) = mem_sel) else
                    (fwd_data if (fwd_perform & rob_busy(I) & ~rob_a_rdy(I) & rob_a_src(I) = fwd_sel) else
                     rob_a(I))));
        rob_a_rdy(I) := rob_a_rdy(I) | (ex_valid & rob_busy(I) & rob_a_src(I) = ex_idx)
                                     | (ld_perform & rob_busy(I) & rob_a_src(I) = mem_sel)
                                     | (fwd_perform & rob_busy(I) & rob_a_src(I) = fwd_sel);
        rob_b(I) := (ex_res if (ex_valid & rob_busy(I) & ~rob_b_rdy(I) & rob_b_src(I) = ex_idx) else
                    (idc.read_data if (ld_perform & rob_busy(I) & ~rob_b_rdy(I) & rob_b_src(I) = mem_sel) else
                    (fwd_data if (fwd_perform & rob_busy(I) & ~rob_b_rdy(I) & rob_b_src(I) = fwd_sel) else
                     rob_b(I))));
        rob_b_rdy(I) := rob_b_rdy(I) | (ex_valid & rob_busy(I) & rob_b_src(I) = ex_idx)
                                     | (ld_perform & rob_busy(I) & rob_b_src(I) = mem_sel)
                                     | (fwd_perform & rob_busy(I) & rob_b_src(I) = fwd_sel);

        # Retire the head entry: a done ALU/BEQZ/NOP/LD entry, or a ST/FLUSH
        # that idc serves this cycle (the store/flush effects on memory and the
        # caches happen inside idc, driven by the request wires). A
        # mispredicted BEQZ squashes everything behind it and redirects the pc.
        if retire {
            if r_wr {
                rf(r_rd) := r_val
            };
            if r_rat_clear {
                rat_valid(r_rd) := false
            };
            rob_busy(rob_head) := false;
            if squash {
                rob_busy(I) := false;             # every other entry is younger: drop it
                rat_valid(R) := false;            # no in-flight writers remain
                rob_tail := rob_head + 1;         # empty ROB (pre-state head)
                ex_valid := false;                # kill the in-flight ALU op
                d_valid := false;                 # kill the fetched instruction
                pc := redirect_pc
            };
            rob_head := rob_head + 1
        };

        # Issue the oldest ready entry to the ALU. (rob_a/rob_b(issue_idx) are
        # read after the broadcast above, but the broadcast only writes entries
        # whose operand is NOT ready, and issue_idx is ready, so these are still
        # the pre-state values.)
        if issue {
            ex_valid := true;
            ex_idx := issue_idx;
            ex_ir := rob_ir(issue_idx);
            ex_a := rob_a(issue_idx);
            ex_b := rob_b(issue_idx);
            rob_issued(issue_idx) := true
        } else {
            ex_valid := false
        };

        # Dispatch: allocate the tail entry, rename, capture operands. This
        # comes after retire so that a same-cycle retire of an older writer of
        # d_rd does not clobber the new rename entry. The IF/ID latch empties
        # unless the fetch below refills it.
        if dispatch {
            rob_busy(rob_tail) := true;
            rob_ir(rob_tail) := d_ir;
            rob_pc(rob_tail) := d_pc;
            rob_pred(rob_tail) := d_pred;
            rob_issued(rob_tail) := ~d_exec & ~d_mem;   # a NOP is issued+done at once; an ALU/BEQZ op
            rob_done(rob_tail) := ~d_exec & ~d_mem;     # issues later; a memory op is neither until it performs
            rob_val(rob_tail) := 0;
            rob_a(rob_tail) := d_a_val;
            rob_a_rdy(rob_tail) := d_a_rdy;
            rob_a_src(rob_tail) := d_a_idx;
            rob_b(rob_tail) := d_b_val;
            rob_b_rdy(rob_tail) := d_b_rdy;
            rob_b_src(rob_tail) := d_b_idx;
            if d_wr {
                rat_valid(d_rd) := true;
                rat_idx(d_rd) := rob_tail
            };
            rob_tail := rob_tail + 1;
            d_valid := false
        };

        # Fetch (speculatively, along the predicted path) when IF is active and
        # idc returns the word (an I-cache miss stalls: the latch stays empty).
        if fetch_en {
            d_ir := fetched;
            d_valid := true;
            d_pred := f_ptaken;
            d_pc := pc;
            pc := pred_next_pc
        }
    }
    }

    # ---- ghost monitor: reference values, shadows and the reference step -----
    specification {
        after posedge {
            if retire {
                # a retiring writer / store / FLUSH leaves the ghost rename tables;
                # the loads bound to a retiring store now refer to idc's memory
                grat_valid(R) := grat_valid(R) & ~(grat_idx(R) = old rob_head);
                mrat_valid(A) := mrat_valid(A) & ~(mrat_idx(A) = old rob_head);
                ld_src_valid(I) := ld_src_valid(I) & ~(ld_src(I) = old rob_head);
                if fl_valid & fl_idx = old rob_head {
                    fl_valid := false
                }
            };
            if squash {
                spec_wrong := false;
                d_shadow := false;
                grat_valid(R) := false;         # the ROB is emptied: nothing in flight
                mrat_valid(A) := false;
                fl_valid := false
            };
            if dispatch {
                rob_shadow(old rob_tail) := d_shadow;
                if ~d_shadow {
                    # a correct-path instruction: arch has prepared exactly its
                    # values. Copy them, update the ghost rename tables, check a
                    # BEQZ's prediction against the true outcome, then step arch.
                    g_ir(old rob_tail) := trace.arch.fetched;
                    g_pc(old rob_tail) := trace.arch.pc;
                    g_a(old rob_tail) := trace.arch.a_val;
                    g_b(old rob_tail) := trace.arch.b_val;
                    g_res(old rob_tail) := trace.arch.res;
                    g_take(old rob_tail) := trace.arch.take_branch;
                    if d_branch & (old d_pred ~= trace.arch.take_branch) {   # old: insensitive to monitor order
                        spec_wrong := true;
                        mp_idx := old rob_tail
                    };
                    if trace.arch.opcode = 1 | trace.arch.opcode = 2 | trace.arch.opcode = 3 | trace.arch.opcode = 4 {
                        grat_valid(trace.arch.rd) := true;
                        grat_idx(trace.arch.rd) := old rob_tail
                    };
                    ld_src_valid(old rob_tail) := (trace.arch.opcode = 4) & mrat_valid(trace.arch.mem_addr);
                    ld_src(old rob_tail) := mrat_idx(trace.arch.mem_addr);
                    if trace.arch.opcode = 5 {
                        mrat_valid(trace.arch.mem_addr) := true;
                        mrat_idx(trace.arch.mem_addr) := old rob_tail
                    };
                    if trace.arch.opcode = 7 {
                        fl_valid := true;
                        fl_idx := old rob_tail;
                        fl_addr := trace.arch.mem_addr
                    };
                    trace.step
                }
            };
            if fetch_en {
                d_shadow := spec_wrong
            }
        }
    }

    # ---- invariants -------------------------------------------------------
    # Every invariant relating the implementation to the reference is guarded by
    # ~trace.arch.error (the fetch-coherence relaxation); the purely structural
    # ones are not. Opcode/field tests on ghost words are spelled out with
    # bit-selects of g_ir.
    private {

        # ---- ROB occupancy structure ----
        invariant [rob_shape] rob_busy(I) <-> (((I - rob_head) < (rob_tail - rob_head)) | (rob_busy(rob_head) & rob_head = rob_tail))
        # a done entry was issued to the ALU -- unless it is a load, done by the memory slots
        invariant [rob_done_issued] (rob_busy(I) & rob_done(I) & (rob_ir(I)<<15:13>>:opc) ~= 4) -> rob_issued(I)
        invariant [rob_issued_rdy] (rob_busy(I) & rob_issued(I)) -> (rob_a_rdy(I) & rob_b_rdy(I))
        invariant [rob_nonexec_done] (rob_busy(I) & ((rob_ir(I)<<15:13>>:opc) = 0)) -> rob_done(I)
        # a memory op is never issued to the ALU; a ST/FLUSH is never done (it performs as it retires)
        invariant [rob_mem_notissued] (rob_busy(I) & ((rob_ir(I)<<15:13>>:opc) = 4 | (rob_ir(I)<<15:13>>:opc) = 5 | (rob_ir(I)<<15:13>>:opc) = 7)) -> ~rob_issued(I)
        invariant [rob_stfl_notdone] (rob_busy(I) & ((rob_ir(I)<<15:13>>:opc) = 5 | (rob_ir(I)<<15:13>>:opc) = 7)) -> ~rob_done(I)
        # facts about the memory-slot selection logic: a ST/FLUSH is selected only at
        # the head; every store older than a selected load (either slot) has a known
        # address (no blocker); the forwarding slot holds an unperformed load
        derived invariant [sel_stfl_head] (mem_valid & ~mem_is_load) -> mem_sel = rob_head
        derived invariant [sel_ld_older_st] (mem_valid & mem_is_load & rob_busy(J) & (J - rob_head) < (mem_sel - rob_head) &
                                             (rob_ir(J)<<15:13>>:opc) = 5) -> rob_a_rdy(J)
        derived invariant [fwd_older_st] (fwd_perform & rob_busy(J) & (J - rob_head) < (fwd_sel - rob_head) &
                                          (rob_ir(J)<<15:13>>:opc) = 5) -> rob_a_rdy(J)
        derived invariant [fwd_is_load] fwd_perform -> (rob_busy(fwd_sel) & ~rob_done(fwd_sel) & (rob_ir(fwd_sel)<<15:13>>:opc) = 4 & rob_a_rdy(fwd_sel))
        invariant [ex_trk] ex_valid -> (rob_busy(ex_idx) & rob_issued(ex_idx) & ~rob_done(ex_idx) & ex_ir = rob_ir(ex_idx))
        invariant [issued_in_ex] (rob_busy(I) & rob_issued(I) & ~rob_done(I)) -> (ex_valid & ex_idx = I)
        invariant [flush_youngest] (rob_busy(I) & (rob_ir(I)<<15:13>>:opc) = 7) -> (I + 1 = rob_tail & ~d_valid)

        # ---- speculation structure ----
        invariant [shadow_suffix] (~trace.arch.error & rob_busy(I) & rob_shadow(I) & I + 1 ~= rob_tail) -> rob_shadow(I + 1)
        invariant [shadow_spec] (~trace.arch.error & rob_busy(I) & rob_shadow(I)) -> spec_wrong
        invariant [d_shadow_char] (~trace.arch.error & d_valid) -> (d_shadow = spec_wrong)
        invariant [mp_char] (~trace.arch.error & spec_wrong) ->
            (rob_busy(mp_idx) & ~rob_shadow(mp_idx) & (g_ir(mp_idx)<<15:13>>:opc) = 6 & rob_pred(mp_idx) ~= g_take(mp_idx))
        invariant [mp_unique] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 6 & rob_pred(I) ~= g_take(I)) -> (spec_wrong & I = mp_idx)
        invariant [shadow_after_mp] (~trace.arch.error & spec_wrong & rob_busy(I) & (I - rob_head) > (mp_idx - rob_head)) -> rob_shadow(I)
        invariant [head_noshadow] (~trace.arch.error & rob_busy(rob_head)) -> ~rob_shadow(rob_head)
        # while spec_wrong, arch is exactly the state after the mispredicted branch
        invariant [arch_after_mp] (~trace.arch.error & spec_wrong) ->
            trace.arch.pc = ((g_ir(mp_idx)<<7:0>>:addr) if g_take(mp_idx) else g_pc(mp_idx) + 1)

        # ---- fetch: on the correct path the pc is the predicted successor of the
        #      IF/ID instruction, whose correct decode is arch's. A word fetched from
        #      a dirty address is garbage (the ISA errors when it executes). ----
        invariant [pc_trk] (~trace.arch.error & ~spec_wrong & (d_valid -> ~trace.arch.ddirty(trace.arch.pc))) ->
            pc = (trace.arch.pc if ~d_valid else
                 ((trace.arch.target if d_pred else trace.arch.pc + 1) if d_opcode = 6 else trace.arch.pc + 1))
        invariant [d_ir_trk] (~trace.arch.error & d_valid & ~d_shadow & ~trace.arch.ddirty(trace.arch.pc)) -> d_ir = trace.arch.fetched
        invariant [d_pc_trk] (~trace.arch.error & d_valid & ~d_shadow) -> d_pc = trace.arch.pc
        # the fetched word is the reference instruction (zero-delay from idc's guarantee)
        derived invariant [fetch_coh]
            (fetch_active & idc.fetch_valid0 & ~trace.arch.error & ~trace.arch.ddirty(pc)) -> idc.fetch_data0 = trace.arch.mem(pc)
            with idc.fetch_output0
        # a load served by idc gets idc's memory at its address
        derived invariant [load_coh]
            (ld_perform & ~trace.arch.error) -> idc.read_data = idc.mem(mem_addr)
            with idc.data_output

        # ---- ROB entry contents equal the ghost values (correct-path entries) ----
        invariant [rob_ir_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I)) -> rob_ir(I) = g_ir(I)
        invariant [rob_pc_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I)) -> rob_pc(I) = g_pc(I)
        invariant [rob_val_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & rob_done(I)) -> rob_val(I) = g_res(I)
        invariant [rob_take_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & rob_done(I) & (g_ir(I)<<15:13>>:opc) = 6) -> rob_take(I) = g_take(I)
        invariant [rob_a_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & rob_a_rdy(I) &
                               ((g_ir(I)<<15:13>>:opc) = 1 | (g_ir(I)<<15:13>>:opc) = 2 | (g_ir(I)<<15:13>>:opc) = 4 |
                                (g_ir(I)<<15:13>>:opc) = 5 | (g_ir(I)<<15:13>>:opc) = 6 | (g_ir(I)<<15:13>>:opc) = 7)) -> rob_a(I) = g_a(I)
        invariant [rob_b_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & rob_b_rdy(I) &
                               ((g_ir(I)<<15:13>>:opc) = 1 | (g_ir(I)<<15:13>>:opc) = 2 | (g_ir(I)<<15:13>>:opc) = 5)) -> rob_b(I) = g_b(I)
        # a pending operand waits on a busy, not-yet-done, correct-path register-writing
        # entry whose (ghost) result is that operand
        invariant [rob_a_pend] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & ~rob_a_rdy(I)) ->
            (rob_busy(rob_a_src(I)) & ~rob_shadow(rob_a_src(I)) & ~rob_done(rob_a_src(I)) &
             ((g_ir(rob_a_src(I))<<15:13>>:opc) = 1 | (g_ir(rob_a_src(I))<<15:13>>:opc) = 2 |
              (g_ir(rob_a_src(I))<<15:13>>:opc) = 3 | (g_ir(rob_a_src(I))<<15:13>>:opc) = 4) &
             g_res(rob_a_src(I)) = g_a(I))
        invariant [rob_b_pend] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & ~rob_b_rdy(I)) ->
            (rob_busy(rob_b_src(I)) & ~rob_shadow(rob_b_src(I)) & ~rob_done(rob_b_src(I)) &
             ((g_ir(rob_b_src(I))<<15:13>>:opc) = 1 | (g_ir(rob_b_src(I))<<15:13>>:opc) = 2 |
              (g_ir(rob_b_src(I))<<15:13>>:opc) = 3 | (g_ir(rob_b_src(I))<<15:13>>:opc) = 4) &
             g_res(rob_b_src(I)) = g_b(I))

        # ---- the ghost values are consistent: the result is the ALU function of
        #      the operands (a load's result is fixed by the memory facts below) ----
        invariant [g_res_cons] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) ~= 4) ->
            g_res(I) = (g_a(I) + g_b(I) if (g_ir(I)<<15:13>>:opc) = 1 else
                       (g_a(I) - g_b(I) if (g_ir(I)<<15:13>>:opc) = 2 else
                       ((0:addr) :: (g_ir(I)<<7:0>>:addr) if (g_ir(I)<<15:13>>:opc) = 3 else 0)))
        invariant [g_take_cons] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I)) -> g_take(I) = ((g_ir(I)<<15:13>>:opc) = 6 & g_a(I) = 0)

        # ---- ALU latch ----
        invariant [ex_a_trk] (~trace.arch.error & ex_valid & ~rob_shadow(ex_idx) & (ex_opcode = 1 | ex_opcode = 2 | ex_opcode = 6)) -> ex_a = g_a(ex_idx)
        invariant [ex_b_trk] (~trace.arch.error & ex_valid & ~rob_shadow(ex_idx) & (ex_opcode = 1 | ex_opcode = 2)) -> ex_b = g_b(ex_idx)

        # ---- registers: the ghost rename table against arch; the real table
        #      equals it on the correct path ----
        invariant [grat_trk] (~trace.arch.error & grat_valid(R)) ->
            (rob_busy(grat_idx(R)) & ~rob_shadow(grat_idx(R)) &
             ((g_ir(grat_idx(R))<<15:13>>:opc) = 1 | (g_ir(grat_idx(R))<<15:13>>:opc) = 2 | (g_ir(grat_idx(R))<<15:13>>:opc) = 3 | (g_ir(grat_idx(R))<<15:13>>:opc) = 4) &
             (g_ir(grat_idx(R))<<12:10>>:reg) = R &
             trace.arch.rf(R) = g_res(grat_idx(R)))
        invariant [rf_now_trk] (~trace.arch.error & ~grat_valid(R)) -> rf(R) = trace.arch.rf(R)
        invariant [grat_youngest] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) &
             ((g_ir(I)<<15:13>>:opc) = 1 | (g_ir(I)<<15:13>>:opc) = 2 | (g_ir(I)<<15:13>>:opc) = 3 | (g_ir(I)<<15:13>>:opc) = 4)) ->
            (grat_valid(g_ir(I)<<12:10>>) & (I - rob_head) <= (grat_idx(g_ir(I)<<12:10>>) - rob_head))
        invariant [rat_eq] (~trace.arch.error & ~spec_wrong) -> ((rat_valid(R) <-> grat_valid(R)) & (grat_valid(R) -> rat_idx(R) = grat_idx(R)))
        # the real table records every busy writer (also wrong-path ones), youngest first
        invariant [rat_youngest] (rob_busy(I) &
             ((rob_ir(I)<<15:13>>:opc) = 1 | (rob_ir(I)<<15:13>>:opc) = 2 | (rob_ir(I)<<15:13>>:opc) = 3 | (rob_ir(I)<<15:13>>:opc) = 4)) ->
            (rat_valid(rob_ir(I)<<12:10>>) & (I - rob_head) <= (rat_idx(rob_ir(I)<<12:10>>) - rob_head))

        # ---- memory: the ghost memory rename table against arch and idc ----
        invariant [mrat_trk] (~trace.arch.error & mrat_valid(A)) ->
            (rob_busy(mrat_idx(A)) & ~rob_shadow(mrat_idx(A)) & (g_ir(mrat_idx(A))<<15:13>>:opc) = 5 &
             (g_a(mrat_idx(A))<<7:0>>:addr) = A & trace.arch.mem(A) = g_b(mrat_idx(A)))
        invariant [mem_now_trk] (~trace.arch.error & ~mrat_valid(A)) -> idc.mem(A) = trace.arch.mem(A)
        invariant [mrat_youngest] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 5) ->
            (mrat_valid(g_a(I)<<7:0>>) & (I - rob_head) <= (mrat_idx(g_a(I)<<7:0>>) - rob_head))
        invariant [ld_src_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 4 & ld_src_valid(I)) ->
            (rob_busy(ld_src(I)) & ~rob_shadow(ld_src(I)) & (g_ir(ld_src(I))<<15:13>>:opc) = 5 &
             (ld_src(I) - rob_head) < (I - rob_head) &
             (g_a(ld_src(I))<<7:0>>:addr) = (g_a(I)<<7:0>>:addr) & g_res(I) = g_b(ld_src(I)))
        invariant [ld_src_youngest] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 4 & ld_src_valid(I) &
                                     rob_busy(J) & ~rob_shadow(J) & (g_ir(J)<<15:13>>:opc) = 5 &
                                     (g_a(J)<<7:0>>:addr) = (g_a(I)<<7:0>>:addr) & (J - rob_head) < (I - rob_head)) ->
            (J - rob_head) <= (ld_src(I) - rob_head)
        invariant [ld_nosrc_nostore] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 4 & ~ld_src_valid(I) &
                                      rob_busy(J) & ~rob_shadow(J) & (g_ir(J)<<15:13>>:opc) = 5 & (J - rob_head) < (I - rob_head)) ->
            (g_a(J)<<7:0>>:addr) ~= (g_a(I)<<7:0>>:addr)
        invariant [ld_nosrc_trk] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 4 & ~ld_src_valid(I)) ->
            g_res(I) = idc.mem(g_a(I)<<7:0>>)
        # the datapath's forwarding search agrees with the ghost binding: the
        # forwarding slot's (correct-path) load forwards exactly from ld_src, whose
        # data is ready; the cache slot's load is unbound
        derived invariant [sel_fwd_src] (~trace.arch.error & fwd_perform & ~rob_shadow(fwd_sel)) ->
            (ld_src_valid(fwd_sel) & ld_src(fwd_sel) = fwd_src & rob_b_rdy(fwd_src))
            with fwd_older_st, fwd_is_load
        derived invariant [sel_nofwd] (~trace.arch.error & mem_valid & mem_is_load & ~rob_shadow(mem_sel)) ->
            ~ld_src_valid(mem_sel)
            with sel_ld_older_st


        # ---- dirtiness: idc's dirty map is arch's except at addresses with an
        #      in-flight store (dirty in arch) or the in-flight FLUSH (clean in arch) ----
        invariant [fl_trk] (~trace.arch.error & fl_valid) ->
            (rob_busy(fl_idx) & ~rob_shadow(fl_idx) & (g_ir(fl_idx)<<15:13>>:opc) = 7 &
             (g_a(fl_idx)<<7:0>>:addr) = fl_addr & ~trace.arch.ddirty(fl_addr))
        invariant [fl_uniq] (~trace.arch.error & rob_busy(I) & ~rob_shadow(I) & (g_ir(I)<<15:13>>:opc) = 7) -> (fl_valid & fl_idx = I)
        invariant [store_dirty] (~trace.arch.error & mrat_valid(A) & ~(fl_valid & fl_addr = A)) -> trace.arch.ddirty(A)
        invariant [ddirty_rel] (~trace.arch.error & ~mrat_valid(A) & ~(fl_valid & fl_addr = A)) -> idc.ddirty(A) = trace.arch.ddirty(A)
    }
}

# The CPU discharges idc's only assumption: the memory op at the head issues at
# most one data request per cycle (its opcode is a single value).
provide cpu.idc.one_data_op
